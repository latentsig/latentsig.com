site-header{background:transparent!important;border:0!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}\n  body.home-visual .site-nav{position:relative;max-width:1040px;height:68px;margin:14px auto 0;padding:0 24px;border:1px solid rgba(255,255,255,.16);border-radius:999px;background:rgba(255,255,255,.035);box-shadow:inset 0 1px 1px rgba(255,255,255,.1);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}\n  body.home-visual .site-nav::before{content:\"\";position:absolute;inset:0;border-radius:inherit;padding:1.4px;background:linear-gradient(180deg,rgba(255,255,255,.42),rgba(255,255,255,.14)20%,transparent 42%,transparent 58%,rgba(255,255,255,.14)80%,rgba(255,255,255,.42));-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}\n  body.home-visual .brand img{max-height:35px}\n  body.home-visual .site-nav .nav-link,body.home-visual .site-nav .nav-disclosure{color:rgba(255,255,255,.82)!important}\n  body.home-visual .site-nav .nav-link:hover,body.home-visual .site-nav .nav-link.is-current,body.home-visual .site-nav .nav-group[data-open=\"true\"]>.nav-link{color:#fff!important}\n  body.home-visual .site-nav .nav-disclosure span{border-color:currentColor}\n  body.home-visual .site-nav .demo-cta,body.home-visual .site-nav .mobile-book{background:#fff!important;border-color:#fff!important;color:#050505!important;border-radius:999px}\n  body.home-visual .site-nav .mobile-toggle{border-color:rgba(255,255,255,.24)!important;background:rgba(255,255,255,.04)}\n  body.home-visual .site-nav .mobile-toggle span{background:#fff!important}\n  body.home-visual .mega-panel{background:#101114!important;color:#fff!important;border-color:rgba(255,255,255,.16)!important;box-shadow:0 24px 80px rgba(0,0,0,.55);backdrop-filter:none!important;-webkit-backdrop-filter:none!important}\r\n  body.home-visual .product-discovery,body.home-visual .compact-content{background:transparent!important;color:#fff!important}\n  body.home-visual .product-intro h2,body.home-visual .compact-inner h2,body.home-visual .mega-item{color:#fff!important}\n  body.home-visual .product-intro p,body.home-visual .mega-item small{color:rgba(255,255,255,.58)!important}\n  body.home-visual .product-menu-card{background:rgba(255,255,255,.035)!important;border-color:rgba(255,255,255,.14)!important}\n  body.home-visual .product-title,body.home-visual .compact-items .mega-item{border-color:rgba(255,255,255,.12)!important}\n  body.home-visual .explore-all{border-color:rgba(255,255,255,.16)!important;color:#fff!important}\n  body.home-visual .mobile-panel{background:rgba(5,5,5,.98)!important;border-color:rgba(255,255,255,.12)!important}\n  body.home-visual .mobile-panel summary,body.home-visual .mobile-direct,body.home-visual .mobile-subnav a,body.home-visual .mobile-parent-link{color:#fff!important;border-color:rgba(255,255,255,.14)!important}\n  body.home-visual .mobile-child{border-left-color:rgba(255,255,255,.32)!important}\n  body.home-visual .observatory-hero{margin:0}\n  body.home-visual .home-section,body.home-visual .home-cta{color:#fff!important;background:#000!important}\n  body.home-visual .products-section{background:radial-gradient(ellipse at 50% 0,rgba(255,255,255,.035),transparent 62%),#000!important}\n  body.home-visual .workflow-section{background:radial-gradient(ellipse at 88% 50%,rgba(255,255,255,.025),transparent 58%),#030303!important;border-color:rgba(255,255,255,.09)!important}\n  body.home-visual .research-section{background:#000!important}\n  body.home-visual .services-section{background:radial-gradient(ellipse at 12% 40%,rgba(255,255,255,.025),transparent 48%),#000!important}\n  body.home-visual .section-heading h2,body.home-visual .workflow-wrap h2,body.home-visual .home-cta h2{color:#fff!important;font-family:'Instrument Serif',serif!important;font-weight:400!important;letter-spacing:-.025em!important}\n  body.home-visual .section-heading>p,body.home-visual .section-kicker{color:rgba(255,255,255,.43)!important;font:500 10px/1.5 Inter,system-ui,sans-serif!important;letter-spacing:.17em!important}\n  body.home-visual .section-heading>a{color:rgba(255,255,255,.78)!important}\n  body.home-visual .home-product,body.home-visual .workflow-track,body.home-visual .research-cards>a,body.home-visual .service-cards>a,body.home-visual .home-cta .home-wrap{position:relative;color:#fff!important;background:rgba(255,255,255,.025)!important;border:1px solid rgba(255,255,255,.13)!important;border-radius:24px!important;box-shadow:inset 0 1px 1px rgba(255,255,255,.1)!important;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);overflow:hidden}\n  body.home-visual .liquid-glass::before{content:\"\";position:absolute;inset:0;z-index:2;border-radius:inherit;padding:1.4px;background:linear-gradient(180deg,rgba(255,255,255,.45),rgba(255,255,255,.15)20%,transparent 40%,transparent 60%,rgba(255,255,255,.15)80%,rgba(255,255,255,.45));-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}\n  body.home-visual .home-product h3,body.home-visual .research-cards h3,body.home-visual .service-cards h3,body.home-visual .track-copy h3{color:#fff!important;font-family:'Instrument Serif',serif!important;font-weight:400!important;font-size:clamp(22px,2vw,29px)!important;letter-spacing:-.015em}\n  body.home-visual .home-product p,body.home-visual .track-copy p,body.home-visual .research-cards h3,body.home-visual .service-cards p,body.home-visual .home-cta .home-wrap>p:not(.section-kicker){color:rgba(255,255,255,.62)!important}\n  body.home-visual .home-product>small,body.home-visual .research-cards>a>span,body.home-visual .service-cards>a>span,body.home-visual .track-copy>span{color:rgba(255,255,255,.45)!important;letter-spacing:.15em}\n  body.home-visual .card-link,body.home-visual .service-cards b,body.ho