ont-weight: 400;\n}\r\n.text-body-md {\n  font-size: 16px;\n  line-height: 24px;\n  font-weight: 400;\n}\r\n.text-headline-lg-mobile {\n  font-size: 32px;\n  line-height: 40px;\n  font-weight: 600;\n}\r\n.text-headline-md {\n  font-size: 32px;\n  line-height: 40px;\n  font-weight: 600;\n}\r\n.text-headline-sm {\n  font-size: 24px;\n  line-height: 32px;\n  font-weight: 600;\n}\r\n.text-headline-xl-mobile {\n  font-size: 40px;\n  line-height: 48px;\n  font-weight: 700;\n}\r\n.text-label-md {\n  font-size: 14px;\n  line-height: 20px;\n  letter-spacing: 0.02em;\n  font-weight: 500;\n}\r\n.text-label-sm {\n  font-size: 12px;\n  line-height: 16px;\n  letter-spacing: 0.05em;\n  font-weight: 600;\n}\r\n.font-bold {\n  font-weight: 700;\n}\r\n.uppercase {\n  text-transform: uppercase;\n}\r\n.italic {\n  font-style: italic;\n}\r\n.ordinal {\n  --tw-ordinal: ordinal;\n  font-variant-numeric: var(--tw-ordinal) var(--tw-slashed-zero) var(--tw-numeric-figure) var(--tw-numeric-spacing) var(--tw-numeric-fraction);\n}\r\n.leading-tight {\n  line-height: 1.25;\n}\r\n.tracking-widest {\n  letter-spacing: 0.1em;\n}\r\n.text-on-primary {\n  --tw-text-opacity: 1;\n  color: rgb(255 253 248 / var(--tw-text-opacity, 1));\n}\r\n.text-on-primary-container {\n  --tw-text-opacity: 1;\n  color: rgb(52 61 40 / var(--tw-text-opacity, 1));\n}\r\n.text-on-surface {\n  --tw-text-opacity: 1;\n  color: rgb(41 44 37 / var(--tw-text-opacity, 1));\n}\r\n.text-on-surface-variant {\n  --tw-text-opacity: 1;\n  color: rgb(103 107 96 / var(--tw-text-opacity, 1));\n}\r\n.text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(109 123 80 / var(--tw-text-opacity, 1));\n}\r\n.text-secondary {\n  --tw-text-opacity: 1;\n  color: rgb(132 116 165 / var(--tw-text-opacity, 1));\n}\r\n.text-tertiary {\n  --tw-text-opacity: 1;\n  color: rgb(183 108 76 / var(--tw-text-opacity, 1));\n}\r\n.underline {\n  text-decoration-line: underline;\n}\r\n.antialiased {\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\r\n.opacity-50 {\n  opacity: 0.5;\n}\r\n.shadow {\n  --tw-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);\n  --tw-shadow-colored: 0 1px 3px 0 var(--tw-shadow-color), 0 1px 2px -1px var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\r\n.shadow-lg {\n  --tw-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n  --tw-shadow-colored: 0 10px 15px -3px var(--tw-shadow-color), 0 4px 6px -4px var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\r\n.shadow-primary\\/20 {\n  --tw-shadow-color: rgb(109 123 80 / 0.2);\n  --tw-shadow: var(--tw-shadow-colored);\n}\r\n.blur {\n  --tw-blur: blur(8px);\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\r\n.drop-shadow {\n  --tw-drop-shadow: drop-shadow(0 1px 2px rgb(0 0 0 / 0.1)) drop-shadow(0 1px 1px rgb(0 0 0 / 0.06));\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\r\n.filter {\n  filter: var(--tw-blur) var(--tw-brightness) var(--tw-contrast) var(--tw-grayscale) var(--tw-hue-rotate) var(--tw-invert) var(--tw-saturate) var(--tw-sepia) var(--tw-drop-shadow);\n}\r\n.backdrop-filter {\n  backdrop-filter: var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);\n}\r\n.transition {\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.transition-all {\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.transition-colors {\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\r\n.ease-in-out {\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\r\n\r\nhtml { scroll-padding-top: 6rem; }\r\nbody { overflow-wrap: anywhere; }\r\n:root { color-scheme: light; --ls-paper:#f7f4ec; --ls-white:#fffdf8; --ls-ink:#272a23; --ls-muted:#676b60; --ls-green:#6d7b50; --ls-lilac:#c8bce8; --ls-line:#dedbd1; }\r\nbody { background:var(--ls-paper); color:var(--ls-ink); }\r\n:where(a,button,input,textarea,select,summary):focus-visible { outline: 3px solid #74629e; outline-offset: 4px; }\r\n.sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }\r\n.skip-link { position:fixed;top:12px;left:16px;z-index:100;padding:12px 18px;background:#e1e0ff;color:#07006c;border-radius:4px;transform:translateY(-180%); }\r\n.skip-link:focus { transform:translateY(0); }\r\n/* LatentSig light editorial system */\r\n.site-header { background:rgba(249,247,241,.96)!important; color:var(--ls-ink)!important; border-bottom:1px solid var(--ls-line)!important; backdrop-filter:blur(18px); }\r\n.site-nav .nav-link { color:#3b3e35!important; }\r\n.site-nav .nav-link:hover,.site-nav .nav-link.is-current,.site-nav .nav-group[data-open=\"true\"]>.nav-link { color:#68774d!important; }\r\n.site-nav .nav-disclosure { color:#68774d!important; }\r\n.site-nav .demo-cta,.mobile-book { background:#6d7b50!important;color:#fffdf8!important; }\r\n.site-nav .brand img { filter:none; }\r\n.mobile-toggle { border-color:#d6d3c8!important; }\r\n.mobile-toggle span { background:#34372f!important; }\r\n.mega-panel { background:#fffdf8!important;color:#292c25!important;border-color:#dedbd1!important; }\r\n.featured-product,.product-menu-card { background:#f3f0e7!important;border-color:#e2dfd5!important; }\r\n.menu-eyebrow,.featured-actions a,.explore-all,.item-arrow { color:#68774d!important; }\r\n.mobile-panel { background:#f8f5ed!important; }\r\n.mobile-panel summary,.mobile-direct { color:#292c25!important; }\r\n.mobile-subnav a,.mobile-parent-link { color:#55594f!important; }\r\n.mobile-nav-group { display:grid; }\r\n.mobile-subnav .mobile-child { min-height:38px!important;margin-left:12px;padding-left:16px!important;border-left:1px solid #d5d2c7;color:#6a7651!important;font-size:12px!important; }\r\n.observatory-hero,.catalog-hero,.catalog,.home-section,.home-cta,.product-hero,.product-section,.product-bottom,.directory-page,.workflow-section,.research-section,.services-section { color:var(--ls-ink)!important; background:#f7f4ec!important; }\r\n.catalog-card,.feature-card,.process-step,.directory-card,.home-product,.service-cards>a,.research-cards>a,.product-visual { color:var(--ls-ink)!important;background:#fffdf8!important;border-color:#dedbd1!important; }\r\n.catalog-card p,.product-summary,.feature-card p,.availability-note,.directory-intro,.directory-card p,.home-product p,.product-bottom>div>p:not(.product-eyebrow),.workflow-wrap>div:first-child>p:last-child { color:#676b60!important; }\r\n.catalog-card small,.catalog-link,.product-eyebrow,.feature-card>span,.process-step>span,.directory-card small,.card-link,.service-cards b { color:#68774d!important; }\r\n.product-section.darker { background:#efede4!important; border-color:#dedbd1!important; }\r\n.product-visual,.visual-top,.visual-nav,.visual-main,.visual-step { background:#f1eee6!important;color:#32352e!important;border-color:#dedbd1!important; }\r\n.product-photo { position:relative; z-index:0; }\r\n.product-visual:hover .product-photo { transform:scale(1.025); }\r\n.visual-step { box-shadow:0 8px 24px #292c2510; }\r\n.home-product-grid,.feature-grid,.directory-grid { gap:22px!important; }\r\n.home-product,.catalog-card,.feature-card,.directory-card,.service-cards>a { border-radius:18px!important;box-shadow:0 16px 40px #3f3c3010; }\r\n.home-product:hover,.catalog-card:hover,.directory-card:hover,.service-cards>a:hover { transform:translateY(-5px);box-shadow:0 24px 48px #3f3c301c; }\r\n.home-section h2,.catalog-hero h1,.catalog-card h2,.product-section h2,.product-bottom h2,.directory-page h1,.directory-card h2,.home-product h3,.workflow-steps h3,.service-cards h3,.section-heading h2 { color:#292c25!important; }\r\n.section-heading>p,.section-kicker { color:#68774d!important; }\r\n.workflow-steps article { background:#fffdf8!important;border-color:#dedbd1!important; }\r\n.workflow-steps p,.research-cards h3,.service-cards p { color:#62665c!important; }\r\n.home-card-photo { display:block;width:100%;height:210px;-o-object-fit:cover;object-fit:cover;border-radius:14px;margin-bottom:20px; }\r\n.catalog-photo { display:block;width:100%;height:clamp(190px,24vw,300px);-o-object-fit:cover;object-fit:cover;border-radius:14px;margin-bottom:22px; }\r\n.home-card-photo,.catalog-photo,.product-photo { transition:transform .6s cubic-bezier(.2,.7,.2,1),filter .5s; }\r\n.home-product:hover .home-card-photo,.catalog-card:hover .catalog-photo { transform:scale(1.025);filter:saturate(1.05); }\r\n.home-product { padding:14px 14px 24px!important; }\r\n.product-bottom .product-wrap { background:#fffdf8!important;border-color:#dedbd1!important; }\r\n.product-hero .action-primary,.product-bottom .action-primary { background:#6d7b50!important;color:#fffdf8!important; }\r\n.product-hero .action-secondary,.product-bottom .action-secondary { color:#373a32!important;border-color:#a8aa9e!important; }\r\n.site-header :focus-visible,.hero-actions :focus-visible { outline-color:#74629e!important; }\r\nfooter { background:#efede4!important;color:#292c25!important;border-color:#dedbd1!important; }\r\nfooter .text-on-surface,footer .text-on-surface-variant,footer a,footer h2,footer p { color:#484c42!important; }\r\nfooter a:hover { color:#68774d!important; }\r\n/* Shared Mossline atmosphere for existing page heroes; content stays in HTML. */\r\nmain :is(.bg-grid-pattern,.catalog-hero,.product-hero,.directory-page,.demos-page) {\r\n  background-image:\r\n    linear-gradient(105deg,rgba(247,244,236,.82),rgba(247,244,236,.94)),\r\n    radial-gradient(circle,rgba(104,115,76,.1) 1px,transparent 1px),\r\n    url(\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20261106_031618_8ce6dca1-972d-429d-8d13-bf0691c37848.png&w=2400&q=88\") !important;\r\n  background-size:auto,32px 32px,cover !important;\r\n  background-position:center,0 0,center 46% !important;\r\n}\r\nmain :is(.contact-hero,.event-page,.impl-hero,.sovereignty-page .hero) {\r\n  background-image:\r\n    linear-gradient(105deg,rgba(8,16,31,.78),rgba(8,16,31,.88)),\r\n    radial-gradient(circle,rgba(198,243,92,.08) 1px,transparent 1px),\r\n    url(\"https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20261106_031618_8ce6dca1-972d-429d-8d13-bf0691c37848.png&w=2400&q=88\") !important;\r\n  background-size:auto,32px 32px,cover !important;\r\n  background-position:center,0 0,center 46% !important;\r\n}\r\n.home-section .section-heading>a,.home-section>.home-section-header>a { color:#536540!important; }\r\n.home-section .section-heading h2,.home-section .workflow-wrap h2,.home-cta h2 { font-weight:500!important;letter-spacing:-.025em!important; }\r\n.demos-page { background:#f7f4ec!important;color:#292c25!important; }\r\n.demos-page .eyebrow,.demos-page .state { color:#68774d!important; }\r\n.demos-page .intro,.demos-page .demo-list p,.demos-page .demo-cta p { color:#676b60!important; }\r\n.demos-page .demo-list article,.demos-page .demo-cta { background:#fffdf8!important;border:1px solid #dedbd1!important;border-radius:16px!important; }\r\n.demos-page .demo-list h2,.demos-page .demo-cta h2 { color:#292c25!important;font-weight:500!important; }\r\n.demos-page .demo-list a { color:#536540!important; }\r\n.demos-page .demo-cta a { background:#6d7b50!important;color:#fffdf8!important; }\r\n.product-hero .maturity { color:#52574c!important;border-color:#d4d1c6!important;background:#f3f1e9!important; }\r\n.product-hero .maturity i { background:#9a8a54!important; }\r\n.menu-annotation-art { position:absolute;inset:0;padding:34px 30px;background:radial-gradient(ellipse at 42% 40%,#354b53,#1b252a 70%);color:#e7ece7;font:9px Geist,system-ui,sans-serif; }\r\n.menu-art-toolbar { height:26px;display:flex;align-items:center;gap:7px;border-bottom:1px solid #ffffff25;color:#c9d4ce;font-size:7px;letter-spacing:.1em; }\r\n.menu-art-toolbar i { width:5px;height:5px;border-radius:50%;background:#929d93; }.menu-art-toolbar i:first-of-type { margin-left:auto; }\r\n.menu-art-body { display:grid;grid-template-columns:minmax(0,1fr) 116px;gap:12px;height:calc(100% - 26px);padding-top:13px; }\r\n.menu-art-frame { position:relative;overflow:hidden;border:1px solid #71827c;border-radius:5px;background:linear-gradient(152deg,#718a79 0 20%,#475f61 21% 48%,#31454a 49%); }\r\n.menu-art-frame:before { content:\"\";position:absolute;top:-15%;left:40%;width:22%;height:130%;transform:rotate(29deg);background:#596768;border-inline:1px solid #d5ceaa88; }\r\n.menu-art-frame i { position:absolute;z-index:1;width:23px;height:13px;border:1px solid #b49ce4;border-radius:2px;transform:rotate(29deg); }.menu-art-frame i:first-child { left:20%;top:25%; }.menu-art-frame i:nth-child(2) { left:59%;top:58%;border-color:#78c9a9; }.menu-art-frame i:nth-child(3) { left:42%;top:74%;width:35px; }\r\n.menu-art-frame b { position:absolute;z-index:2;padding:4px 5px;border:1px solid #a890d4;border-radius:2px;background:#28223f;color:#efe7ff;font-size:6px;font-weight:500; }.menu-art-frame b:nth-of-type(1) { left:8%;top:42%; }.menu-art-frame b:nth-of-type(2) { right:7%;top:17%;border-color:#7bc6a7;background:#203c35; }\r\n.menu-art-review { display:grid;align-content:start;gap:10px;padding:10px 8px;border:1px solid #59645f;border-radius:5px;background:#283337; }.menu-art-review>b { font-size:7px;letter-spacing:.1em;color:#e7ece7; }.menu-art-review span { display:flex;align-items:center;gap:6px;padding-bottom:6px;border-bottom:1px solid #ffffff20;color:#c1ccc6;font-size:7px; }.menu-art-review span i { width:5px;height:5px;border-radius:50%;background:#9eb587; }.menu-art-review small { color:#c9d6ac;font-size:6px;letter-spacing:.08em; }\r\n.menu-solution-art,.menu-services-art,.menu-about-art { position:absolute;inset:0;overflow:hidden; }\r\n.menu-solution-art { display:flex;align-items:center;justify-content:center;gap:22px;background:radial-gradient(ellipse at 50% 46%,#e0e6d5,#c9d2bc); }\r\n.solution-browser { width:68%;height:55%;padding:12px;border:1px solid #aeb6a5;border-radius:8px;background:#f8f7f0;box-shadow:0 18px 35px #29322525;display:grid;grid-template-columns:1fr 1fr;gap:7px; }.solution-browser>i { width:5px;height:5px;border-radius:50%;background:#8b967a; }.solution-browser>i:nth-child(2) { grid-column:2;grid-row:1; }.solution-browser>i:nth-child(3) { grid-column:2;grid-row:1;justify-self:end; }.solution-browser>div { grid-column:1/-1;display:flex;gap:6px; }.solution-browser>div b { height:30px;flex:1;border-radius:4px;background:#e8e8df; }.solution-browser>div b:nth-child(2) { background:#e2e5d9; }.solution-browser>span { grid-column:1/-1;height:9px;border-radius:4px;background:#e6e5dc; }.solution-browser>span:last-child { width:72%; }.solution-mobile { width:48px;height:90px;padding:11px 6px;border:2px solid #747d6d;border-radius:10px;background:#faf9f3;display:grid;align-content:start;gap:8px;box-shadow:0 12px 24px #29322522; }.solution-mobile i { width:14px;height:3px;margin:auto auto 3px;border-radius:3px;background:#b5bcab; }.solution-mobile b { height:14px;border-radius:3px;background:#e1e6d8; }.solution-mobile b:nth-of-type(2) { background:#e9e3ef; }\r\n.compact-services { background:#262a30; }.menu-services-art { display:flex;flex-direction:column;justify-content:center;padding:42px clamp(20px,4vw,54px);background:radial-gradient(ellipse at 70% 48%,#474257,#242932 70%);color:#f6f3eb; }.menu-services-art>small { color:#c0bdce;font-size:9px;letter-spacing:.14em; }.menu-services-art>div { display:flex;align-items:center;gap:10px;margin:22px 0; }.menu-services-art>div span { display:grid;gap:8px;min-width:85px;padding:14px 12px;border:1px solid #706b80;border-radius:6px;background:#323540; }.menu-services-art>div b { color:#c8d3ae;font-size:9px;letter-spacing:.08em; }.menu-services-art>div i { color:#fff;font:500 12px 'Hanken Grotesk',sans-serif; }.menu-services-art>div em { flex:1;height:1px;background:linear-gradient(90deg,#798960,#9e8bc2); }.menu-services-art>strong { color:#d0ccda;font:400 19px 'Hanken Grotesk',sans-serif; }\r\n.compact-about { background:#202429; }.menu-about-art { display:grid;place-content:center;justify-items:center;gap:12px;background:radial-gradient(circle at 50% 48%,#454838,#202429 68%);color:#f4f0e8; }.menu-about-art .orbit { position:absolute;left:50%;top:44%;width:230px;height:80px;border:1px solid #a1ad7d70;border-radius:50%;transform:translate(-50%,-50%) rotate(-25deg); }.menu-about-art .orbit-b { width:250px;height:95px;border-color:#b4a3d675;transform:translate(-50%,-50%) rotate(35deg); }.menu-about-art .orbit-core { z-index:1;display:grid;place-items:center;width:50px;height:50px;border:1px solid #c4cea2;border-radius:50%;background:#3d4636;color:#f8f6ed;font:500 17px 'Hanken Grotesk',sans-serif;font-style:normal; }.menu-about-art>b,.menu-about-art>small { position:relative;z-index:1;letter-spacing:.12em; }.menu-about-art>b { margin-top:12px;font-size:11px; }.menu-about-art>small { color:#c4c5b9;font-size:8px; }\r\n@media(prefers-reduced-motion:reduce) {\r\n  html { scroll-behavior:auto !important; }\r\n  *,*::before,*::after { animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;scroll-behavior:auto !important; }\r\n}\r\n@media(forced-colors:active) {\r\n  :where(a,button):focus-visible { outline-color:Highlight; }\r\n}\r\n\r\n/* Shared charcoal theme for every route. The homepage keeps its bespoke hero,\r\n   while inner pages use the same ink, surfaces, and accessible text contrast. */\r\nbody.site-dark { color-scheme:dark; --ls-paper:#08090b; --ls-white:#111316; --ls-ink:#f2f3f1; --ls-muted:#b5b8b5; --ls-green:#a8bd78; --ls-lilac:#c8bce8; --ls-line:#303236; background:#08090b!important; color:#f2f3f1!important; }\r\nbody.site-dark:not(.home-visual) main { background:#08090b!important; color:#f2f3f1!important; }\r\n/* Keep page heroes on the same dark surface as their text and header. */\r\nbody.site-dark:not(.home-visual) main :is(.catalog-hero,.product-hero,.directory-page,.demos-page,.contact-hero,.event-page,.impl-hero,.service-page,.sovereignty-page .hero) { background-color:#08090b!important; }\r\nbody.site-dark:not(.home-visual) :is(.bg-surface,.bg-background,.bg-surface-dim) { background-color:#08090b!important; }\r\nbody.site-dark:not(.home-visual) :is(.bg-surface-container,.bg-surface-container-low,.bg-surface-container-high,.bg-surface-container-highest,.bg-surface-container-lowest,.bg-surface-variant,.bg-surface-bright) { background-color:#121417!important; }\r\nbody.site-dark:not(.home-visual) :is(.text-on-surface,.text-on-background) { color:#f1f2ef!important; }\r\nbody.site-dark:not(.home-visual) :is(.text-on-surface-variant,.text-muted) { color:#b6b9b5!important; }\r\nbody.site-dark:not(.home-visual) :is(.text-primary,.text-primary-fixed,.text-secondary) { color:#b8ce8a!important; }\r\nbody.site-dark:not(.home-visual) :is(.border-outline-variant,.border-outline) { border-color:#303236!important; }\r\nbody.site-dark:not(.home-visual) main :is(.bg-grid-pattern,.catalog-hero,.product-hero,.directory-page,.demos-page) { background-image:radial-gradient(circle,rgba(184,206,138,.08) 1px,transparent 1px),radial-gradient(ellipse at 78% 0,rgba(104,91,170,.12),transparent 52%)!important;background-size:32px 32px,auto!important;background-position:0 0,center!important; }\r\nbody.site-dark:not(.home-visual) main section.bg-grid-pattern>.absolute.inset-0 { background:linear-gradient(180deg,rgba(8,9,11,.42),rgba(8,9,11,.94))!important; }\r\nbody.site-dark:not(.home-visual) :is(.catalog-hero,.catalog,.product-hero,.product-section,.product-bottom,.directory-page,.demos-page,.impl-hero,.impl-pillar,.impl-cta,.contact-hero,.booking,.contact-options,.event-page,.event-details,.event-products,.about-cta,.about-principles,.service-page,.service-section) { color:#f1f2ef!important; }\r\nbody.site-dark:not(.home-visual) :is(.catalog,.product-section,.product-bottom,.about-cta,.about-principles) { background-color:#08090b!important; }\r\nbody.site-dark:not(.home-visual) :is(.catalog-card,.feature-card,.process-step,.directory-card,.demo-list article,.demo-cta,.contact-options .contact-wrap>div,.impl-hero ol,.impl-cards article,.product-bottom .product-wrap,.calendar-frame) { color:#f1f2ef!important;background:#121417!important;border-color:#303236!important;box-shadow:0 18px 48px rgba(0,0,0,.24)!important; }\r\nbody.site-dark:not(.home-visual) :is(.catalog-card h2,.feature-card h3,.process-step h3,.directory-card h2,.demo-list h2,.demo-cta h2,.product-section h2,.product-bottom h2,.contact-hero h1,.booking-heading h2,.impl-hero h1,.impl-pillar h2,.impl-cta h2) { color:#f5f5f2!important; }\r\nbody.site-dark:not(.home-visual) .directory-page h1 { color:#f5f5f2!important; }\r\nbody.site-dark:not(.home-visual) .directory-page .directory-eyebrow { color:#b8ce8a!important; }\r\nbody.site-dark:not(.home-visual) :is(.catalog-card p,.product-summary,.feature-card p,.availability-note,.directory-intro,.directory-card p,.demo-list p,.demo-cta p,.contact-hero span,.contact-options small,.impl-hero p:not(.eyebrow),.impl-cta p) { color:#b5b8b5!important; }\r\nbody.site-dark:not(.home-visual) :is(.catalog-card small,.catalog-link,.product-eyebrow,.feature-card>span,.process-step>span,.directory-card small,.directory-link,.demos-page .eyebrow,.contact-hero .eyebrow,.impl-hero .eyebrow,.impl-pillar .eyebrow) { color:#b8ce8a!important; }\r\nbody.site-dark:not(.home-visual) :is(.product-visual,.visual-top,.visual-nav,.visual-main,.visual-step) { background:#141619!important;color:#edf0ea!important;border-color:#34373b!important; }\r\nbody.site-dark:not(.home-visual) :is(.product-visual,.visual-step,.catalog-card,.feature-card,.process-step,.directory-card) { border-radius:16px!important; }\r\nbody.site-dark:not(.home-visual) :is(.product-hero .action-primary,.product-bottom .action-primary,.demo-cta a,.impl-hero a,.impl-cta a,.demos-page .demo-cta a) { color:#10130c!important;background:#b8ce8a!important;border-color:#b8ce8a!important; }\r\nbody.site-dark:not(.home-visual) :is(.product-hero .action-secondary,.product-bottom .action-secondary) { color:#f2f3f1!important;background:#121417!important;border-color:#42464b!important; }\r\nbody.site-dark:not(.home-visual) .product-hero .maturity { color:#e2e7dd!important;background:#121417!important;border-color:#41473b!important; }\r\nbody.site-dark:not(.home-visual) .product-hero .maturity i { background:#b8ce8a!important; }\r\nbody.site-dark:not(.home-visual) :is(.product-visual,.visual-step,.feature-card,.process-step,.directory-card,.catalog-card) a { color:#c4d99b!important; }\r\nbody.site-dark:not(.home-visual) .site-header { background:rgba(9,10,12,.98)!important;color:#f1f2ef!important;border-color:rgba(255,255,255,.12)!important;box-shadow:0 10px 32px rgba(0,0,0,.2); }\r\nbody.site-dark:not(.home-visual) .insight-card { color:#f2f3f1!important;background:#121417!important;border-color:#34373b!important;box-shadow:0 18px 44px rgba(0,0,0,.24); }\r\nbody.site-dark:not(.home-visual) .insight-card h3 { color:#f5f5f2!important;font:600 23px/1.2 'Hanken Grotesk',sans-serif;letter-spacing:-.025em; }\r\nbody.site-dark:not(.home-visual) .insight-card p { color:#b9bcb8!important; }\r\nbody.site-dark:not(.home-visual) .insight-card .text-on-surface-variant { color:#b9bcb8!important; }\r\nbody.site-dark:not(.home-visual) .insight-card .text-primary { color:#c4d99b!important; }\r\nbody.site-dark:not(.home-visual) .insight-card:hover { border-color:#718656!important;transform:translateY(-3px);box-shadow:0 24px 52px rgba(0,0,0,.34); }\r\nbody.site-dark .site-nav .nav-link { color:rgba(245,246,243,.84)!important; }\r\nbody.site-dark .site-nav .nav-link:hover,body.site-dark .site-nav .nav-link.is-current,body.site-dark .site-nav .nav-group[data-open=\"true\"]>.nav-link { color:#c5dc98!important; }\r\nbody.site-dark .site-nav .nav-disclosure { color:#c5dc98!important; }\r\nbody.site-dark .site-nav .nav-disclosure span { font-size:0!important;line-height:0!important; }\r\nbody.site-dark .site-nav .demo-cta,body.site-dark .site-nav .mobile-book { color:#10130c!important;background:#c0d798!important;border-color:#c0d798!important; }\r\nbody.site-dark .site-nav .mobile-toggle { border-color:rgba(255,255,255,.24)!important;background:rgba(255,255,255,.04)!important; }\r\nbody.site-dark .site-nav .mobile-toggle span { background:#f4f5f2!important; }\r\nbody.site-dark .mega-panel { z-index:101; top:calc(100% + 10px); left:50%; width:min(1080px,calc(100vw - 40px)); max-height:calc(100dvh - 112px); overflow:auto; overscroll-behavior:contain; border:1px solid rgba(255,255,255,.14)!important; border-radius:18px; background:#101114!important; color:#f3f4f1!important; box-shadow:0 28px 90px rgba(0,0,0,.62); }\r\nbody.site-dark .products-mega { grid-template-columns:minmax(220px, .78fr) minmax(0,1.7fr); gap:18px; align-items:stretch; }\r\nbody.site-dark .product-feature-media { height:auto; min-height:345px; }\r\nbody.site-dark .compact-inner { grid-template-columns:250px minmax(0,1fr); }\r\nbody.site-dark .menu-services-art { padding:24px 16px; }\r\nbody.site-dark .menu-services-art>div { gap:5px; margin:18px 0; }\r\nbody.site-dark .menu-services-art>div span { min-width:0;flex:1;padding:10px 7px;gap:6px; }\r\nbody.site-dark .menu-services-art>div i { font-size:11px;white-space:nowrap; }\r\nbody.site-dark .menu-services-art>div em { min-width:7px; }\r\nbody.site-dark .menu-services-art>strong { max-width:100%;font-size:16px;line-height:1.25; }\r\nbody.site-dark .product-discovery,body.site-dark .compact-content { background:#101114!important;color:#f3f4f1!important; }\r\nbody.site-dark .product-intro h2,body.site-dark .compact-inner h2 { color:#f4f5f2!important; }\r\nbody.site-dark .product-intro p,body.site-dark .mega-item small { color:#aeb2b2!important; }\r\nbody.site-dark .product-menu-card { background:#17191c!important;border-color:#303338!important; }\r\nbody.site-dark .product-title,body.site-dark .compact-items .mega-item { border-color:#303338!important; }\r\nbody.site-dark .mega-item { color:#f1f2ef!important; }\r\nbody.site-dark .mega-item:hover,body.site-dark .mega-item:focus-visible { background:#222529!important;color:#fff!important; }\r\nbody.site-dark .product-menu-actions,body.site-dark .explore-all { border-color:#34373b!important; }\r\nbody.site-dark .product-menu-actions a,body.site-dark .product-children a,body.site-dark .explore-all,body.site-dark .item-arrow { color:#c2d895!important; }\r\nbody.site-dark .product-children>span { color:#a5aaa7!important; }\r\nbody.site-dark .mobile-panel { background:rgba(12,13,15,.98)!important;border-color:#303236!important;box-shadow:0 24px 60px rgba(0,0,0,.5)!important; }\r\nbody.site-dark .mobile-panel summary,body.site-dark .mobile-direct { color:#f1f2ef!important;border-color:#303236!important; }\r\nbody.site-dark .mobile-subnav a,body.site-dark .mobile-parent-link { color:#d0d2cf!important; }\r\nbody.site-dar