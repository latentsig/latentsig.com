ices-art>div { gap:5px; margin:18px 0; }\r\nbody.site-dark .menu-services-art>div span { min-width:0;flex:1;padding:10px 7px;gap:6px; }\r\nbody.site-dark .menu-services-art>div i { font-size:11px;white-space:nowrap; }\r\nbody.site-dark .menu-services-art>div em { min-width:7px; }\r\nbody.site-dark .menu-services-art>strong { max-width:100%;font-size:16px;line-height:1.25; }\r\nbody.site-dark .product-discovery,body.site-dark .compact-content { background:#101114!important;color:#f3f4f1!important; }\r\nbody.site-dark .product-intro h2,body.site-dark .compact-inner h2 { color:#f4f5f2!important; }\r\nbody.site-dark .product-intro p,body.site-dark .mega-item small { color:#aeb2b2!important; }\r\nbody.site-dark .product-menu-card { background:#17191c!important;border-color:#303338!important; }\r\nbody.site-dark .product-title,body.site-dark .compact-items .mega-item { border-color:#303338!important; }\r\nbody.site-dark .mega-item { color:#f1f2ef!important; }\r\nbody.site-dark .mega-item:hover,body.site-dark .mega-item:focus-visible { background:#222529!important;color:#fff!important; }\r\nbody.site-dark .product-menu-actions,body.site-dark .explore-all { border-color:#34373b!important; }\r\nbody.site-dark .product-menu-actions a,body.site-dark .product-children a,body.site-dark .explore-all,body.site-dark .item-arrow { color:#c2d895!important; }\r\nbody.site-dark .product-children>span { color:#a5aaa7!important; }\r\nbody.site-dark .mobile-panel { background:rgba(12,13,15,.98)!important;border-color:#303236!important;box-shadow:0 24px 60px rgba(0,0,0,.5)!important; }\r\nbody.site-dark .mobile-panel summary,body.site-dark .mobile-direct { color:#f1f2ef!important;border-color:#303236!important; }\r\nbody.site-dark .mobile-subnav a,body.site-dark .mobile-parent-link { color:#d0d2cf!important; }\r\nbody.site-dark .mobile-child { border-left-color:#646b60!important; }\r\nbody.site-dark .skip-link { background:#c5dc98!important;color:#10130c!important; }\r\nbody.site-dark:not(