---
import Logo from './Logo.astro';

type MobileNavigationItem = { label: string; href: string; icon: string };
type MobileNavigationSection = { label: string; items: MobileNavigationItem[] };

interface Props {
  sections: MobileNavigationSection[];
  currentPath: string;
  booking: string;
}

const { sections, currentPath, booking } = Astro.props;
const icons: Record<string, string> = {
  grid: '<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 16 9 5 9-5"/>',
  spark: '<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10 18.5h4"/>',
  check: '<path d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 8.2A2.5 2.5 0 0 0 7.1 21h9.8a2.5 2.5 0 0 0 2.1-3.8L14 9V3"/><path d="M8 15h8"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  building: '<path d="M4 21V5l8-3 8 3v16M8 8h1M15 8h1M8 12h1M15 12h1M8 16h1M15 16h1M10 21v-3h4v3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  chart: '<path d="M4 19V5M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="m10.8 7.2-4.6 8.6m7-8.6 4.6 8.6M7.5 18h9"/>',
  document: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 12h6M9 16h6"/>',
};
const isCurrent = (href: string) => new URL(href, Astro.url).pathname === currentPath;
---

<div class="mobile-menu-overlay" id="mobile-menu" hidden data-mobile-panel>
  <div class="mobile-menu-backdrop" aria-hidden="true" data-mobile-backdrop></div>
  <section class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile navigation" tabindex="-1" data-mobile-dialog>
    <div class="mobile-drawer-header">
      <a href="/" class="mobile-brand" aria-label="LatentSig home"><Logo height={38} variant="light" /></a>
      <button class="mobile-close" type="button" aria-label="Close navigation" data-mobile-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="mobile-drawer-content">
      <nav class="mobile-panel-inner" aria-label="Mobile navigation links">
        {sections.map((section, idx) => (
          <div class="mobile-section" data-mobile-section>
            <button
              type="button"
              class="mobile-section-summary"
              aria-expanded="false"
              aria-controls={`mobile-section-${idx}`}
              data-mobile-section-btn
            >
              <span>{section.label}</span>
              <svg class="mobile-section-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
            </button>
            {section.items && (
              <div class="mobile-section-panel" id={`mobile-section-${idx}`} hidden data-mobile-section-panel>
                <div class="mobile-section-links">
                  {section.items.map((item) => (
                    <a class="mobile-nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      <span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons[item.icon] ?? icons.grid}></svg></span>
                      <span class="mobile-nav-label">{item.label}</span>
                      <svg class="mobile-nav-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>
    </div>
    <div class="mobile-drawer-footer">
      <a class="mobile-contact-cta" href="/contact/">Talk to us</a>
      <a class="mobile-demo-cta" href={booking} target="_blank" rel="noopener noreferrer">Book a demo <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>

<style>
  .mobile-menu-overlay { display:none;position:fixed;inset:0;z-index:90;justify-content:flex-end;background:rgba(15,23,42,.45);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);pointer-events:auto; }
  .mobile-menu-overlay[hidden] { display:none; }
  @media(max-width:900px) { .mobile-menu-overlay:not([hidden]) { display:flex; } }
  .mobile-menu-backdrop { position:absolute;inset:0;pointer-events:auto; }
  .mobile-drawer { position:relative;z-index:1;pointer-events:auto;width:min(100%,460px);height:100vh;height:100dvh;display:grid;grid-template-rows:68px minmax(0,1fr) auto;overflow:hidden;border-left:1px solid #e4e4e7;background:#ffffff;color:#18181b;box-shadow:-18px 0 48px rgba(15,23,42,.14); }
  .mobile-drawer-header { display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,env(safe-area-inset-right)) 0 max(20px,env(safe-area-inset-left));border-bottom:1px solid #e4e4e7;background:#ffffff; }
  .mobile-brand { display:flex;align-items:center;min-width:44px;min-height:44px;text-decoration:none; }
  .mobile-close { width:40px;height:40px;display:grid;place-items:center;border:1px solid #e4e4e7;border-radius:50%;background:#f4f4f5;color:#18181b;cursor:pointer;transition:background .18s,border-color .18s; }
  .mobile-close:hover { background:#e4e4e7; }
  .mobile-close svg { width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round; }
  .mobile-drawer-content { min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-color:#d4d4d8 transparent;background:#ffffff; }
  .mobile-panel-inner { width:min(100%,480px);margin:0 auto;padding:8px 20px 20px; }
  .mobile-section { border-bottom:1px solid #f0f0f2; }
  .mobile-section-summary { width:100%;min-height:60px;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:0;background:transparent;border:0;color:#18181b;cursor:pointer;font:600 18px/1.25 'Hanken Grotesk',Geist,system-ui,sans-serif;letter-spacing:-.015em;text-align:left;-webkit-tap-highlight-color:transparent; }
  .mobile-section-chevron { width:18px;height:18px;flex:none;fill:none;stroke:#52525b;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s ease; }
  .mobile-section-summary[aria-expanded="true"] .mobile-section-chevron { transform:rotate(180deg);stroke:#18181b; }
  .mobile-section-panel { padding:0 0 14px; }
  .mobile-section-panel[hidden] { display:none!important; }
  .mobile-section-links { display:grid;gap:2px; }
  .mobile-nav-link { min-height:50px;display:flex;align-items:center;gap:12px;padding:8px 12px;border:1px solid transparent;border-radius:10px;color:#27272a;text-decoration:none;font:500 14.5px/1.35 Geist,system-ui,sans-serif;transition:background .16s ease,color .16s ease; }
  .mobile-nav-link:hover,.mobile-nav-link:focus-visible,.mobile-nav-link[aria-current="page"] { background:#f4f4f5;color:#09090b; }
  .mobile-nav-link[aria-current="page"] .mobile-nav-icon { border-color:#6d7b50;background:#edf2e4;color:#4f5e3b; }
  .mobile-nav-icon { width:36px;height:36px;display:grid;place-items:center;flex:none;border:1px solid #e4e4e7;border-radius:9px;background:#f4f4f5;color:#52525b; }
  .mobile-nav-icon svg { width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round; }
  .mobile-nav-label { min-width:0;flex:1; }
  .mobile-nav-arrow { width:16px;height:16px;flex:none;fill:none;stroke:#a1a1aa;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round; }
  .mobile-drawer-footer { display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px 18px max(16px,env(safe-area-inset-bottom));border-top:1px solid #e4e4e7;background:#fafafa; }
  .mobile-contact-cta,.mobile-demo-cta { min-height:48px;display:flex;align-items:center;justify-content:center;gap:8px;padding:0 14px;border-radius:10px;text-decoration:none;text-align:center;font:600 14px/1.2 Geist,system-ui,sans-serif;transition:background .18s,border-color .18s,transform .18s; }
  .mobile-contact-cta { background:#ffffff;border:1px solid #d4d4d8;color:#18181b; }
  .mobile-contact-cta:hover { background:#f4f4f5;border-color:#a1a1aa; }
  .mobile-demo-cta { border:1px solid #6d7b50;background:#6d7b50;color:#ffffff;box-shadow:0 2px 8px rgba(109,123,80,.25); }
  .mobile-demo-cta:hover { background:#596742;border-color:#596742; }
  .mobile-demo-cta span { font-size:16px; }
  .mobile-drawer :focus-visible { outline:3px solid #6d7b50;outline-offset:2px; }
  @media(max-width:380px) { .mobile-panel-inner { padding-right:14px;padding-left:14px; }.mobile-drawer-footer { padding-right:12px;padding-left:12px;gap:8px; }.mobile-contact-cta,.mobile-demo-cta { padding:0 8px;font-size:13px; } }
  @media(max-height:520px) and (max-width:900px) { .mobile-panel-inner { padding-top:4px;padding-bottom:12px; }.mobile-section summary { min-height:50px;font-size:17px; }.mobile-nav-link { min-height:44px; } }
  @media(prefers-reduced-motion:reduce) { .mobile-menu-overlay * { animation:none!important;transition-duration:.01ms!important;scroll-behavior:auto!important; } }
</style>
