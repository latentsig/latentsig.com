---
import Logo from './Logo.astro';

type MobileNavigationItem = { label: string; href: string; icon: string };
type MobileNavigationGroup = { label: string; items: MobileNavigationItem[] };
type MobileNavigationSection = { label: string; groups?: MobileNavigationGroup[]; items?: MobileNavigationItem[] };

interface Props {
  sections: MobileNavigationSection[];
  currentPath: string;
  booking: string;
}

const { sections, currentPath, booking } = Astro.props;
const icons: Record<string, string> = {
  grid: '<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 16 9 5 9-5"/>',
  spark: '<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10 18.5h4"/>',
  check: '<path d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 8.2A2.5 2.5 0 0 0 7.1 21h9.8a2.5 2.5 0 0 0 2.1-3.8L14 9V3"/><path d="M8 15h8"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  building: '<path d="M4 21V5l8-3 8 3v16M8 8h1M15 8h1M8 12h1M15 12h1M8 16h1M15 16h1M10 21v-3h4v3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  chart: '<path d="M4 19V5M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="m10.8 7.2-4.6 8.6m7-8.6 4.6 8.6M7.5 18h9"/>',
  document: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 12h6M9 16h6"/>',
};
const isCurrent = (href: string) => new URL(href, Astro.url).pathname === currentPath;
---

<div class="mobile-menu-overlay" id="mobile-menu" hidden data-mobile-panel>
  <div class="mobile-menu-backdrop" aria-hidden="true" data-mobile-backdrop></div>
  <section class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile navigation" tabindex="-1" data-mobile-dialog>
    <div class="mobile-drawer-header">
      <a href="/" class="mobile-brand" aria-label="LatentSig home"><Logo height={42} /></a>
      <button class="mobile-close" type="button" aria-label="Close navigation" data-mobile-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="mobile-drawer-content">
      <nav class="mobile-panel-inner" aria-label="Mobile navigation links">
        {sections.map((section) => (
          <details class="mobile-section" data-mobile-section>
            <summary>
              <span>{section.label}</span>
              <svg class="mobile-section-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
            </summary>
            {section.groups && (
              <div class="mobile-subsections">
                {section.groups.map((group) => (
                  <details class="mobile-subsection" data-mobile-subsection>
                    <summary>
                      <span class="mobile-subsection-label">{group.label}</span>
                      <span class="mobile-subsection-count" aria-label={group.items.length + ' links'}>{group.items.length}</span>
                      <svg class="mobile-subsection-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg>
                    </summary>
                    <div class="mobile-subsection-links">
                      {group.items.map((item) => (
                        <a class="mobile-nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                          <span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons[item.icon] ?? icons.grid}></svg></span>
                          <span class="mobile-nav-label">{item.label}</span>
                          <svg class="mobile-nav-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                        </a>
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            )}
            {section.items && (
              <div class="mobile-section-links">
                {section.items.map((item) => (
                  <a class="mobile-nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons[item.icon] ?? icons.grid}></svg></span>
                    <span class="mobile-nav-label">{item.label}</span>
                    <svg class="mobile-nav-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                  </a>
                ))}
              </div>
            )}
          </details>
        ))}
      </nav>
    </div>
    <div class="mobile-drawer-footer">
      <a class="mobile-contact-cta" href="/contact/">Talk to us</a>
      <a class="mobile-demo-cta" href={booking} target="_blank" rel="noopener noreferrer">Book a demo <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>

<style>
  .mobile-menu-overlay { display:none;position:fixed;inset:0;z-index:2;justify-content:flex-end;background:rgba(0,0,0,.58);backdrop-filter:blur(5px); }
  .mobile-menu-overlay[hidden] { display:none; }
  @media(max-width:900px) { .mobile-menu-overlay:not([hidden]) { display:flex; } }
  .mobile-drawer { width:min(100%,560px);height:100vh;height:100dvh;display:grid;grid-template-rows:68px minmax(0,1fr) auto;overflow:hidden;border-left:1px solid #303236;background:#08090b;color:#f2f3f1;box-shadow:-24px 0 64px rgba(0,0,0,.42); }
  .mobile-drawer-header { display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,env(safe-area-inset-right)) 0 max(20px,env(safe-area-inset-left));border-bottom:1px solid #303236; }
  .mobile-brand { display:flex;align-items:center;min-width:44px;min-height:44px; }
  .mobile-close { width:44px;height:44px;display:grid;place-items:center;border:1px solid #383b40;border-radius:50%;background:#111316;color:#f2f3f1;cursor:pointer; }
  .mobile-close svg { width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round; }
  .mobile-drawer-content { min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-color:#42464b transparent; }
  .mobile-panel-inner { width:min(100%,520px);margin:0 auto;padding:12px 22px 20px; }
  .mobile-section { border-bottom:1px solid #303236; }
  .mobile-section summary { min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:14px;color:#f2f3f1;list-style:none;cursor:pointer;font:500 21px/1.25 'Hanken Grotesk',Geist,system-ui,sans-serif;letter-spacing:-.018em; }
  .mobile-section summary::-webkit-details-marker,.mobile-subsection summary::-webkit-details-marker { display:none; }
  .mobile-section-chevron,.mobile-subsection-chevron { width:18px;height:18px;flex:none;fill:none;stroke:#c0d798;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .18s ease; }
  .mobile-section[open] > summary .mobile-section-chevron,.mobile-subsection[open] > summary .mobile-subsection-chevron { transform:rotate(180deg); }
  .mobile-subsections { display:grid;gap:9px;padding:0 0 16px; }
  .mobile-section-links { display:grid;padding:0 0 14px; }
  .mobile-section-links .mobile-nav-link { min-height:58px;border-bottom:1px solid #24272a;border-radius:0; }
  .mobile-subsection { overflow:hidden;border:1px solid #292c30;border-radius:13px;background:#121417; }
  .mobile-subsection summary { min-height:54px;display:flex;align-items:center;gap:12px;padding:0 13px;color:#eef0ed;list-style:none;cursor:pointer;font:500 14px/1.3 Geist,system-ui,sans-serif; }
  .mobile-subsection-label { min-width:0;flex:1; }
  .mobile-subsection-count { min-width:22px;color:#a8afb0;text-align:center;font-size:13px;font-variant-numeric:tabular-nums; }
  .mobile-subsection-chevron { width:16px;height:16px;stroke:#aeb4b4; }
  .mobile-subsection-links { display:grid;border-top:1px solid #292c30;background:#0e1012; }
  .mobile-nav-link { min-height:54px;display:flex;align-items:center;gap:12px;padding:7px 10px;border:1px solid transparent;border-radius:12px;color:#e2e4e1;text-decoration:none;font:400 15px/1.35 Geist,system-ui,sans-serif;transition:background .16s ease,border-color .16s ease,color .16s ease; }
  .mobile-subsection-links .mobile-nav-link + .mobile-nav-link { border-top:1px solid #24272a;border-radius:0; }
  .mobile-nav-link:hover,.mobile-nav-link:focus-visible,.mobile-nav-link[aria-current="page"] { border-color:#303236;background:#15171a;color:#fff; }
  .mobile-nav-link[aria-current="page"] .mobile-nav-icon { border-color:rgba(192,215,152,.4);background:rgba(192,215,152,.13);color:#c0d798; }
  .mobile-nav-icon { width:38px;height:38px;display:grid;place-items:center;flex:none;border:1px solid #303338;border-radius:10px;background:#141619;color:#c0d798; }
  .mobile-nav-icon svg { width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round; }
  .mobile-nav-label { min-width:0;flex:1; }
  .mobile-nav-arrow { width:17px;height:17px;flex:none;fill:none;stroke:#898e91;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;opacity:.75; }
  .mobile-drawer-footer { display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px 18px max(14px,env(safe-area-inset-bottom));border-top:1px solid #303236;background:#0b0c0e; }
  .mobile-contact-cta,.mobile-demo-cta { min-height:48px;display:flex;align-items:center;justify-content:center;gap:8px;padding:0 12px;border:1px solid #41454a;border-radius:11px;color:#f2f3f1;text-decoration:none;text-align:center;font:600 14px/1.2 Geist,system-ui,sans-serif; }
  .mobile-contact-cta { background:#111316; }
  .mobile-demo-cta { border-color:#c0d798;background:#c0d798;color:#10130c; }
  .mobile-demo-cta span { font-size:16px; }
  .mobile-drawer :focus-visible { outline:3px solid #c7d8a1;outline-offset:3px; }
  @media(max-width:380px) { .mobile-panel-inner { padding-right:16px;padding-left:16px; }.mobile-subsection summary { gap:8px;padding-right:10px;padding-left:10px;font-size:13px; }.mobile-drawer-footer { padding-right:12px;padding-left:12px; }.mobile-contact-cta,.mobile-demo-cta { padding:0 8px;font-size:13px; } }
  @media(max-height:520px) and (max-width:900px) { .mobile-panel-inner { padding-top:4px;padding-bottom:12px; }.mobile-section summary { min-height:54px;font-size:19px; }.mobile-subsection summary { min-height:48px; }.mobile-nav-link { min-height:48px; } }
  @media(prefers-reduced-motion:reduce) { .mobile-menu-overlay * { animation:none!important;transition-duration:.01ms!important;scroll-behavior:auto!important; } }
</style>
