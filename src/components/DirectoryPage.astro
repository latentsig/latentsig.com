---
import Layout from '../layouts/Layout.astro';
interface Item { title: string; description: string; status: string; href: string; }
interface Props { title: string; eyebrow: string; headline: string; description: string; items: Item[]; }
const { title, eyebrow, headline, description, items } = Astro.props;
---
<Layout title={`${title} · LatentSig`} description={description}>
  <section class="directory-page"><div class="directory-wrap"><p class="directory-eyebrow">{eyebrow}</p><h1>{headline}</h1><p class="directory-intro">{description}</p><div class="directory-grid">{items.map((item, index) => <a class="directory-card" href={item.href}><span class="directory-number">0{index + 1}</span><small>{item.status}</small><h2>{item.title}</h2><p>{item.description}</p><span class="directory-link">Explore <span aria-hidden="true">↗</span></span></a>)}</div></div></section>
</Layout>
<style>
  .directory-page{min-height:75vh;padding:90px 24px;background:radial-gradient(ellipse at 80% 0,#39336655,transparent 52%),#0b1020;color:#f4f2ff;font-family:Geist,system-ui,sans-serif}.directory-wrap{max-width:1180px;margin:auto}.directory-eyebrow{color:#c0c1ff;font-size:11px;font-weight:700;letter-spacing:.15em}.directory-page h1{max-width:900px;margin:18px 0;font:600 clamp(2.7rem,5.7vw,4.8rem)/1.02 'Hanken Grotesk',sans-serif;letter-spacing:-.04em}.directory-intro{max-width:820px;color:#bcbacf;font-size:16px;line-height:1.7}.directory-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:42px}.directory-card{position:relative;min-height:225px;padding:25px;border:1px solid #373b52;border-radius:11px;background:#11182a;color:inherit;text-decoration:none;transition:border-color .18s,transform .18s}.directory-card:hover{border-color:#8e89d0;transform:translateY(-3px)}.directory-number{position:absolute;right:22px;top:20px;color:#8582b6;font-size:12px}.directory-card small{color:#c0c1ff;font-size:10px;font-weight:700;letter-spacing:.12em}.directory-card h2{margin:19px 0 7px;font:600 22px 'Hanken Grotesk',sans-serif}.directory-card p{max-width:520px;color:#b3b1c5;font-size:14px;line-height:1.6}.directory-link{display:block;margin-top:20px;color:#c0c1ff;font-size:13px;font-weight:700}
  @media(max-width:650px){.directory-page{padding:60px 18px}.directory-grid{grid-template-columns:1fr}.directory-card{min-height:0}}
</style>
