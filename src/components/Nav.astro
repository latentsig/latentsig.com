<script>
  const triggers = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-trigger]')];
  const desktopQuery = matchMedia('(min-width: 881px)');
  const directLinks = [...document.querySelectorAll<HTMLAnchorElement>('.desktop-navigation > .nav-link')];
  const topLevelLinks = [...document.querySelectorAll<HTMLAnchorElement>('.desktop-navigation > .nav-item > .nav-link, .desktop-navigation > .nav-link')];
  let openTrigger: HTMLAnchorElement | null = null;
  let closeTimer = 0;
  let restoringFocus = false;
  let lastPointerPoint: { x: number; y: number } | null = null;
  document.addEventListener('pointermove', (event) => {
    if (event.pointerType === 'mouse') lastPointerPoint = { x: event.clientX, y: event.clientY };
  }, { passive: true });
  const cancelClose = () => {
    if (closeTimer) window.clearTimeout(closeTimer);
    closeTimer = 0;
  };
  const closeMenus = (restoreFocus = false) => {
    cancelClose();
    const previouslyOpen = openTrigger;
    triggers.forEach((trigger) => {
      const item = trigger.closest<HTMLElement>('[data-nav-item]');
      const panel = item?.querySelector<HTMLElement>('[data-nav-panel]');
      trigger.setAttribute('aria-expanded', 'false');
      item?.classList.remove('is-open');
      if (panel) panel.hidden = true;
    });
    openTrigger = null;
    if (restoreFocus && previouslyOpen) {
      restoringFocus = true;
      previouslyOpen.focus();
      restoringFocus = false;
    }
  };
  const openMenu = (trigger: HTMLAnchorElement) => {
    if (!desktopQuery.matches) return;
    cancelClose();
    if (openTrigger === trigger) return;
    closeMenus();
    const item = trigger.closest<HTMLElement>('[data-nav-item]');
    const panel = item?.querySelector<HTMLElement>('[data-nav-panel]');
    if (!item || !panel) return;
    openTrigger = trigger;
    trigger.setAttribute('aria-expanded', 'true');
    item.classList.add('is-open');
    panel.hidden = false;
  };
  const scheduleClose = (event: PointerEvent) => {
    if (event.pointerType !== 'mouse' || !openTrigger) return;
    cancelClose();
    closeTimer = window.setTimeout(() => {
      closeTimer = 0;
      const item = openTrigger?.closest<HTMLElement>('[data-nav-item]');
      if (item?.matches(':hover') || item?.contains(document.activeElement)) return;
      const pointerTarget = lastPointerPoint && document.elementFromPoint(lastPointerPoint.x, lastPointerPoint.y);
      if (pointerTarget?.closest('.nav-shell')) {
        // Keep the panel alive while a diagonal cursor crosses the navbar's open space.
        closeTimer = window.setTimeout(() => closeMenus(), 300);
        return;
      }
      closeMenus();
    }, 300);
  };
  triggers.forEach((trigger) => {
    const item = trigger.closest<HTMLElement>('[data-nav-item]');
    const panel = item?.querySelector<HTMLElement>('[data-nav-panel]');
    let touchShouldOpen = false;
    trigger.addEventListener('pointerdown', (event) => {
      touchShouldOpen = event.pointerType === 'touch' && trigger.getAttribute('aria-expanded') !== 'true';
    });
    trigger.addEventListener('click', (event) => {
      if (touchShouldOpen) {
        event.preventDefault();
        openMenu(trigger);
      }
      touchShouldOpen = false;
    });
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        openMenu(trigger);
        panel?.querySelector<HTMLAnchorElement>('.mega-link')?.focus();
      } else if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        const index = topLevelLinks.indexOf(trigger);
        const step = event.key === 'ArrowRight' ? 1 : -1;
        topLevelLinks[(index + step + topLevelLinks.length) % topLevelLinks.length]?.focus();
      }
    });
    item?.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') openMenu(trigger);
    });
    item?.addEventListener('focusin', () => { if (!restoringFocus) openMenu(trigger); });
    panel?.addEventListener('pointerenter', cancelClose);

    const grid = panel?.querySelector<HTMLElement>('.mega-link-grid, .products-mega-list');
    const links = [...(grid?.querySelectorAll<HTMLAnchorElement>('.mega-link, .product-menu-group h3 a') ?? [])];
    const images = [...(panel?.querySelectorAll<HTMLImageElement>('[data-preview-image]') ?? [])];
    let previewRequest = 0;
    links.forEach((link) => {
      const selectPreview = () => {
        links.forEach((sibling) => sibling.classList.toggle('is-previewed', sibling === link));
        if (grid) grid.dataset.previewActive = 'true';
        const src = link.dataset.previewSrc;
        if (!src) return;
        const visual = panel?.querySelector<HTMLElement>('.feature-visual');
        if (visual) visual.dataset.agentic = String(src.endsWith('products-agentic.webp') || src.endsWith('products-agentic-visual.svg'));
        const featureCopy = panel?.querySelector<HTMLElement>('[data-feature-copy]');
        if (featureCopy) featureCopy.textContent = 'Connected agents move a request through review to a sourced result.';
        const request = ++previewRequest;
        const active = images.find((image) => image.classList.contains('is-active'));
        if (active?.getAttribute('src') === src) return;
        const preloader = new Image();
        preloader.src = src;
        const swap = () => {
          if (request !== previewRequest || !preloader.naturalWidth) return;
          const current = images.find((image) => image.classList.contains('is-active'));
          const next = images.find((image) => image !== current);
          if (!next) return;
          next.src = src;
          requestAnimationFrame(() => {
            if (request !== previewRequest) return;
            next.classList.add('is-active');
            current?.classList.remove('is-active');
          });
        };
        if (preloader.complete) swap();
        else preloader.onload = swap;
      };
      link.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') selectPreview();
      });
      link.addEventListener('focus', selectPreview);
    });
    grid?.addEventListener('pointerleave', () => {
      if (grid) grid.dataset.previewActive = 'false';
      links.forEach((link) => link.classList.remove('is-previewed'));
    });
  });
  directLinks.forEach((link) => link.addEventListener('pointerenter', (event) => {
    if (event.pointerType === 'mouse') closeMenus();
  }));
  document.querySelector<HTMLElement>('.nav-shell')?.addEventListener('pointerleave', scheduleClose);
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target as Element).closest('[data-nav-item]')) closeMenus();
  });
  document.addEventListener('focusin', (event) => {
    if (openTrigger && !openTrigger.closest('[data-nav-item]')?.contains(event.target as Node)) closeMenus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && openTrigger) {
      event.preventDefault();
      closeMenus(true);
    }
  });
  desktopQuery.addEventListener('change', () => closeMenus());

  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const mobileClose = mobileMenu?.querySelector<HTMLButtonElement>('[data-mobile-close]');
  const mobileBackdrop = mobileMenu?.querySelector<HTMLButtonElement>('[data-mobile-backdrop]');
  const mobileSections = [...(mobileMenu?.querySelectorAll<HTMLDetailsElement>('.mobile-menu-section') ?? [])];
  mobileSections.forEach((section) => {
    section.addEventListener('toggle', () => {
      if (section.open) mobileSections.forEach((other) => { if (other !== section) other.open = false; });
    });
  });
  let previousBodyOverflow: string | undefined;
  if (button && mobileMenu) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      mobileMenu.hidden = !open;
      if (open) {
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        mobileClose?.focus();
      } else if (previousBodyOverflow !== undefined) {
        document.body.style.overflow = previousBodyOverflow;
        previousBodyOverflow = undefined;
      }
      if (restoreFocus) button.focus();
    };
    button.addEventListener('click', () => setOpen(mobileMenu.hidden));
    mobileClose?.addEventListener('click', () => setOpen(false, true));
    mobileBackdrop?.addEventListener('click', () => setOpen(false, true));
    mobileMenu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    mobileMenu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = [...mobileMenu.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),summary')]
        .filter((element) => !element.closest('[hidden]') && element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });
    document.addEventListener('pointerdown', (event) => {
      if (!mobileMenu.hidden && !mobileMenu.contains(event.target as Node) && !button.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileMenu.hidden) setOpen(false, true);
    });
    matchMedia('(min-width: 881px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
