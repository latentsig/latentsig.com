---
import Logo from './Logo.astro';
import { BOOK_DEMO_URL } from '../consts';

const path = Astro.url.pathname;

const menus = [
  {
    label: 'Products',
    href: '/products/',
    eyebrow: 'Featured · Demos',
    description: 'Explore interactive product concepts and review-ready AI workflows.',
    links: [
      { href: '/products/', label: 'Explore all products', detail: 'Tools for better data and practical AI workflows' },
      { href: '/products/annotation-verification/', label: 'Annotation & Verification Platform', detail: 'A product concept for organizing annotation, review, and verification workflows.' },
      { href: '/demos/#annotation-verification', label: 'Annotation & Verification demo', detail: 'View the interactive product concept' },
      { href: '/products/agentic-ai-platform/', label: 'Agentic AI Studio', detail: 'A product concept for shaping AI-assisted workflows with visible steps and review points.' },
      { href: '/demos/#agentic-ai-platform', label: 'Agentic AI Studio walkthrough', detail: 'See AI workflows with clear review points' },
    ],
  },
  {
    label: 'Solutions',
    href: '/solutions/',
    eyebrow: 'Digital Solutions',
    description: 'Applied AI and engineering for healthcare, industry, retail, and education.',
    links: [
      { href: '/solutions/healthcare/', label: 'Healthcare', detail: 'Care and clinical workflows' },
      { href: '/solutions/industry/', label: 'Industry', detail: 'Operations and quality systems' },
      { href: '/solutions/retail/', label: 'Retail', detail: 'Customer and commerce workflows' },
      { href: '/solutions/education/', label: 'Education', detail: 'Learning and knowledge systems' },
    ],
  },
  {
    label: 'Services',
    href: '/services/',
    eyebrow: 'How We Work',
    description: 'Focused R&D advisory, technical consulting, and practical delivery.',
    links: [
      { href: '/services/', label: 'Explore all services', detail: 'From research to production' },
      { href: '/rd-advisory/', label: 'Applied AI Research & Model Engineering', detail: 'Research and model engineering' },
      { href: '/consulting/', label: 'AI Consulting', detail: 'Focused technical guidance' },
      { href: '/implementation/', label: 'AI Implementation', detail: 'Practical delivery for production' },
    ],
  },
  {
    label: 'About',
    href: '/about/',
    eyebrow: 'LatentSig AI',
    description: 'Independent AI engineering and software studio based in Bengaluru.',
    links: [
      { href: '/about/', label: 'Company', detail: 'Research, products, and apps' },
      { href: '/contact/', label: 'Contact', detail: 'Get in touch with our team' },
    ],
  },
];

const previewImages: Record<string, string> = {
  '/products/': '/images/nav/products-agentic.webp',
  '/products/annotation-verification/': '/images/nav/products-agentic.webp',
  '/demos/#annotation-verification': '/images/nav/products-agentic.webp',
  '/products/agentic-ai-platform/': '/images/nav/products-agentic.webp',
  '/demos/#agentic-ai-platform': '/images/nav/products-agentic.webp',
  '/solutions/healthcare/': '/images/nav/solutions-healthcare.webp',
  '/solutions/industry/': '/images/nav/solutions-industry.webp',
  '/solutions/retail/': '/images/nav/solutions-retail.webp',
  '/solutions/education/': '/images/nav/solutions-education.webp',
  '/services/': '/images/nav/services-research.webp',
  '/rd-advisory/': '/images/nav/services-research.webp',
  '/consulting/': '/images/nav/services-consulting.webp',
  '/implementation/': '/images/nav/services-implementation.webp',
  '/about/': '/images/nav/about-research.webp',
  '/contact/': '/images/nav/services-consulting.webp',
};
const previewFor = (href: string) => previewImages[href] ?? '/3d/hero/observatory.webp';

const directLinks = [{ href: '/insights/', label: 'Insights' }];
const mobileIcons: Record<string, string> = {
  grid: '<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/>',
  spark: '<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/>',
  document: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 12h6M9 16h6"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="m10.8 7.2-4.6 8.6m7-8.6 4.6 8.6M7.5 18h9"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 8.2A2.5 2.5 0 0 0 7.1 21h9.8a2.5 2.5 0 0 0 2.1-3.8L14 9V3"/><path d="M8 15h8"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  building: '<path d="M4 21V5l8-3 8 3v16M8 8h1M15 8h1M8 12h1M15 12h1M8 16h1M15 16h1M10 21v-3h4v3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  chart: '<path d="M4 19V5M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/>',
  healthcare: '<path d="M12 4v16M4 12h16"/><circle cx="12" cy="12" r="9"/>',
  industry: '<path d="M3 21V9l6 4V9l6 4V5h6v16H3ZM17 8h1M17 12h1M17 16h1"/>',
  education: '<path d="m3 9 9-5 9 5-9 5-9-5Z"/><path d="M7 12v5c3 2 7 2 10 0v-5M21 9v6"/>',
};
const mobileIconByHref: Record<string, string> = {
  '/products/': 'grid',
  '/products/annotation-verification/': 'layers',
  '/demos/#annotation-verification': 'document',
  '/products/agentic-ai-platform/': 'spark',
  '/demos/#agentic-ai-platform': 'network',
  '/solutions/healthcare/': 'healthcare',
  '/solutions/industry/': 'industry',
  '/solutions/retail/': 'chart',
  '/solutions/education/': 'education',
  '/services/': 'grid',
  '/rd-advisory/': 'flask',
  '/consulting/': 'chart',
  '/implementation/': 'code',
  '/about/': 'building',
  '/contact/': 'mail',
  '/insights/': 'chart',
  '/insights/latent-signals-activation-probing/': 'network',
  '/insights/laya-rlcd-system-one/': 'spark',
  '/insights/dflash-muse-spark-1-2/': 'spark',
  '/blog/quantization-without-tears/': 'document',
};
const mobileIcon = (href: string) => mobileIcons[mobileIconByHref[href] ?? 'document'];
---

<header class="site-header">
  <nav aria-label="Main navigation" class="nav-shell">
    <a href="/" class="brand" aria-label="Latentsig home">
      <Logo height={36} showWordmark={false} class="brand-mark" />
      <span>latentsig</span>
    </a>

    <div class="desktop-navigation" aria-label="Site sections">
      {menus.map((menu) => (
        <div class="nav-item" data-nav-item>
          <a
            class:list={['nav-link', path === menu.href && 'is-current']}
            href={menu.href}
            aria-current={path === menu.href ? 'page' : undefined}
            aria-haspopup="true"
            aria-expanded="false"
            data-nav-trigger
          >
            {menu.label}
            <svg class="chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
          </a>
          <section class:list={['mega-menu', `mega-menu-${menu.label.toLowerCase()}`]} data-nav-panel aria-label={`${menu.label} menu`} hidden>
            {menu.label === 'Products' ? (
              <div class="products-mega-layout">
                <div class="products-mega-feature">
                  <div class="feature-visual" data-agentic="true">
                    <img class="feature-image is-active" data-preview-image src="/images/nav/products-agentic.webp" alt="" width="720" height="440" loading="eager" decoding="async" />
                    <img class="feature-image" data-preview-image src="/images/nav/products-agentic.webp" alt="" width="720" height="440" loading="eager" decoding="async" />
                    <svg class="agent-flow" data-agent-flow aria-hidden="true" viewBox="0 0 340 260" preserveAspectRatio="none"><path class="agent-flow-path" d="M22 145 C79 68 114 201 167 130 S253 70 318 144" /><circle class="agent-flow-pulse" r="3.5"><animateMotion dur="4.2s" repeatCount="indefinite" path="M22 145 C79 68 114 201 167 130 S253 70 318 144" /></circle></svg>
                  </div>
                  <span class="menu-overline">Two focused workspaces</span><h2>Workflows, made visible.</h2><p data-feature-copy>Connected agents move a request through review to a sourced result.</p>
                </div>
                <div class="products-mega-list"><span class="menu-overline">Our products</span>
                  <article class="product-menu-group product-menu-agentic"><h3><a href="/products/agentic-ai-platform/" data-preview-src="/images/nav/products-agentic.webp">Agentic AI Studio</a></h3><p>Connected agents, visible execution and human review.</p><div><a class="mega-link" href="/demos/#agentic-ai-platform" data-preview-src="/images/nav/products-agentic.webp"><strong>Interactive demo <span>↗</span></strong></a></div></article>
                  <article class="product-menu-group product-menu-annotation"><h3><a href="/products/annotation-verification/" data-preview-src="/images/nav/products-agentic.webp">Annotation &amp; Verification</a></h3><p>Visual labels reviewed and approved by people.</p><div><a class="mega-link" href="/demos/#annotation-verification" data-preview-src="/images/nav/products-agentic.webp"><strong>Interactive demo <span>↗</span></strong></a></div></article>
                </div>
                <div class="products-mega-trust" role="group" aria-label="Trust and capabilities information"><span class="menu-overline">Built for careful work</span><div><i aria-hidden="true">✓</i>Human approvals</div><div><i aria-hidden="true">◇</i>LLM &amp; human evaluation</div><div><i aria-hidden="true">◷</i>Observable, auditable runs</div><div><i aria-hidden="true">⌑</i>Security-minded workflows</div><div><i aria-hidden="true">▤</i>Reliable data foundations</div><div class="deployment-info"><i aria-hidden="true">•</i><span>Deployment fit<br /><small>On-premises, Google Cloud or AWS are discussion options, not preconfigured offers.</small></span></div></div>
              </div>
            ) : (
            <div class="mega-feature" aria-hidden="true">
                <div class="feature-visual" data-agentic={previewFor(menu.links[0].href).endsWith('products-agentic.webp') ? 'true' : 'false'}>
                <img class="feature-image is-active" data-preview-image src={previewFor(menu.links[0].href)} alt="" width="720" height="440" loading="eager" decoding="async" />
                <img class="feature-image" data-preview-image src={previewFor(menu.links[0].href)} alt="" width="720" height="440" loading="eager" decoding="async" />
                {menu.label === 'Products' && (
                  <svg class="agent-flow" data-agent-flow aria-hidden="true" viewBox="0 0 340 260" preserveAspectRatio="none">
                    <path class="agent-flow-path" d="M22 145 C79 68 114 201 167 130 S253 70 318 144" />
                    <circle class="agent-flow-pulse" r="3.5"><animateMotion dur="4.2s" repeatCount="indefinite" path="M22 145 C79 68 114 201 167 130 S253 70 318 144" /></circle>
                  </svg>
                )}
              </div>
            </div>
            <div class="mega-links">
              <span class="menu-overline">Discover</span>
              <h2>{menu.label}</h2>
              <div class="mega-link-grid">
                {menu.links.map((link) => (
                  <a class="mega-link" href={link.href} data-preview-src={previewFor(link.href)}>
                    <span><strong>{link.label}</strong><small>{link.detail}</small></span>
                    <span class="link-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
            )}
          </section>
        </div>
      ))}
      {directLinks.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
          class:list={['nav-link', path === link.href && 'is-current']}
        >{link.label}</a>
      ))}
    </div>

    <a class="nav-cta" href={BOOK_DEMO_URL}>
      <span>Book a Demo</span><span aria-hidden="true">↗</span>
    </a>

    <button id="mobile-menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <button class="mobile-menu-backdrop" type="button" aria-label="Close navigation menu" data-mobile-backdrop></button>
    <section class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile navigation" tabindex="-1">
      <div class="mobile-drawer-header">
        <a href="/" class="mobile-brand" aria-label="Latentsig home">
          <Logo height={32} showWordmark={false} class="mobile-brand-mark" />
          <span>latentsig</span>
        </a>
        <button class="mobile-menu-close" type="button" aria-label="Close navigation menu" data-mobile-close>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <nav class="mobile-drawer-content" aria-label="Mobile navigation links">
        <div class="mobile-panel-inner">
          {menus.map((menu) => (
            <details class="mobile-menu-section" name="mobile-nav-sections" open={menu.href === '/products/'}>
              <summary>{menu.label}<svg class="mobile-section-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
              <div class="mobile-section-links">
                {menu.links.map((link) => (
                  <a class="mobile-nav-link" href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                    <span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={mobileIcon(link.href)}></svg></span>
                    <span class="mobile-nav-label">{link.label}</span>
                    <svg class="mobile-nav-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                  </a>
                ))}
              </div>
            </details>
          ))}
          <a class="mobile-insights-link" href="/insights/" aria-current={path === '/insights/' ? 'page' : undefined}>Insights</a>
        </div>
      </nav>
      <div class="mobile-drawer-footer">
        <a class="mobile-contact-cta" href="/contact/">Talk to us</a>
        <a class="mobile-demo-cta" href={BOOK_DEMO_URL}>Book a Demo<span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</header>

<noscript><style>.site-header{position:static!important}#mobile-menu{display:block!important}#mobile-menu-toggle{display:none!important}#main-content{padding-top:0}</style></noscript>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .nav-shell {
    pointer-events: auto;
    position: relative;
    width: 100%;
    min-height: 84px;
    padding: 0 clamp(24px, 7vw, 132px);
    display: flex;
    align-items: center;
    gap: 24px;
    border: 0;
    border-bottom: 1px solid rgba(200, 204, 231, .16);
    border-radius: 0;
    color: #f2f3fc;
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
  }
  .brand {
    color: inherit;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    padding: 0 10px 0 0;
    font: 700 21px/1 'Geist', ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -.055em;
    text-decoration: none;
  }
  .brand-mark {
    display: block;
    border-radius: 12px;
    background: #10152d;
    box-shadow: 0 2px 12px rgba(0,0,0,.24);
  }
  .desktop-navigation { display:flex; align-self:stretch; align-items:center; justify-content:center; gap:clamp(4px, 1.1vw, 18px); flex:1; }
  .nav-item { align-self:stretch; display:flex; align-items:center; }
  .nav-link {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    min-height:44px;
    padding:0 10px;
    color:rgba(232,233,246,.83);
    font:500 15px/1.2 'Geist', ui-sans-serif, system-ui, sans-serif;
    text-decoration:none;
    white-space:nowrap;
    transition:color .18s ease, background .18s ease;
  }
  .nav-link:hover,.nav-link:focus-visible,.nav-link.is-current,.nav-item.is-open>.nav-link { color:#c7c4ff; }
  .nav-link:focus-visible,.nav-cta:focus-visible,.brand:focus-visible { outline:2px solid #aaa6ff; outline-offset:3px; }
  .chevron { width:14px; height:14px; stroke:currentColor; stroke-width:1.35; transition:transform .2s ease; }
  .nav-item.is-open .chevron { transform:rotate(180deg); }
  .nav-cta {
    flex:0 0 auto;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:11px;
    min-height:52px;
    padding:0 22px;
    border-radius:999px;
    color:#f7f7ff;
    background:#171922;
    border:1px solid rgba(255,255,255,.12);
    font:650 14px/1 'Geist', ui-sans-serif, system-ui, sans-serif;
    text-decoration:none;
    transition:background .2s ease, transform .2s ease, border-color .2s ease;
  }
  .nav-cta:hover { background:#25283a; border-color:rgba(190,187,255,.4); transform:translateY(-1px); }
  .nav-cta span:last-child { font-size:16px; }
  .mega-menu {
    position:absolute;
    top:100%;
    left:0;
    right:0;
    display:grid;
    grid-template-columns:minmax(270px, 360px) minmax(0, 1fr);
    gap:24px;
    padding:16px;
    color:#f2f3f8;
    border:1px solid rgba(200,204,231,.18);
    border-top:0;
    border-radius:0 0 24px 24px;
    background:rgba(12,15,22,.94);
    -webkit-backdrop-filter:blur(26px) saturate(135%);
    backdrop-filter:blur(26px) saturate(135%);
    box-shadow:0 24px 70px rgba(0,0,0,.42);
    animation:menu-in .18s ease both;
  }
  .mega-menu[hidden] { display:none; }
  .mega-menu-products { display:block; }
  .products-mega-layout{display:grid;grid-template-columns:minmax(250px,.92fr) minmax(330px,1.18fr) minmax(230px,.78fr);gap:24px;align-items:stretch;color:#f2f3f8}
  .products-mega-feature{display:flex;flex-direction:column;min-width:0;padding:3px 2px 5px}.products-mega-feature .feature-visual{flex:1;min-height:195px;margin-bottom:14px}.products-mega-feature .menu-overline{margin-top:auto}.products-mega-feature h2{margin:7px 0 5px;font:600 20px/1.2 'Geist',ui-sans-serif,system-ui,sans-serif;letter-spacing:-.03em}.products-mega-feature p{max-width:300px;margin:0;color:rgba(223,225,235,.65);font:400 11px/1.45 'Geist',ui-sans-serif,system-ui,sans-serif}
  .products-mega-list{display:grid;align-content:start;gap:13px}.products-mega-list>.menu-overline,.products-mega-trust>.menu-overline{display:block;margin:3px 0 1px}.product-menu-group{padding:13px 12px 10px;border:1px solid rgba(255,255,255,.11);border-radius:11px;background:rgba(255,255,255,.025)}.product-menu-group h3{margin:0;color:#f2f3f8;font:600 13px/1.3 'Geist',ui-sans-serif,system-ui,sans-serif}.product-menu-group p{margin:4px 0 9px;color:rgba(223,225,235,.57);font:400 10px/1.35 'Geist',ui-sans-serif,system-ui,sans-serif}.product-menu-group>div{display:grid;grid-template-columns:1fr;gap:6px}.product-menu-group .mega-link{min-height:37px;padding:8px;border:1px solid rgba(255,255,255,.1);border-radius:6px;background:rgba(10,14,27,.34)}.product-menu-group .mega-link strong{font-size:9px;font-weight:600}.product-menu-group .mega-link strong span{margin-left:5px;color:#c3c0ff}
  .mega-menu-products .product-menu-group{position:relative;isolation:isolate;display:flex;min-height:118px;flex-direction:column;justify-content:center;align-items:flex-start;overflow:hidden;padding:13px 15px 12px;border:1px solid rgba(192,201,233,.2);border-radius:14px;background:#111729;color:#fff}
  .mega-menu-products .product-menu-group::before{position:absolute;inset:0;z-index:-1;content:"";background-size:cover;background-position:center 54%;opacity:.96;transition:transform .5s cubic-bezier(.2,.7,.2,1)}
  .mega-menu-products .product-menu-agentic::before{background-image:linear-gradient(90deg,rgba(8,13,27,.98) 0%,rgba(8,13,27,.86) 44%,rgba(8,13,27,.2) 100%),url('/images/nav/product-agentic-menu.webp')}
  .mega-menu-products .product-menu-annotation::before{background-image:linear-gradient(90deg,rgba(8,13,27,.98) 0%,rgba(8,13,27,.86) 44%,rgba(8,13,27,.2) 100%),url('/images/nav/product-annotation-menu.webp')}
  .mega-menu-products .product-menu-group:hover::before,.mega-menu-products .product-menu-group:focus-within::before{transform:scale(1.04)}
  .mega-menu-products .product-menu-group h3,.mega-menu-products .product-menu-group h3 a{position:relative;color:#fff!important;text-decoration:none}
  .mega-menu-products .product-menu-group p{position:relative;max-width:75%;margin:4px 0 8px;color:rgba(244,246,255,.78)!important}
  .mega-menu-products .product-menu-group>div{position:relative;display:flex;grid-template-columns:none;gap:6px}
  .mega-menu-products .product-menu-group .mega-link{display:inline-flex;width:max-content;min-height:0;align-items:center;padding:2px 0;border:1px solid transparent;border-radius:0;background:transparent;color:#fff}
  .mega-menu-products .product-menu-group .mega-link:hover,.mega-menu-products .product-menu-group .mega-link:focus-visible{border-color:transparent;background:transparent;color:#cbc6ff;transform:none}
  .mega-menu-products .product-menu-group .mega-link strong{font-size:9px;font-weight:600}
  .mega-menu-products .product-menu-group .mega-link strong span{color:#cbc6ff}
  .products-mega-trust{display:grid;align-content:start;gap:7px;padding-left:16px;border-left:1px solid rgba(255,255,255,.12);cursor:default}.products-mega-trust>div{display:flex;align-items:center;gap:9px;min-height:22px;color:#e8eaf4;font:500 10px/1.35 'Geist',ui-sans-serif,system-ui,sans-serif;cursor:default;user-select:none}.products-mega-trust>div>i{width:17px;height:17px;display:grid;place-items:center;border:1px solid rgba(177,178,255,.27);border-radius:5px;color:#c2c0ff;background:rgba(137,131,255,.1);font-size:9px;font-style:normal}.products-mega-trust .deployment-info{align-items:flex-start}.products-mega-trust .deployment-info>span{display:block}.products-mega-trust .deployment-info small{color:#8691aa;font-size:8px}
  .mega-feature {
    min-width:0;
    min-height:268px;
    padding:10px;
    border:1px solid rgba(177,178,255,.24);
    border-radius:18px;
    background:radial-gradient(ellipse at 30% 10%,rgba(126,119,245,.24),transparent 64%),#141a34;
    box-shadow:inset 0 1px rgba(255,255,255,.08);
  }
