---
import Logo from './Logo.astro';
import { CALENDLY_URL } from '../consts';

const path = Astro.url.pathname;

const menus = [
  {
    label: 'Products',
    href: '/products/',
    eyebrow: 'Featured · Demos',
    description: 'Explore interactive product concepts and review-ready AI workflows.',
    links: [
      { href: '/products/', label: 'Explore all products', detail: 'Tools for better data and practical AI workflows' },
      { href: '/products/annotation-verification/', label: 'Annotation & Verification Platform', detail: 'A product concept for organizing annotation, review, and verification workflows.' },
      { href: '/demos/#annotation-verification', label: 'Annotation & Verification demo', detail: 'View the interactive product concept' },
      { href: '/products/agentic-ai-platform/', label: 'Agentic AI Studio', detail: 'A product concept for shaping AI-assisted workflows with visible steps and review points.' },
      { href: '/demos/#agentic-ai-platform', label: 'Agentic AI Studio walkthrough', detail: 'See AI workflows with clear review points' },
    ],
  },
  {
    label: 'Solutions',
    href: '/solutions/',
    eyebrow: 'Digital Solutions',
    description: 'Applied AI and engineering for healthcare, industry, retail, and education.',
    links: [
      { href: '/solutions/#healthcare', label: 'Healthcare', detail: 'Care and clinical workflows' },
      { href: '/solutions/#industry', label: 'Industry', detail: 'Operations and quality systems' },
      { href: '/solutions/#retail', label: 'Retail', detail: 'Customer and commerce workflows' },
      { href: '/solutions/#education', label: 'Education', detail: 'Learning and knowledge systems' },
    ],
  },
  {
    label: 'Services',
    href: '/services/',
    eyebrow: 'How We Work',
    description: 'Focused R&D advisory, technical consulting, and practical delivery.',
    links: [
      { href: '/services/', label: 'Explore all services', detail: 'From research to production' },
      { href: '/rd-advisory/', label: 'Applied AI Research & Model Engineering', detail: 'Research and model engineering' },
      { href: '/consulting/', label: 'AI Consulting', detail: 'Focused technical guidance' },
      { href: '/implementation/', label: 'AI Implementation', detail: 'Practical delivery for production' },
    ],
  },
  {
    label: 'About',
    href: '/about/',
    eyebrow: 'LatentSig AI',
    description: 'Independent AI engineering and software studio based in Bengaluru.',
    links: [
      { href: '/about/', label: 'Company', detail: 'Research, products, and apps' },
      { href: '/contact/', label: 'Contact', detail: 'Get in touch with our team' },
    ],
  },
];

const directLinks = [{ href: '/insights/', label: 'Insights' }];
const mobileIcons: Record<string, string> = {
  grid: '<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/>',
  spark: '<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/>',
  document: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 12h6M9 16h6"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="m10.8 7.2-4.6 8.6m7-8.6 4.6 8.6M7.5 18h9"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  flask: '<path d="M9 3h6M10 3v6l-5 8.2A2.5 2.5 0 0 0 7.1 21h9.8a2.5 2.5 0 0 0 2.1-3.8L14 9V3"/><path d="M8 15h8"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  building: '<path d="M4 21V5l8-3 8 3v16M8 8h1M15 8h1M8 12h1M15 12h1M8 16h1M15 16h1M10 21v-3h4v3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  chart: '<path d="M4 19V5M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/>',
  healthcare: '<path d="M12 4v16M4 12h16"/><circle cx="12" cy="12" r="9"/>',
  industry: '<path d="M3 21V9l6 4V9l6 4V5h6v16H3ZM17 8h1M17 12h1M17 16h1"/>',
  education: '<path d="m3 9 9-5 9 5-9 5-9-5Z"/><path d="M7 12v5c3 2 7 2 10 0v-5M21 9v6"/>',
};
const mobileIconByHref: Record<string, string> = {
  '/products/': 'grid',
  '/products/annotation-verification/': 'layers',
  '/demos/#annotation-verification': 'document',
  '/products/agentic-ai-platform/': 'spark',
  '/demos/#agentic-ai-platform': 'network',
  '/solutions/#healthcare': 'healthcare',
  '/solutions/#industry': 'industry',
  '/solutions/#retail': 'chart',
  '/solutions/#education': 'education',
  '/services/': 'grid',
  '/rd-advisory/': 'flask',
  '/consulting/': 'chart',
  '/implementation/': 'code',
  '/about/': 'building',
  '/contact/': 'mail',
  '/insights/': 'chart',
  '/insights/latent-signals-activation-probing/': 'network',
  '/insights/laya-rlcd-system-one/': 'spark',
  '/insights/dflash-muse-spark-1-2/': 'spark',
  '/blog/quantization-without-tears/': 'document',
};
const mobileIcon = (href: string) => mobileIcons[mobileIconByHref[href] ?? 'document'];
---

<header class="site-header">
  <nav aria-label="Main navigation" class="nav-shell">
    <a href="/" class="brand" aria-label="Latentsig home">
      <Logo height={36} showWordmark={false} class="brand-mark" />
      <span>latentsig</span>
    </a>

    <div class="desktop-navigation" aria-label="Site sections">
      {menus.map((menu) => (
        <div class="nav-item" data-nav-item>
          <a
            class:list={['nav-link', path === menu.href && 'is-current']}
            href={menu.href}
            aria-current={path === menu.href ? 'page' : undefined}
            aria-haspopup="true"
            aria-expanded="false"
            data-nav-trigger
          >
            {menu.label}
            <svg class="chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
          </a>
          <section class="mega-menu" data-nav-panel aria-label={`${menu.label} menu`} hidden>
            <div class="mega-feature">
              <span class="menu-kicker"><span></span>{menu.eyebrow}</span>
              <p>{menu.description}</p>
              <a class="feature-link" href={menu.href}>Explore {menu.label}<span aria-hidden="true">↗</span></a>
            </div>
            <div class="mega-links">
              <span class="menu-overline">Discover</span>
              <h2>{menu.label}</h2>
              <div class="mega-link-grid">
                {menu.links.map((link) => (
                  <a class="mega-link" href={link.href}>
                    <span><strong>{link.label}</strong><small>{link.detail}</small></span>
                    <span class="link-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        </div>
      ))}
      {directLinks.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
          class:list={['nav-link', path === link.href && 'is-current']}
        >{link.label}</a>
      ))}
    </div>

    <a class="nav-cta" href={CALENDLY_URL} target="_blank" rel="noopener">
      <span>Book a Demo</span><span aria-hidden="true">↗</span>
    </a>

    <button id="mobile-menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <button class="mobile-menu-backdrop" type="button" aria-label="Close navigation menu" data-mobile-backdrop></button>
    <section class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile navigation" tabindex="-1">
      <div class="mobile-drawer-header">
        <a href="/" class="mobile-brand" aria-label="Latentsig home">
          <Logo height={32} showWordmark={false} class="mobile-brand-mark" />
          <span>latentsig</span>
        </a>
        <button class="mobile-menu-close" type="button" aria-label="Close navigation menu" data-mobile-close>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <nav class="mobile-drawer-content" aria-label="Mobile navigation links">
        <div class="mobile-panel-inner">
          {menus.map((menu) => (
            <details class="mobile-menu-section" name="mobile-nav-sections" open={menu.href === '/products/'}>
              <summary>{menu.label}<svg class="mobile-section-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
              <div class="mobile-section-links">
                {menu.links.map((link) => (
                  <a class="mobile-nav-link" href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                    <span class="mobile-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={mobileIcon(link.href)}></svg></span>
                    <span class="mobile-nav-label">{link.label}</span>
                    <svg class="mobile-nav-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                  </a>
                ))}
              </div>
            </details>
          ))}
          <a class="mobile-insights-link" href="/insights/" aria-current={path === '/insights/' ? 'page' : undefined}>Insights</a>
        </div>
      </nav>
      <div class="mobile-drawer-footer">
        <a class="mobile-contact-cta" href="/contact/">Talk to us</a>
        <a class="mobile-demo-cta" href={CALENDLY_URL} target="_blank" rel="noopener">Book a Demo<span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</header>

<noscript><style>.site-header{position:static!important}#mobile-menu{display:block!important}#mobile-menu-toggle{display:none!important}#main-content{padding-top:0}</style></noscript>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .nav-shell {
    pointer-events: auto;
    position: relative;
    width: 100%;
    min-height: 84px;
    padding: 9px clamp(24px, 7vw, 132px);
    display: flex;
    align-items: center;
    gap: 24px;
    border: 0;
    border-bottom: 1px solid rgba(200, 204, 231, .16);
    border-radius: 0;
    color: #f2f3fc;
    background: rgba(10, 15, 31, .76);
    -webkit-backdrop-filter: blur(22px) saturate(135%);
    backdrop-filter: blur(22px) saturate(135%);
    box-shadow: none;
  }
  .brand {
    color: inherit;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    padding: 0 10px 0 0;
    font: 700 21px/1 'Geist', ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -.055em;
    text-decoration: none;
  }
  .brand-mark {
    display: block;
    border-radius: 12px;
    background: #10152d;
    box-shadow: 0 2px 12px rgba(0,0,0,.24);
  }
  .desktop-navigation { display:flex; align-items:center; justify-content:center; gap:clamp(4px, 1.1vw, 18px); flex:1; height:100%; }
  .nav-item { height:100%; display:flex; align-items:center; }
  .nav-link {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    min-height:44px;
    padding:0 10px;
    color:rgba(232,233,246,.83);
    font:500 15px/1.2 'Geist', ui-sans-serif, system-ui, sans-serif;
    text-decoration:none;
    white-space:nowrap;
    transition:color .18s ease, background .18s ease;
  }
  .nav-link:hover,.nav-link:focus-visible,.nav-link.is-current { color:#c7c4ff; }
  .nav-link:focus-visible,.nav-cta:focus-visible,.brand:focus-visible { outline:2px solid #aaa6ff; outline-offset:3px; }
  .chevron { width:14px; height:14px; stroke:currentColor; stroke-width:1.35; transition:transform .2s ease; }
  .nav-item.is-open .chevron { transform:rotate(180deg); }
  .nav-cta {
    flex:0 0 auto;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:11px;
    min-height:52px;
    padding:0 22px;
    border-radius:999px;
    color:#f7f7ff;
    background:#171922;
    border:1px solid rgba(255,255,255,.12);
    font:650 14px/1 'Geist', ui-sans-serif, system-ui, sans-serif;
    text-decoration:none;
    transition:background .2s ease, transform .2s ease, border-color .2s ease;
  }
  .nav-cta:hover { background:#25283a; border-color:rgba(190,187,255,.4); transform:translateY(-1px); }
  .nav-cta span:last-child { font-size:16px; }
  .mega-menu {
    position:absolute;
    top:calc(100% + 12px);
    left:0;
    right:0;
    display:grid;
    grid-template-columns:minmax(270px, .82fr) 1.65fr;
    gap:24px;
    padding:16px;
    color:#f2f3f8;
    border:1px solid rgba(200,204,231,.18);
    border-radius:26px;
    background:rgba(12,15,22,.94);
    -webkit-backdrop-filter:blur(26px) saturate(135%);
    backdrop-filter:blur(26px) saturate(135%);
    box-shadow:0 24px 70px rgba(0,0,0,.42);
    animation:menu-in .18s ease both;
  }
  .mega-menu[hidden] { display:none; }
  .mega-feature {
    min-height:190px;
    padding:22px;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    border:1px solid rgba(255,255,255,.105);
    border-radius:20px;
    background:radial-gradient(ellipse at 10% 0%, rgba(133,126,255,.16), transparent 62%),rgba(255,255,255,.025);
  }
  .menu-kicker,.menu-overline { color:#aaa8d7; font:700 10px/1.3 'Geist',ui-sans-serif,system-ui,sans-serif; letter-spacing:.13em; text-transform:uppercase; }
  .menu-kicker { display:flex; align-items:center; gap:8px; }
  .menu-kicker span { width:7px; height:7px; border-radius:50%; background:#b6b2ff; box-shadow:0 0 12px #8b86ff; }
  .mega-feature p { margin:20px 0 18px; max-width:310px; color:rgba(237,238,246,.75); font:400 15px/1.55 'Geist',ui-sans-serif,system-ui,sans-serif; }
  .feature-link { display:flex; align-items:center; gap:10px; margin-top:auto; color:#c4c1ff; font:650 13px/1.3 'Geist',ui-sans-serif,system-ui,sans-serif; text-decoration:none; }
  .feature-link:hover { color:#fff; }
  .mega-links { padding:13px 12px 8px 0; }
  .mega-links h2 { margin:7px 0 18px; font:600 24px/1.15 'Geist',ui-sans-serif,system-ui,sans-serif; letter-spacing:-.035em; }
  .mega-link-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
  .mega-link {
    min-height:74px;
    padding:14px 13px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    border:1px solid transparent;
    border-bottom-color:rgba(255,255,255,.12);
    border-radius:12px 12px 5px 5px;
    color:inherit;
    text-decoration:none;
    transition:background .18s ease,border-color .18s ease,transform .18s ease;
  }
  .mega-link:hover { background:rgba(255,255,255,.045); border-color:rgba(255,255,255,.1); transform:translateY(-1px); }
  .mega-link strong,.mega-link small { display:block; }
  .mega-link strong { font:600 14px/1.35 'Geist',ui-sans-serif,system-ui,sans-serif; }
  .mega-link small { margin-top:5px; color:rgba(223,225,235,.58); font:400 12px/1.35 'Geist',ui-sans-serif,system-ui,sans-serif; }
  .link-arrow { color:#c3c0ff; font-size:16px; }
  #mobile-menu-toggle { display:none; color:inherit; border:0; background:transparent; border-radius:50%; width:46px; height:46px; align-items:center; justify-content:center; cursor:pointer; }
  .mobile-menu { display:none; }
  .mobile-menu[hidden] { display:none!important; }
  .mobile-menu-backdrop { position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;background:rgba(2,6,18,.64);-webkit-backdrop-filter:blur(7px);backdrop-filter:blur(7px); }
  .mobile-drawer { position:absolute;inset:0;width:100%;height:100dvh;display:grid;grid-template-rows:68px minmax(0,1fr) auto;overflow:hidden;background:#fff;color:#18181b;box-shadow:0 20px 60px rgba(15,23,42,.14); }
  .mobile-drawer-header { display:flex;align-items:center;justify-content:space-between;padding:0 max(18px,env(safe-area-inset-right)) 0 max(18px,env(safe-area-inset-left));border-bottom:1px solid #e4e4e7;background:#fff; }
  .mobile-brand { display:flex;align-items:center;gap:8px;min-height:44px;color:#18181b;text-decoration:none;font:700 20px/1 'Geist',ui-sans-serif,system-ui,sans-serif;letter-spacing:-.055em; }
  .mobile-brand-mark { display:block;border-radius:10px;background:#10152d;box-shadow:0 2px 12px rgba(0,0,0,.24); }
  .mobile-menu-close { width:42px;height:42px;display:grid;place-items:center;border:1px solid #e4e4e7;border-radius:50%;background:#f4f4f5;color:#18181b;cursor:pointer; }
  .mobile-menu-close svg { width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round; }
  .mobile-drawer-content { min-height:0;overflow-y:auto;overscroll-behavior:contain;background:#fff;scrollbar-color:#d4d4d8 transparent; }
  .mobile-panel-inner { width:min(100%,560px);margin:0 auto;padding:8px 20px 20px; }
  .mobile-menu-section { border-bottom:1px solid #f0f0f2; }
  .mobile-menu-section summary { min-height:60px;display:flex;align-items:center;justify-content:space-between;gap:14px;color:#18181b;list-style:none;cursor:pointer;font:600 18px/1.25 'Geist',ui-sans-serif,system-ui,sans-serif;letter-spacing:-.015em; }
  .mobile-menu-section summary::-webkit-details-marker { display:none; }
  .mobile-insights-link { min-height:60px;display:flex;align-items:center;color:#18181b;border-bottom:1px solid #f0f0f2;text-decoration:none;font:600 18px/1.25 'Geist',ui-sans-serif,system-ui,sans-serif;letter-spacing:-.015em; }
  .mobile-insights-link:hover,.mobile-insights-link:focus-visible,.mobile-insights-link[aria-current="page"] { color:#10152d; }
  .mobile-section-chevron { width:18px;height:18px;flex:none;fill:none;stroke:#52525b;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s ease; }
  .mobile-menu-section[open] .mobile-section-chevron { transform:rotate(180deg);stroke:#18181b; }
  .mobile-section-links { display:grid;gap:3px;padding:0 0 12px; }
  .mobile-nav-link { min-height:50px;display:flex;align-items:center;gap:12px;padding:8px 12px;border:1px solid transparent;border-radius:10px;color:#27272a;text-decoration:none;font:500 14.5px/1.35 'Geist',ui-sans-serif,system-ui,sans-serif;transition:background .16s ease,color .16s ease; }
  .mobile-nav-link:hover,.mobile-nav-link:focus-visible,.mobile-nav-link[aria-current="page"] { background:#f4f4f5;color:#09090b; }
  .mobile-nav-icon { width:36px;height:36px;display:grid;place-items:center;flex:none;border:1px solid #e4e4e7;border-radius:9px;background:#f4f4f5;color:#52525b; }
  .mobile-nav-icon svg { width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round; }
  .mobile-nav-link[aria-current="page"] .mobile-nav-icon { border-color:#6d7b50;background:#edf2e4;color:#4f5e3b; }
  .mobile-nav-label { min-width:0;flex:1; }
  .mobile-nav-arrow { width:16px;height:16px;flex:none;fill:none;stroke:#a1a1aa;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round; }
  .mobile-drawer-footer { display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px 18px max(16px,env(safe-area-inset-bottom));border-top:1px solid #e4e4e7;background:#fafafa; }
  .mobile-contact-cta,.mobile-demo-cta { min-height:48px;display:flex;align-items:center;justify-content:center;gap:8px;padding:0 12px;border-radius:9px;text-decoration:none;text-align:center;font:600 14px/1.2 'Geist',ui-sans-serif,system-ui,sans-serif; }
  .mobile-contact-cta { border:1px solid #d4d4d8;color:#18181b;background:#fff; }
  .mobile-demo-cta { border:1px solid #10152d;background:#10152d;color:#fff;box-shadow:0 2px 8px rgba(16,21,45,.2); }
  .mobile-demo-cta:hover { background:#0b1326;border-color:#0b1326; }
  .mobile-demo-cta span { margin-left:5px;font-size:16px; }
  @media(max-width:380px) { .mobile-panel-inner { padding-right:14px;padding-left:14px; }.mobile-drawer-footer { padding-right:12px;padding-left:12px;gap:8px; }.mobile-contact-cta,.mobile-demo-cta { padding:0 8px;font-size:13px; } }
  @keyframes menu-in { from { opacity:0; transform:translateY(-5px); } to { opacity:1; transform:translateY(0); } }
  @media(max-width:1100px) { .nav-shell { gap:12px; } .desktop-navigation { gap:2px; } .nav-link { padding:0 7px; font-size:13px; } .brand { font-size:19px; } .nav-cta { padding:0 16px; } }
  @media(max-width:880px) {
    .site-header { inset:0 0 auto; }
    .nav-shell { min-height:68px; padding:7px 18px; gap:8px; }
    .brand { gap:9px; font-size:19px; }
    .brand-mark { height:34px!important; width:34px!important; }
    .desktop-navigation { display:none; }
    .nav-cta { margin-left:auto; min-height:44px; padding:0 16px; font-size:13px; }
    #mobile-menu-toggle { display:inline-flex; flex:0 0 auto; }
    .mobile-menu:not([hidden]) { display:block;position:fixed;z-index:100;inset:0;pointer-events:auto; }
  }
  @media(max-width:460px) { .nav-shell { min-height:62px; padding:6px 12px; } .brand { gap:7px; font-size:17px; } .brand-mark { height:31px!important; width:31px!important; border-radius:10px; } .nav-cta { min-height:40px; padding:0 12px; gap:7px; font-size:12px; } #mobile-menu-toggle { width:40px; height:40px; } }
  @media(prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; } }
</style>

<script>
  const triggers = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-trigger]')];
  const closeMenus = (except?: HTMLAnchorElement) => {
    triggers.forEach((trigger) => {
      const item = trigger.closest<HTMLElement>('[data-nav-item]');
      const panel = item?.querySelector<HTMLElement>('[data-nav-panel]');
      const open = trigger === except;
      trigger.setAttribute('aria-expanded', String(open));
      item?.classList.toggle('is-open', open);
      if (panel) panel.hidden = !open;
    });
  };
  triggers.forEach((trigger) => {
    const item = trigger.closest<HTMLElement>('[data-nav-item]');
    const panel = item?.querySelector<HTMLElement>('[data-nav-panel]');
    trigger.addEventListener('click', (event) => {
      if (!panel) return;
      event.preventDefault();
      closeMenus(trigger.getAttribute('aria-expanded') === 'true' ? undefined : trigger);
    });
    item?.addEventListener('pointerenter', () => closeMenus(trigger));
    item?.addEventListener('pointerleave', () => closeMenus());
    item?.addEventListener('focusin', () => closeMenus(trigger));
  });
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target as Element).closest('[data-nav-item]')) closeMenus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenus();
      document.querySelector<HTMLButtonElement>('#mobile-menu-toggle')?.focus();
    }
  });

  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const mobileClose = mobileMenu?.querySelector<HTMLButtonElement>('[data-mobile-close]');
  const mobileBackdrop = mobileMenu?.querySelector<HTMLButtonElement>('[data-mobile-backdrop]');
  const mobileSections = [...(mobileMenu?.querySelectorAll<HTMLDetailsElement>('.mobile-menu-section') ?? [])];
  mobileSections.forEach((section) => {
    section.addEventListener('toggle', () => {
      if (section.open) mobileSections.forEach((other) => { if (other !== section) other.open = false; });
    });
  });
  let previousBodyOverflow: string | undefined;
  if (button && mobileMenu) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      mobileMenu.hidden = !open;
      if (open) {
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        mobileClose?.focus();
      } else if (previousBodyOverflow !== undefined) {
        document.body.style.overflow = previousBodyOverflow;
        previousBodyOverflow = undefined;
      }
      if (restoreFocus) button.focus();
    };
    button.addEventListener('click', () => setOpen(mobileMenu.hidden));
    mobileClose?.addEventListener('click', () => setOpen(false, true));
    mobileBackdrop?.addEventListener('click', () => setOpen(false, true));
    mobileMenu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    mobileMenu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = [...mobileMenu.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),summary')]
        .filter((element) => !element.closest('[hidden]') && element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });
    document.addEventListener('pointerdown', (event) => {
      if (!mobileMenu.hidden && !mobileMenu.contains(event.target as Node) && !button.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileMenu.hidden) setOpen(false, true);
    });
    matchMedia('(min-width: 881px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
