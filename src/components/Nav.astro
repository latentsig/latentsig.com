---
import Logo from './Logo.astro';
import { CALENDLY_URL } from '../consts';

const path = Astro.url.pathname;

const links = [
  { href: '/rd-advisory/', label: 'R&D Advisory' },
  { href: '/implementation/', label: 'Implementation' },
  { href: '/consulting/', label: 'Consulting' },
  { href: '/insights/', label: 'Insights' },
  { href: '/about/', label: 'About' },
];
---

<nav aria-label="Main navigation" class="fixed w-full top-0 z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30">
  <div class="flex justify-between items-center max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop h-20">
    <a href="/" class="flex items-center text-on-surface hover:opacity-90 transition-opacity" aria-label="Latentsig home">
      <Logo height={72} class="hidden xl:block" />
      <Logo height={44} class="xl:hidden" />
    </a>
    <div class="hidden xl:flex items-center gap-gutter">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? "page" : undefined}
            class={`inline-flex items-center min-h-11 font-label-md text-label-md transition-colors duration-200 ${
              path === l.href
                ? 'text-primary'
                : 'text-on-surface-variant hover:text-primary'
            }`}
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <a
      href={CALENDLY_URL}
      target="_blank"
      rel="noopener"
      class="hidden sm:inline-flex bg-primary-container text-on-primary-container px-6 py-2.5 rounded-lg font-label-md text-label-md font-bold hover:brightness-110 transition-all"
    >
      Get a Consultation
    </a>
    <button id="mobile-menu-toggle" type="button" class="xl:hidden text-on-surface" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    </button>
  </div>
  <div id="mobile-menu" hidden class="xl:hidden hidden border-t border-outline-variant/30 bg-surface">
    <div class="flex flex-col px-margin-mobile py-4 gap-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? "page" : undefined}
            class={`font-label-md text-label-md py-2 ${
              path === l.href ? 'text-primary' : 'text-on-surface-variant'
            }`}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={CALENDLY_URL}
        target="_blank"
        rel="noopener"
        class="mt-2 bg-primary-container text-on-primary-container px-6 py-3 rounded-lg font-label-md text-label-md font-bold text-center"
      >
        Get a Consultation
      </a>
    </div>
  </div>
</nav>

<noscript><style>nav[aria-label="Main navigation"]{position:static}#mobile-menu{display:block!important}#mobile-menu-toggle{display:none}#main-content{padding-top:0}</style></noscript>
<style>
  #mobile-menu-toggle{min-width:44px;min-height:44px;align-items:center;justify-content:center}
  #mobile-menu{max-height:calc(100vh - 80px);max-height:calc(100dvh - 80px);overflow-y:auto;overscroll-behavior:contain}
  #mobile-menu a{display:flex;align-items:center;min-height:44px}
  @media(max-width:1279px){#mobile-menu-toggle{display:inline-flex}}
</style>
<script>
  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  if (button && menu) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      menu.hidden = !open; menu.classList.toggle('hidden', !open);
      if (restoreFocus) button.focus();
    };
    button.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', event => { if(event.key === 'Escape' && !menu.hidden) setOpen(false, true); });
    document.addEventListener('pointerdown', event => { if(!menu.hidden && !menu.contains(event.target as Node) && !button.contains(event.target as Node)) setOpen(false); });
    document.addEventListener('focusin', event => { if(!menu.hidden && !menu.contains(event.target as Node) && !button.contains(event.target as Node)) setOpen(false); });
    menu.addEventListener('click', event => { if((event.target as Element).closest('a')) setOpen(false); });
    matchMedia('(min-width: 1280px)').addEventListener('change', event => { if(event.matches) setOpen(false); });
  }
</script>
