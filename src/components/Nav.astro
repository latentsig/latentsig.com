---
import Logo from './Logo.astro';
import { CALENDLY_URL } from '../consts';

const path = Astro.url.pathname;
const products = [
  { label: 'Annotation & Verification Platform', href: '/products/annotation-verification/', detail: 'From raw data to reviewed, reliable datasets.', eyebrow: 'DATA QUALITY', childrenLabel: 'CONCEPT FLOW', children: [
    { label: 'Prepare Data', href: '/products/annotation-verification/#workflow-1' },
    { label: 'Annotate', href: '/products/annotation-verification/#workflow-2' },
    { label: 'Verify', href: '/products/annotation-verification/#workflow-3' },
  ] },
  { label: 'Agentic AI Platform', href: '/products/agentic-ai-platform/', detail: 'Explore agent workflows, orchestration, and evaluation.', eyebrow: 'AI WORKFLOWS', childrenLabel: 'CONCEPT AREAS', children: [
    { label: 'Agent Catalogue', href: '/products/agentic-ai-platform/#workflow-1' },
    { label: 'Workflow Harness', href: '/products/agentic-ai-platform/#workflow-2' },
    { label: 'Workflow Monitoring', href: '/products/agentic-ai-platform/#workflow-3' },
  ] },
];
const solutions = [
  { label: 'Websites & Web Applications', href: '/solutions/web-mobile-apps/', detail: 'Digital experiences designed for people and the work they need to do.' },
  { label: 'Mobile Applications', href: '/solutions/web-mobile-apps/#mobile', detail: 'Useful mobile products, from early concept through implementation.' },
  { label: 'Application Portfolio', href: '/solutions/web-mobile-apps/#portfolio', detail: 'Selected application work and capabilities.' },
  { label: 'Data Annotation & Quality', href: '/products/annotation-verification/', detail: 'Annotation and review workflows for dependable data.' },
  { label: 'AI Workflow Automation', href: '/products/agentic-ai-platform/', detail: 'Explore where agentic workflows can support real processes.' },
];
const services = [
  { label: 'AI R&D Advisory', href: '/rd-advisory/' },
  { label: 'AI Consulting', href: '/consulting/' },
  { label: 'AI Implementation', href: '/implementation/' },
  { label: 'Custom Web & Mobile Development', href: '/solutions/web-mobile-apps/' },
];
const about = [
  { label: 'Company', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Bengaluru Tech Summit 2026', href: '/bts-2026/' },
];
const groups = [
  { label: 'Products', id: 'products', href: '/products/', items: products },
  { label: 'Solutions', id: 'solutions', href: '/solutions/', items: solutions },
  { label: 'Services', id: 'services', href: '/services/', items: services },
  { label: 'About', id: 'about', href: '/about/', items: about },
];
const booking = `${CALENDLY_URL}?utm_source=latentsig_website&utm_campaign=product_demo`;
---

<header class="site-header" data-site-header>
  <nav aria-label="Main navigation" class="site-nav">
    <a href="/" class="brand" aria-label="LatentSig home"><Logo height={48} /></a>
    <div class="desktop-links">
      {groups.slice(0, 3).map((group) => (
        <div class="nav-group" data-nav-group={group.id}>
          <a class:list={['nav-link', path.startsWith('/products') && group.id === 'products' && 'is-current']} href={group.href} aria-current={path === group.href || (group.id === 'products' && path.startsWith('/products')) ? 'page' : undefined}>{group.label}</a>
          <button class="nav-disclosure" type="button" aria-label={`Toggle ${group.label} dropdown`} aria-expanded="false" aria-controls={`${group.id}-panel`} data-disclosure={group.id}><span aria-hidden="true">⌄</span></button>
        </div>
      ))}
      <a class:list={['nav-link', path.startsWith('/insights') && 'is-current']} href="/insights/" aria-current={path.startsWith('/insights') ? 'page' : undefined}>Insights</a>
      <div class="nav-group" data-nav-group="about">
        <a class="nav-link" href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
        <button class="nav-disclosure" type="button" aria-label="Toggle About dropdown" aria-expanded="false" aria-controls="about-panel" data-disclosure="about"><span aria-hidden="true">⌄</span></button>
      </div>
    </div>
    <a class="demo-cta" href={booking} target="_blank" rel="noopener noreferrer">Book a Demo <span aria-hidden="true">↗</span></a>
    <button id="mobile-menu-toggle" class="mobile-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle><span></span><span></span></button>
  </nav>

  <div class="mega-panel" id="products-panel" data-panel="products" hidden>
    <div class="mega-inner products-mega">
      <div class="product-feature-media"><div class="menu-annotation-art" aria-hidden="true"><div class="menu-art-toolbar"><b>DATASET · CONCEPT</b><i></i><i></i><i></i></div><div class="menu-art-body"><div class="menu-art-frame"><i></i><i></i><i></i><b>OBJECT A</b><b>OBJECT B</b></div><div class="menu-art-review"><b>REVIEW QUEUE</b><span><i></i>Example frame</span><span><i></i>Label check</span><span><i></i>Human review</span><small>SAMPLE WORKFLOW</small></div></div></div><div><small>ILLUSTRATIVE WORKFLOW · DATA QUALITY</small><b>Annotation &amp; Verification</b></div></div>
      <section class="product-discovery"><div class="product-intro"><span class="menu-eyebrow">Discover our products</span><h2>Tools for better data and practical AI workflows.</h2><p>Two product areas in development, with their current availability clearly described.</p></div>
        <div class="product-areas">{products.map((item) => <section class="mega-column product-menu-card"><span class="menu-eyebrow">{item.eyebrow}</span><a class="mega-item product-title" href={item.href}><span><b>{item.label}</b><small>{item.detail}</small></span><span class="item-arrow" aria-hidden="true">↗</span></a><div class="product-menu-actions"><a href={item.href}>Explore product <span aria-hidden="true">→</span></a><a href={item.href === products[0].href ? '/demos/#annotation-verification' : '/demos/#agentic-ai-platform'}>View demo <span aria-hidden="true">↗</span></a></div>{item.children && <div class="product-children"><span>{item.childrenLabel}</span>{item.children.map((child) => <a href={child.href}>{child.label}<span aria-hidden="true">↗</span></a>)}</div>}</section>)}</div>
        <a href="/products/" class="explore-all">Explore All Products <span aria-hidden="true">→</span></a>
      </section>
    </div>
  </div>
  {groups.filter((group) => group.id !== 'products').map((group) => (
    <div class="mega-panel compact-panel" id={`${group.id}-panel`} data-panel={group.id} hidden>
      <div class="mega-inner compact-inner"><div class:list={['compact-feature-media', `compact-${group.id}`]} aria-hidden="true">
        {group.id === 'solutions' && <div class="menu-solution-art"><div class="solution-browser"><i></i><i></i><i></i><div><b></b><b></b><b></b></div><span></span><span></span><span></span></div><div class="solution-mobile"><i></i><b></b><b></b><b></b></div></div>}
        {group.id === 'services' && <div class="menu-services-art"><small>FROM IDEA TO DELIVERY</small><div><span><b>01</b><i>Research</i></span><em></em><span><b>02</b><i>Design</i></span><em></em><span><b>03</b><i>Build</i></span></div><strong>One focused path forward</strong></div>}
        {group.id === 'about' && <div class="menu-about-art"><span class="orbit orbit-a"></span><span class="orbit orbit-b"></span><i class="orbit-core">LS</i><b>LATENTSIG</b><small>Research · Products · Applications</small></div>}
        <span class="menu-eyebrow">{group.id === 'solutions' ? 'DIGITAL APPLICATIONS · CONCEPT' : group.id === 'services' ? 'HOW WE WORK' : 'LATENTSIG'}</span>
      </div><div class="compact-content"><div><span class="menu-eyebrow">Discover</span><h2>{group.label}</h2></div><div class="compact-items">{group.items.map((item) => <a class="mega-item" href={item.href}><span><b>{item.label}</b>{item.detail && <small>{item.detail}</small>}</span><span class="item-arrow" aria-hidden="true">↗</span></a>)}</div></div></div>
    </div>
  ))}
  <div class="mobile-panel" id="mobile-menu" hidden data-mobile-panel>
    <div class="mobile-panel-inner">
      {groups.map((group) => <details><summary>{group.label}<span aria-hidden="true">＋</span></summary><div class="mobile-subnav">{group.id === 'products' && <a class="mobile-parent-link" href="/products/">Explore all products</a>}{group.items.map((item) => <div class="mobile-nav-group"><a href={item.href}>{item.label}</a>{group.id === 'products' && item.children?.map((child) => <a class="mobile-child" href={child.href}>↳ {child.label}</a>)}</div>)}</div></details>)}
      <a class="mobile-direct" href="/insights/">Insights</a><a class="mobile-book" href={booking} target="_blank" rel="noopener noreferrer">Book a Demo ↗</a>
    </div>
  </div>
</header>

<noscript><style>.desktop-links{display:flex!important}.mobile-toggle,.mega-panel{display:none!important}@media(max-width:900px){.desktop-links{display:none!important}.mobile-panel{display:block!important}}</style></noscript>

<style>
  .site-header{--ink:#f3f1ff;--muted:#aaa9c1;--line:rgba(190,186,227,.17);position:fixed;z-index:60;inset:0 0 auto;background:rgba(9,13,29,.97);border-bottom:1px solid var(--line);color:var(--ink);font-family:Geist,system-ui,sans-serif;backdrop-filter:blur(18px)}
  .site-nav{height:76px;max-width:1440px;margin:auto;padding:0 clamp(18px,4vw,64px);display:flex;align-items:center;gap:24px}.brand{display:flex;align-items:center;margin-right:auto;min-height:48px}.brand img{width:auto;max-height:44px;object-fit:contain}.desktop-links{height:100%;display:flex;align-items:center;gap:4px}.nav-group{height:100%;display:flex;align-items:center;position:relative}.nav-link,.nav-disclosure{min-height:44px;display:inline-flex;align-items:center;justify-content:center;color:#d8d6e8;text-decoration:none;transition:color .18s ease}.nav-link{padding:0 7px;font-size:14px;white-space:nowrap}.nav-link:hover,.nav-link.is-current,.nav-group[data-open="true"]>.nav-link{color:#c0c1ff}.nav-disclosure{width:29px;border:0;background:transparent;color:#a5a4bd;font-size:17px;cursor:pointer}.nav-disclosure span{display:none}.nav-disclosure:focus-visible{outline:2px solid #c0c1ff;outline-offset:-5px;border-radius:5px}.demo-cta,.mobile-book{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:0 18px;border-radius:8px;background:#c0c1ff;color:#17142f;text-decoration:none;font-weight:700;font-size:14px;white-space:nowrap}.demo-cta:hover,.mobile-book:hover{background:#dddeff}.mobile-toggle{display:none;width:46px;height:46px;align-items:center;justify-content:center;flex-direction:column;gap:6px;border:1px solid var(--line);border-radius:8px;background:transparent}.mobile-toggle span{width:19px;height:2px;background:var(--ink);transition:transform .2s ease}.mobile-toggle[aria-expanded="true"] span:first-child{transform:translateY(4px) rotate(45deg)}.mobile-toggle[aria-expanded="true"] span:last-child{transform:translateY(-4px) rotate(-45deg)}
  .mega-panel{position:absolute;top:100%;left:0;right:0;background:#f6f5fb;color:#201f34;border-bottom:1px solid #d8d6e7;box-shadow:0 24px 54px rgba(0,0,0,.32);animation:panel-in .18s ease-out both}.mega-panel[hidden],.mobile-panel[hidden]{display:none}@keyframes panel-in{from{opacity:0;transform:translateY(-7px)}to{opacity:1;transform:translateY(0)}}.mega-inner{max-width:1360px;margin:auto;padding:28px clamp(18px,4vw,54px) 20px}.products-mega{display:grid;grid-template-columns:1.1fr 1.1fr .84fr;gap:32px 40px}.featured-product{padding:18px;border-radius:12px;background:#eeedf6;border:1px solid #e1dfec}.concept-screen{height:164px;margin-bottom:18px;border-radius:8px;overflow:hidden;background:#11182a;color:#ebebff;border:1px solid #343a53;font-size:9px}.concept-toolbar{height:29px;display:flex;align-items:center;gap:5px;padding:0 10px;border-bottom:1px solid #343a53;color:#aaaec9;letter-spacing:.07em}.concept-toolbar i{width:6px;height:6px;border-radius:50%;background:#c0c1ff}.concept-toolbar i:nth-child(2){opacity:.6}.concept-toolbar i:nth-child(3){opacity:.35}.concept-toolbar span{margin-left:auto}.concept-body{display:flex;height:calc(100% - 29px)}.concept-sidebar{width:24%;border-right:1px solid #343a53;background:repeating-linear-gradient(0deg,transparent 0 17px,#424864 18px,transparent 19px);opacity:.6}.concept-content{padding:14px 16px;flex:1}.concept-content b{font-size:12px}.concept-row{height:24px;margin-top:10px;border-radius:3px;border:1px solid #6c6f9d;background:linear-gradient(90deg,#aeb0ff33 52%,transparent 52%)}.concept-row.short{width:82%;background:linear-gradient(90deg,#aeb0ff24 35%,transparent 35%)}.concept-label{margin-top:11px;color:#c0c1ff;letter-spacing:.12em}.concept-label span{padding:0 7px}.menu-eyebrow{display:block;margin-bottom:8px;color:#676789;font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.featured-product h2,.mega-column h2,.compact-inner h2{margin:0 0 8px;font-size:18px;line-height:1.25;color:#201f34}.featured-product p{margin:0;color:#5b5a70;font-size:13px;line-height:1.5}.featured-actions{display:flex;gap:18px;margin-top:14px}.featured-actions a,.explore-all{color:#4439a1;font-size:13px;font-weight:700;text-decoration:none}.featured-actions a:hover,.explore-all:hover{text-decoration:underline}.product-menu-card{padding:18px;border-radius:12px;background:linear-gradient(145deg,#fff,#eeedf6);border:1px solid #e1dfec}.product-title{min-height:82px;padding:4px 0;margin:0}.product-title b{font-size:17px}.product-children{display:grid;gap:0;padding-top:14px;border-top:1px solid #d8d6e7}.product-children>span{margin-bottom:7px;color:#73718a;font-size:9px;font-weight:700;letter-spacing:.13em}.product-children a{min-height:34px;display:flex;justify-content:space-between;align-items:center;color:#3a3853;text-decoration:none;font-size:12px}.product-children a:hover{color:#5147aa}.product-children a span{color:#7770be}.mega-column h2{margin-bottom:14px}.mega-item{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:58px;padding:9px 10px;margin:0 -10px;border-radius:7px;color:#25243b;text-decoration:none;transition:background .16s ease}.mega-item:hover,.mega-item:focus-visible{background:#e9e8f4}.mega-item b{display:block;font-size:13px;font-weight:650}.mega-item small{display:block;max-width:300px;margin-top:3px;color:#66657c;font-size:11px;line-height:1.4}.item-arrow{align-self:center;color:#6258b4}.explore-all{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:13px 5px 0;border-top:1px solid #dedce9}.compact-inner{display:grid;grid-template-columns:220px 1fr;gap:34px}.compact-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 28px}.mobile-panel{display:none}
  @media(max-width:1120px){.site-nav{gap:14px}.desktop-links{gap:0}.nav-link{padding:0 5px;font-size:13px}.demo-cta{padding:0 13px;font-size:13px}.products-mega{gap:24px}.mega-inner{padding-left:24px;padding-right:24px}}
  @media(max-width:900px){.site-nav{height:68px;padding:0 18px;gap:12px}.brand img{max-height:40px}.desktop-links{display:none}.demo-cta{margin-left:auto;min-height:44px}.mobile-toggle{display:flex}.mega-panel{display:none!important}.mobile-panel{display:block;position:absolute;inset:100% 0 auto;min-height:calc(100dvh - 68px);max-height:calc(100dvh - 68px);overflow-y:auto;background:#0e1428;border-bottom:1px solid var(--line);box-shadow:0 20px 40px rgba(0,0,0,.35)}.site-header:has(.mobile-toggle[aria-expanded="true"]) .demo-cta{visibility:hidden}.mobile-panel-inner{max-width:720px;margin:auto;padding:10px 20px 22px}.mobile-panel details,.mobile-direct{border-bottom:1px solid var(--line)}.mobile-panel summary,.mobile-direct{min-height:52px;display:flex;align-items:center;justify-content:space-between;color:#f1efff;text-decoration:none;list-style:none;cursor:pointer;font-weight:600}.mobile-panel summary::-webkit-details-marker{display:none}.mobile-panel details[open] summary span{transform:rotate(45deg)}.mobile-subnav{display:grid;padding:0 0 10px 10px}.mobile-subnav a,.mobile-parent-link{min-height:44px;display:flex;align-items:center;padding:6px 8px;color:#c4c2da;text-decoration:none;font-size:14px}.mobile-subnav a:hover,.mobile-direct:hover{color:#c0c1ff}.mobile-book{display:flex;margin-top:16px;min-height:48px}.site-header:has(.mobile-toggle[aria-expanded="true"]){background:#090d1d}}
  @media(max-width:420px){.site-nav{padding:0 12px;gap:8px}.brand img{max-width:118px}.demo-cta{min-height:44px;padding:0 10px;font-size:12px}.mobile-toggle{width:44px;height:44px}.mobile-panel-inner{padding-left:16px;padding-right:16px}}
  @media(prefers-reduced-motion:reduce){.site-header *{animation:none!important;transition:none!important}}
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
  const disclosures = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-disclosure]'));
  const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobilePanel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  let openId: string | null = null;
  let hoverTriggered = false;
  const closePanels = (restoreFocus = false) => {
    groups.forEach(group => group.dataset.open = 'false');
    disclosures.forEach(button => button.setAttribute('aria-expanded', 'false'));
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach(panel => panel.hidden = true);
    openId = null;
    if (mobilePanel) mobilePanel.hidden = true;
    mobileToggle?.setAttribute('aria-expanded', 'false');
    mobileToggle?.setAttribute('aria-label', 'Open navigation');
    if (restoreFocus) mobileToggle?.focus();
  };
  const openPanel = (id: string) => {
    closePanels();
    const group = groups.find(item => item.dataset.navGroup === id);
    const panel = document.querySelector<HTMLElement>(`[data-panel="${id}"]`);
    if (!group || !panel) return;
    openId = id;
    group.dataset.open = 'true';
    const button = group.querySelector<HTMLButtonElement>('[data-disclosure]');
    button?.setAttribute('aria-expanded', 'true');
    panel.hidden = false;
  };
  disclosures.forEach(button => {
    button.addEventListener('click', () => {
      if (hoverTriggered && openId === button.dataset.disclosure) { hoverTriggered = false; return; }
      hoverTriggered = false;
      openId === button.dataset.disclosure ? closePanels() : openPanel(button.dataset.disclosure || '');
    });
  });
  groups.forEach(group => group.addEventListener('pointerenter', event => {
    if (event.pointerType === 'mouse' && window.matchMedia('(min-width: 901px)').matches) {
      hoverTriggered = true;
      openPanel(group.dataset.navGroup || '');
    }
  }));
  groups.forEach(group => group.addEventListener('pointerleave', event => {
    if (event.pointerType !== 'mouse' || !window.matchMedia('(min-width: 901px)').matches) return;
    hoverTriggered = false;
    window.setTimeout(() => {
      if (!openId || !header?.matches(':hover')) { closePanels(); return; }
      const activeGroup = groups.find(item => item.dataset.navGroup === openId);
      const activePanel = document.querySelector<HTMLElement>(`[data-panel="${openId}"]`);
      if (!activeGroup?.matches(':hover') && !activePanel?.matches(':hover')) closePanels();
    }, 100);
  }));
  mobileToggle?.addEventListener('click', () => {
    const shouldOpen = mobileToggle.getAttribute('aria-expanded') !== 'true';
    closePanels();
    if (!shouldOpen || !mobilePanel) return;
    mobilePanel.hidden = false;
    mobileToggle.setAttribute('aria-expanded', 'true');
    mobileToggle.setAttribute('aria-label', 'Close navigation');
  });
  mobilePanel?.addEventListener('click', event => { if ((event.target as Element).closest('a')) closePanels(); });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && (openId || mobilePanel && !mobilePanel.hidden)) closePanels(true); });
  document.addEventListener('pointerdown', event => { if (header && !header.contains(event.target as Node)) closePanels(); });
  document.addEventListener('focusin', event => { if (openId && header && !header.contains(event.target as Node)) closePanels(); });
  document.querySelectorAll<HTMLAnchorElement>('.site-header a[href]').forEach(link => link.addEventListener('click', () => { if (link.target !== '_blank') closePanels(); }));
  window.matchMedia('(max-width: 900px)').addEventListener('change', () => closePanels());
</script>
