---
import Layout from '../layouts/Layout.astro';
import { CALENDLY_URL } from '../consts';

interface Props {
  title: string;
  slug: string;
  eyebrow: string;
  headline: string;
  summary: string;
  state: string;
  workflows: string[];
  useCases: string[];
  steps: string[];
  demo?: boolean;
}
const { title, slug, eyebrow, headline, summary, state, workflows, useCases, steps, demo = false } = Astro.props;
const booking = `${CALENDLY_URL}?utm_source=latentsig_website&utm_campaign=${slug.replaceAll('/', '-')}`;
---
<Layout title={`${title} · LatentSig`} description={summary}>
  <section class="product-hero">
    <div class="product-wrap">
      <div class="product-copy"><p class="product-eyebrow">{eyebrow}</p><h1>{headline}</h1><p class="product-summary">{summary}</p><span class="maturity"><i></i>{state}</span><div class="product-actions"><a class="action-primary" href={demo ? '/demos/' : '/demos/'}>{demo ? 'Explore demonstrations' : 'View Demo'}</a><a class="action-secondary" href={booking} target="_blank" rel="noopener noreferrer">Discuss this product ↗</a></div></div>
      <div class="product-visual" role="img" aria-label={`Concept illustration for ${title}`}><div class="visual-top"><span>LATENT SIG / PRODUCT CONCEPT</span><span>● ● ●</span></div><div class="visual-grid"><div class="visual-nav"><b>WORKSPACE</b><i></i><i></i><i></i><i></i></div><div class="visual-main"><div class="visual-heading"><span>Overview</span><small>CONCEPT UI</small></div><div class="visual-flow">{steps.map((step, index) => <div class="visual-step"><span>{String(index + 1).padStart(2, '0')}</span><b>{step}</b>{index < steps.length - 1 && <em aria-hidden="true">→</em>}</div>)}</div><div class="visual-lines"><i></i><i></i><i></i></div><p>Illustrative concept · No product availability implied</p></div></div></div>
    </div>
  </section>
  <section class="product-section" id="workflows"><div class="product-wrap"><p class="product-eyebrow">What it is designed to support</p><h2>Workflows &amp; capabilities</h2><div class="feature-grid">{workflows.map((item, i) => <article class="feature-card"><span>0{i + 1}</span><h3>{item}</h3><p>Concept direction for evaluation with prospective users. Detailed functionality and availability are not yet confirmed.</p></article>)}</div></div></section>
  <section class="product-section darker" id="workflow"><div class="product-wrap"><p class="product-eyebrow">A simple working model</p><h2>Start with the task. Shape the system around it.</h2><div class="steps-row">{steps.map((step, i) => <div class="process-step"><span>STEP 0{i + 1}</span><h3>{step}</h3>{i < steps.length - 1 && <b aria-hidden="true">→</b>}</div>)}</div><p class="availability-note">This is a product concept and discussion framework. No production deployment, integrations, or performance figures are claimed.</p></div></section>
  <section class="product-section"><div class="product-wrap use-case-wrap"><div><p class="product-eyebrow">Where it may fit</p><h2>Practical use cases</h2></div><div class="use-case-list">{useCases.map((item) => <p><span aria-hidden="true">↗</span>{item}</p>)}</div></div></section>
  <section class="product-bottom"><div class="product-wrap"><p class="product-eyebrow">Next step</p><h2>Bring us the workflow you want to improve.</h2><p>We can discuss the problem, evaluate feasibility, and agree what a useful demonstration would need to prove.</p><div class="product-actions"><a class="action-primary" href="/contact/">Talk to our team</a><a class="action-secondary" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer">Book a Demo ↗</a></div></div></section>
</Layout>

<style>
  .product-hero,.product-section,.product-bottom{background:#0b1020;color:#f2f0ff;font-family:Geist,system-ui,sans-serif}.product-hero{padding:88px 24px 76px;background:radial-gradient(ellipse at 82% 20%,#312a6a66,transparent 50%),#0b1020}.product-wrap{max-width:1240px;margin:auto}.product-hero .product-wrap{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:clamp(36px,6vw,90px);align-items:center}.product-copy h1{font:600 clamp(2.8rem,5.6vw,5.1rem)/1.02 'Hanken Grotesk',sans-serif;letter-spacing:-.045em;margin:0 0 22px;max-width:680px}.product-eyebrow{color:#c0c1ff;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin:0 0 17px}.product-summary{font-size:18px;line-height:1.7;color:#c2c1d6;max-width:590px}.maturity{display:inline-flex;gap:9px;align-items:center;margin-top:12px;padding:8px 11px;border:1px solid #45435c;border-radius:99px;color:#d9d7eb;font-size:12px}.maturity i{width:7px;height:7px;border-radius:50%;background:#efc77f}.product-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.action-primary,.action-secondary{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:0 18px;border-radius:7px;text-decoration:none;font-size:14px;font-weight:700}.action-primary{background:#c0c1ff;color:#17142f}.action-secondary{border:1px solid #4c4b69;color:#edecff}.product-visual{border:1px solid #44435c;border-radius:13px;overflow:hidden;min-height:330px;background:#11182a;box-shadow:0 25px 70px #0006}.visual-top{height:43px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;color:#aaa9c1;border-bottom:1px solid #343a53;font-size:10px;letter-spacing:.1em}.visual-grid{display:grid;grid-template-columns:140px 1fr;min-height:285px}.visual-nav{padding:20px 14px;border-right:1px solid #343a53;color:#777b9c;font-size:9px;letter-spacing:.1em}.visual-nav i{display:block;height:8px;margin-top:20px;border-radius:6px;background:#252d46}.visual-nav i:nth-child(3){background:#514b8b}.visual-nav i:nth-child(4){width:72%}.visual-nav i:nth-child(5){width:84%}.visual-main{padding:22px}.visual-heading{display:flex;justify-content:space-between;align-items:center;font-size:16px}.visual-heading small{font-size:9px;color:#9d9ac4}.visual-flow{display:flex;align-items:stretch;gap:8px;margin:34px 0 22px}.visual-step{position:relative;display:flex;flex-direction:column;justify-content:center;gap:14px;min-height:106px;flex:1;padding:12px;border-radius:8px;border:1px solid #555287;background:#191e34}.visual-step span{font-size:10px;color:#c0c1ff}.visual-step b{font-size:12px;line-height:1.35}.visual-step em{position:absolute;right:-11px;z-index:1;color:#c0c1ff;font-style:normal}.visual-lines i{display:block;width:92%;height:5px;margin:8px 0;border-radius:4px;background:#30364d}.visual-lines i:nth-child(2){width:78%}.visual-lines i:nth-child(3){width:86%}.visual-main>p{font-size:10px;color:#9291ad;margin:15px 0 0}.product-section{padding:82px 24px}.product-section h2,.product-bottom h2{font:600 clamp(2rem,3.5vw,3.2rem)/1.1 'Hanken Grotesk',sans-serif;letter-spacing:-.03em;margin:0 0 28px;max-width:800px}.feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.feature-card{min-height:210px;padding:24px;border:1px solid #343950;border-radius:11px;background:#11182a}.feature-card>span,.process-step>span{color:#c0c1ff;font-size:11px;letter-spacing:.1em}.feature-card h3,.process-step h3{font-size:19px;margin:24px 0 10px}.feature-card p,.availability-note,.product-bottom>div>p:not(.product-eyebrow){color:#aaa9c1;line-height:1.65;font-size:14px}.darker{background:#080c18;border-block:1px solid #24293b}.steps-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.process-step{position:relative;padding:22px;border-radius:9px;border:1px solid #343950;background:#0e1425}.process-step h3{margin-bottom:0}.process-step>b{position:absolute;right:-12px;top:50%;z-index:2;color:#c0c1ff}.availability-note{margin-top:25px}.use-case-wrap{display:grid;grid-template-columns:1fr 1.2fr;gap:40px}.use-case-list p{padding:17px 0;border-bottom:1px solid #35394b;margin:0;color:#dedced}.use-case-list span{color:#c0c1ff;margin-right:12px}.product-bottom{padding:74px 24px;background:radial-gradient(ellipse at 60% 100%,#3a327055,transparent 50%),#0c1020}.product-bottom>div>p:not(.product-eyebrow){max-width:680px;font-size:16px}.product-bottom .product-wrap{border:1px solid #373b55;border-radius:14px;padding:clamp(28px,5vw,60px);background:#101629}.product-bottom h2{margin-bottom:18px}
  @media(max-width:820px){.product-hero .product-wrap{grid-template-columns:1fr}.product-copy h1{font-size:clamp(2.7rem,9vw,4rem)}.product-visual{min-height:280px}.feature-grid{grid-template-columns:1fr 1fr}.steps-row{grid-template-columns:1fr}.process-step>b{right:20px;top:auto;bottom:-16px;transform:rotate(90deg)}.use-case-wrap{grid-template-columns:1fr;gap:12px}}
  @media(max-width:480px){.product-hero,.product-section,.product-bottom{padding-left:18px;padding-right:18px}.product-hero{padding-top:55px}.product-summary{font-size:16px}.product-visual{min-height:240px}.visual-grid{grid-template-columns:72px 1fr;min-height:225px}.visual-main{padding:14px 10px}.visual-nav{padding:14px 8px}.visual-flow{gap:4px;margin:23px 0 16px}.visual-step{padding:7px;min-height:95px}.visual-step b{font-size:10px}.visual-step em{right:-7px}.feature-grid{grid-template-columns:1fr}.feature-card{min-height:0}.product-actions a{flex:1 1 100%}}
</style>
