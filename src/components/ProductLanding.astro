---
import Layout from '../layouts/Layout.astro';
import { CALENDLY_URL } from '../consts';

interface Props {
  title: string;
  slug: string;
  eyebrow: string;
  headline: string;
  summary: string;
  state: string;
  workflows: string[];
  useCases: string[];
  steps: string[];
  demo?: boolean;
}
const { title, slug, eyebrow, headline, summary, state, workflows, useCases, steps, demo = false } = Astro.props;
const booking = `${CALENDLY_URL}?utm_source=latentsig_website&utm_campaign=${slug.replaceAll('/', '-')}`;
---
<Layout title={`${title} · LatentSig`} description={summary}>
  <section class="product-hero">
    <div class="product-wrap">
      <div class="product-copy"><p class="product-eyebrow">{eyebrow}</p><h1>{headline}</h1><p class="product-summary">{summary}</p><span class="maturity"><i></i>{state}</span><div class="product-actions"><a class="action-primary" href={demo ? '/demos/' : '/demos/'}>{demo ? 'Explore demonstrations' : 'View Demo'}</a><a class="action-secondary" href={booking} target="_blank" rel="noopener noreferrer">Discuss this product ↗</a></div></div>
      <figure class:list={['product-visual', slug.includes('annotation') ? 'annotation-visual' : slug.includes('agentic') ? 'agent-visual' : 'apps-visual']} aria-label={`Illustrative ${title} interface concept`}>
        {slug.includes('annotation') && <div class="concept-board annotation-board" aria-hidden="true"><div class="concept-toolbar"><span>DATASET · CONCEPT</span><i></i><i></i><i></i><b>SAMPLE DATA</b></div><div class="annotation-screen"><div class="scene-road"><i></i><i></i><i></i><b></b><b></b></div><aside><b>ANNOTATION QUEUE</b><span>Vehicle detection <i>Example</i></span><span>Road markings <i>Example</i></span><span>Scene review <i>Human</i></span><div class="review-state">ILLUSTRATIVE FLOW</div></aside></div><div class="concept-footer"><span>Example frame</span><div><i></i><i></i><i></i><i></i><i></i></div><b>VERIFY →</b></div></div>}
        {slug.includes('agentic') && <div class="concept-board agent-board" aria-hidden="true"><div class="concept-toolbar"><span>WORKFLOW TRACE · CONCEPT</span><i></i><i></i><i></i><b>EXAMPLE RUN</b></div><div class="trace-canvas"><div class="trace-request">REQUEST <b>Summarize a case</b></div><div class="trace-route"><span class="trace-node">PLAN</span><span class="trace-node">RETRIEVE</span><span class="trace-node">REVIEW</span></div><div class="trace-events"><span><i></i>Task routed</span><span><i></i>Example context</span><span><i></i>Human checkpoint</span></div><div class="trace-output"><b>EXAMPLE RESULT</b><i>✓</i></div></div></div>}
        {slug.includes('web-mobile') && <div class="concept-board app-board" aria-hidden="true"><div class="concept-toolbar"><span>PRODUCT CANVAS</span><i></i><i></i><i></i><b>RESPONSIVE</b></div><div class="product-canvas"><aside><b></b><i></i><i></i><i></i></aside><section><span>OVERVIEW</span><h3>Product workspace</h3><div class="canvas-metrics"><i></i><i></i><i></i></div><div class="canvas-chart"><b></b><b></b><b></b><b></b><b></b><b></b><b></b></div><div class="canvas-table"><i></i><i></i><i></i></div></section><div class="canvas-phone"><b></b><i></i><i></i><i></i></div></div></div>}
        <figcaption>Illustrative interface concept · not a live product screen</figcaption>
      </figure>
    </div>
  </section>
  <section class="product-section" id="workflows"><div class="product-wrap"><p class="product-eyebrow">What it is designed to support</p><h2>Workflows &amp; capabilities</h2><div class="feature-grid">{workflows.map((item, i) => <article class="feature-card" id={`workflow-${i + 1}`}><span>0{i + 1}</span><h3>{item}</h3><p>Concept direction for evaluation with prospective users. Detailed functionality and availability are not yet confirmed.</p></article>)}</div></div></section>
  <section class="product-section darker" id="workflow"><div class="product-wrap"><p class="product-eyebrow">A simple working model</p><h2>Start with the task. Shape the system around it.</h2><div class="steps-row">{steps.map((step, i) => <div class="process-step"><span>STEP 0{i + 1}</span><h3>{step}</h3>{i < steps.length - 1 && <b aria-hidden="true">→</b>}</div>)}</div><p class="availability-note">This is a product concept and discussion framework. No production deployment, integrations, or performance figures are claimed.</p></div></section>
  <section class="product-section"><div class="product-wrap use-case-wrap"><div><p class="product-eyebrow">Where it may fit</p><h2>Practical use cases</h2></div><div class="use-case-list">{useCases.map((item) => <p><span aria-hidden="true">↗</span>{item}</p>)}</div></div></section>
  <section class="product-bottom"><div class="product-wrap"><p class="product-eyebrow">Next step</p><h2>Bring us the workflow you want to improve.</h2><p>We can discuss the problem, evaluate feasibility, and agree what a useful demonstration would need to prove.</p><div class="product-actions"><a class="action-primary" href="/contact/">Talk to our team</a><a class="action-secondary" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer">Book a Demo ↗</a></div></div></section>
</Layout>

<style>
  .product-hero,.product-section,.product-bottom{background:#0b1020;color:#f2f0ff;font-family:Geist,system-ui,sans-serif}.product-hero{padding:88px 24px 76px;background:radial-gradient(ellipse at 82% 20%,#312a6a66,transparent 50%),#0b1020}.product-wrap{max-width:1240px;margin:auto}.product-hero .product-wrap{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:clamp(36px,6vw,90px);align-items:center}.product-copy h1{font:600 clamp(2.8rem,5.6vw,5.1rem)/1.02 'Hanken Grotesk',sans-serif;letter-spacing:-.045em;margin:0 0 22px;max-width:680px}.product-eyebrow{color:#c0c1ff;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin:0 0 17px}.product-summary{font-size:18px;line-height:1.7;color:#c2c1d6;max-width:590px}.maturity{display:inline-flex;gap:9px;align-items:center;margin-top:12px;padding:8px 11px;border:1px solid #45435c;border-radius:99px;color:#d9d7eb;font-size:12px}.maturity i{width:7px;height:7px;border-radius:50%;background:#efc77f}.product-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.action-primary,.action-secondary{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:0 18px;border-radius:7px;text-decoration:none;font-size:14px;font-weight:700}.action-primary{background:#c0c1ff;color:#17142f}.action-secondary{border:1px solid #4c4b69;color:#edecff}.product-visual{position:relative;margin:0;border:1px solid #e2dfd5;border-radius:22px;overflow:hidden;min-height:330px;background:#f1eee6;box-shadow:0 25px 70px #36332720}.product-photo{display:block;width:100%;height:430px;object-fit:cover}.product-visual figcaption{position:absolute;right:12px;bottom:12px;padding:8px 12px;border-radius:99px;background:#fffdf8e8;color:#52564b;font-size:11px}.product-section{padding:82px 24px}.product-section h2,.product-bottom h2{font:600 clamp(2rem,3.5vw,3.2rem)/1.1 'Hanken Grotesk',sans-serif;letter-spacing:-.03em;margin:0 0 28px;max-width:800px}.feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.feature-card{min-height:210px;padding:24px;border:1px solid #343950;border-radius:11px;background:#11182a}.feature-card>span,.process-step>span{color:#c0c1ff;font-size:11px;letter-spacing:.1em}.feature-card h3,.process-step h3{font-size:19px;margin:24px 0 10px}.feature-card p,.availability-note,.product-bottom>div>p:not(.product-eyebrow){color:#aaa9c1;line-height:1.65;font-size:14px}.darker{background:#080c18;border-block:1px solid #24293b}.steps-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.process-step{position:relative;padding:22px;border-radius:9px;border:1px solid #343950;background:#0e1425}.process-step h3{margin-bottom:0}.process-step>b{position:absolute;right:-12px;top:50%;z-index:2;color:#c0c1ff}.availability-note{margin-top:25px}.use-case-wrap{display:grid;grid-template-columns:1fr 1.2fr;gap:40px}.use-case-list p{padding:17px 0;border-bottom:1px solid #35394b;margin:0;color:#dedced}.use-case-list span{color:#c0c1ff;margin-right:12px}.product-bottom{padding:74px 24px;background:radial-gradient(ellipse at 60% 100%,#3a327055,transparent 50%),#0c1020}.product-bottom>div>p:not(.product-eyebrow){max-width:680px;font-size:16px}.product-bottom .product-wrap{border:1px solid #373b55;border-radius:14px;padding:clamp(28px,5vw,60px);background:#101629}.product-bottom h2{margin-bottom:18px}
  @media(max-width:820px){.product-hero .product-wrap{grid-template-columns:1fr}.product-copy h1{font-size:clamp(2.7rem,9vw,4rem)}.product-visual{min-height:280px}.feature-grid{grid-template-columns:1fr 1fr}.steps-row{grid-template-columns:1fr}.process-step>b{right:20px;top:auto;bottom:-16px;transform:rotate(90deg)}.use-case-wrap{grid-template-columns:1fr;gap:12px}}
  @media(max-width:480px){.product-hero,.product-section,.product-bottom{padding-left:18px;padding-right:18px}.product-hero{padding-top:55px}.product-summary{font-size:16px}.product-visual{min-height:240px}.visual-grid{grid-template-columns:72px 1fr;min-height:225px}.visual-main{padding:14px 10px}.visual-nav{padding:14px 8px}.visual-flow{gap:4px;margin:23px 0 16px}.visual-step{padding:7px;min-height:95px}.visual-step b{font-size:10px}.visual-step em{right:-7px}.feature-grid{grid-template-columns:1fr}.feature-card{min-height:0}.product-actions a{flex:1 1 100%}}
  .product-visual{display:grid;place-items:center;padding:16px;background:#182029!important;border-color:#343d43!important;border-radius:16px!important}.concept-board{width:100%;min-height:330px;overflow:hidden;border:1px solid #46515a;border-radius:10px;background:#202932;color:#e9ece8;font:11px/1.4 Geist,system-ui,sans-serif;box-shadow:0 18px 42px #14191d30}.concept-toolbar{height:44px;display:flex;align-items:center;gap:9px;padding:0 14px;border-bottom:1px solid #414b52;background:#252f37;color:#bfc9c5;font-size:8px;letter-spacing:.11em}.concept-toolbar>i{width:6px;height:6px;border-radius:50%;background:#828d8a}.concept-toolbar>i:first-of-type{margin-left:auto}.concept-toolbar>b{margin-left:8px;padding:5px 7px;border:1px solid #667357;border-radius:4px;color:#cad7b6;font-size:8px;font-weight:500}
  .annotation-screen{height:255px;display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:12px;padding:14px}.scene-road{position:relative;overflow:hidden;border:1px solid #45545b;border-radius:6px;background:linear-gradient(153deg,#536963 0 26%,#33464a 27% 51%,#25383e 52% 100%)}.scene-road:before{content:"";position:absolute;top:-20%;left:40%;width:20%;height:150%;transform:rotate(30deg);background:linear-gradient(90deg,#677375,#303d3e);border-inline:1px solid #b8ba9c80}.scene-road:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 47px,#cad0c122 48px 49px),repeating-linear-gradient(90deg,transparent 0 64px,#cad0c122 65px 66px)}.scene-road i,.scene-road b{position:absolute;z-index:1;width:28px;height:14px;border:1px solid #83c5a9;border-radius:3px;transform:rotate(30deg);box-shadow:0 0 0 4px #83c5a920}.scene-road i:nth-child(1){left:26%;top:25%}.scene-road i:nth-child(2){left:54%;top:55%;border-color:#b29bdf}.scene-road i:nth-child(3){left:39%;top:72%;width:37px}.scene-road b{left:13%;top:52%;width:8px;height:28px;border-color:#a2d6b2}.scene-road b:last-child{left:70%;top:25%;width:26px;height:13px}
  .annotation-screen>aside{display:grid;align-content:start;gap:11px;padding:12px;border:1px solid #414c52;border-radius:6px;background:#252f37;color:#b9c5c0;font-size:9px}.annotation-screen>aside>b{margin-bottom:3px;color:#d9e0dc;font-size:8px;letter-spacing:.1em}.annotation-screen>aside span{display:flex;justify-content:space-between;gap:5px;padding-bottom:8px;border-bottom:1px solid #ffffff15}.annotation-screen>aside span i{font-style:normal;color:#c7d7b2}.review-state{padding:7px 8px;border-radius:4px;background:#473f57;color:#e3d8ff;font-size:8px;letter-spacing:.08em}
  .concept-footer{height:40px;display:flex;align-items:center;gap:12px;padding:0 14px;border-top:1px solid #414b52;color:#aeb8b4;font-size:8px}.concept-footer div{display:flex;flex:1;gap:4px}.concept-footer div i{height:3px;flex:1;border-radius:4px;background:#596969}.concept-footer div i:nth-child(2),.concept-footer div i:nth-child(5){background:#9781c0}.concept-footer>b{color:#c9d8b8;font-size:8px}
  .trace-canvas{position:relative;min-height:284px;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto 1fr auto;align-items:center;gap:18px;padding:20px 24px;background:radial-gradient(ellipse at 50% 45%,#293741,#202932 70%)}.trace-request,.trace-output{display:flex;justify-content:space-between;align-items:center;gap:18px;max-width:240px;padding:12px 14px;border:1px solid #53606a;border-radius:6px;background:#2b363e;color:#aebbb7;font-size:8px;letter-spacing:.08em}.trace-request b,.trace-output b{color:#e2e8e3;font-size:9px;font-weight:500;letter-spacing:0}.trace-output{border-color:#607651;background:#2c382c}.trace-output i{color:#bad69c;font-size:13px;font-style:normal}.trace-route{grid-column:1/-1;grid-row:2;position:relative;display:flex;justify-content:space-around;gap:12px;padding:20px 0}.trace-route:before{content:"";position:absolute;left:10%;right:10%;top:50%;height:1px;background:linear-gradient(90deg,#738a5c,#9a84ca,#728b61)}.trace-node{z-index:1;display:grid;place-items:center;width:88px;height:54px;border:1px solid #736695;border-radius:7px;background:#2a2a38;color:#e0d9ee;font-size:8px;letter-spacing:.08em;animation:trace-pulse 3.3s ease-in-out infinite}.trace-node:nth-child(2){animation-delay:.55s}.trace-node:nth-child(3){animation-delay:1.1s}.trace-events{display:grid;grid-column:1;gap:8px;color:#aebbb7;font-size:9px}.trace-events span{display:flex;gap:8px;align-items:center}.trace-events i{width:6px;height:6px;border-radius:50%;background:#8da77b}.trace-events span:nth-child(2) i{background:#a895d1}.trace-events span:nth-child(3) i{background:#d0b078}
  .product-canvas{height:286px;display:grid;grid-template-columns:55px minmax(0,1fr) 74px;gap:12px;padding:17px;background:#e7e5dc;color:#34392f}.product-canvas>aside{display:grid;align-content:start;gap:10px;padding:11px 8px;border-radius:7px;background:#434d40}.product-canvas>aside b{width:20px;height:20px;margin:0 auto 8px;border-radius:5px;background:#c1cda9}.product-canvas>aside i{height:7px;border-radius:4px;background:#9da88b66}.product-canvas>section{padding:12px;border:1px solid #d3d2c8;border-radius:7px;background:#f8f7f1}.product-canvas>section>span{color:#788267;font-size:7px;letter-spacing:.12em}.product-canvas h3{margin:7px 0 12px;font-size:14px;font-weight:500}.canvas-metrics{display:flex;gap:7px}.canvas-metrics i{height:31px;flex:1;border:1px solid #e4e2d9;border-radius:4px;background:linear-gradient(#fff,#f0efe8)}.canvas-chart{height:75px;display:flex;align-items:end;gap:7px;margin-top:10px;padding:9px;border:1px solid #e0dfd5;border-radius:4px;background:#fff}.canvas-chart b{flex:1;height:43%;border-radius:3px 3px 0 0;background:#9ba888}.canvas-chart b:nth-child(2n){height:75%;background:#9c90ba}.canvas-chart b:nth-child(3n){height:59%;background:#c6a56f}.canvas-table{display:grid;gap:5px;margin-top:9px}.canvas-table i{height:4px;border-radius:4px;background:#dadbd3}.canvas-phone{display:grid;align-content:start;gap:9px;padding:9px 7px;border:2px solid #83887c;border-radius:12px;background:#faf9f4}.canvas-phone>b:first-child{width:15px;height:3px;margin:0 auto 6px;border-radius:4px;background:#bdc0b5}.canvas-phone i{height:32px;border-radius:4px;background:linear-gradient(140deg,#d5decf,#eee9df)}.canvas-phone i:nth-child(3){height:10px;background:#dadcd3}.canvas-phone i:nth-child(4){height:17px;background:#e4e1d7}
  @keyframes trace-pulse{0%,100%{transform:translateY(0);border-color:#736695;box-shadow:0 0 0 0 #a18cd000}50%{transform:translateY(-3px);border-color:#b6a5d9;box-shadow:0 0 0 4px #a18cd01e}}
  .product-visual figcaption{right:25px;bottom:25px;background:#fbfaf3e8;color:#4c5147}
  @media(max-width:480px){.product-visual{padding:9px}.concept-board{min-height:270px}.concept-toolbar{gap:6px;padding:0 9px;font-size:7px}.annotation-screen{height:210px;grid-template-columns:minmax(0,1fr) 125px;padding:9px;gap:7px}.annotation-screen>aside{padding:8px;gap:8px;font-size:8px}.trace-canvas{min-height:235px;padding:14px 10px}.trace-node{width:64px;height:46px;font-size:7px}.trace-request,.trace-output{gap:6px;padding:9px;font-size:7px}.product-canvas{height:236px;grid-template-columns:38px minmax(0,1fr) 56px;gap:7px;padding:9px}.product-canvas>section{padding:9px}.product-canvas h3{font-size:12px}.canvas-chart{height:60px}.product-visual figcaption{right:17px;bottom:17px;font-size:9px}}
  @media(prefers-reduced-motion:reduce){.trace-node{animation:none}}
</style>
