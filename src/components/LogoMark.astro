---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<span
  class:list={['latentsig-mark', className]}
  style={`--mark-size:${size}px`}
  aria-hidden="true"
>
  <img src="/latentsig-waveform-mark.png" alt="" width="700" height="400" />
</span>

<style>
  .latentsig-mark{display:inline-grid;place-items:center;flex:none;width:var(--mark-size);height:var(--mark-size);overflow:hidden;border-radius:50%;background:#080c2b}
  .latentsig-mark img{display:block;width:88%;height:auto;max-width:none;object-fit:contain}
</style>
