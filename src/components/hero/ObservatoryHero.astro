---
import { CALENDLY_URL } from '../../consts';
const stories = [
  { eyebrow: 'RESEARCH · AI PRODUCTS · DIGITAL APPLICATIONS', title: 'Practical AI', accent: 'for real work.', text: 'From annotation and dataset verification to agent workflows and digital applications, we build systems around the task at hand.', cue: 'EXPLORE OUR PRODUCTS AND SOLUTIONS' },
];
---
<section class="observatory-hero" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="hero-accessible-title">Practical AI for real work.</h1>
  <div class="hero-visual">
    <div class="hero-scene">
      <svg class="hero-workflow-art" viewBox="0 0 820 620" role="img" aria-labelledby="hero-art-title hero-art-description">
        <title id="hero-art-title">LatentSig workflow overview</title><desc id="hero-art-description">A data input moves through annotation, agent coordination, and application delivery into a reviewed outcome.</desc>
        <defs><linearGradient id="flow-line" x1="0" x2="1"><stop stop-color="#79865b"/><stop offset=".52" stop-color="#8771b7"/><stop offset="1" stop-color="#7b9871"/></linearGradient><filter id="soft-glow"><feGaussianBlur stdDeviation="6" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
        <g class="art-grid" opacity=".38"><path d="M0 80H820M0 160H820M0 240H820M0 320H820M0 400H820M0 480H820M0 560H820M80 0V620M160 0V620M240 0V620M320 0V620M400 0V620M480 0V620M560 0V620M640 0V620M720 0V620"/></g>
        <path class="art-route" d="M125 310H263M263 310C310 310 304 180 370 180M263 310C310 310 304 310 370 310M263 310C310 310 304 440 370 440M455 180C518 180 510 310 565 310M455 310H565M455 440C518 440 510 310 565 310M565 310H704"/>
        <g class="art-input"><rect x="45" y="248" width="142" height="124" rx="16"/><text x="64" y="278">INPUT</text><path d="M67 302h78M67 318h57M67 340h94"/><circle cx="157" cy="318" r="9"/></g>
        <g class="art-node art-node-1"><rect x="335" y="139" width="152" height="82" rx="14"/><circle cx="358" cy="164" r="7"/><text x="375" y="168">ANNOTATE</text><path d="M357 190h103"/></g>
        <g class="art-node art-node-2"><rect x="335" y="269" width="152" height="82" rx="14"/><circle cx="358" cy="294" r="7"/><text x="375" y="298">COORDINATE</text><path d="M357 320h103"/></g>
        <g class="art-node art-node-3"><rect x="335" y="399" width="152" height="82" rx="14"/><circle cx="358" cy="424" r="7"/><text x="375" y="428">DELIVER</text><path d="M357 450h103"/></g>
        <g class="art-output"><rect x="628" y="254" width="154" height="112" rx="16"/><text x="651" y="285">REVIEWED</text><text x="651" y="305">OUTCOME</text><circle cx="671" cy="337" r="13"/><path d="m665 337 5 5 9-10"/></g>
        <circle class="art-packet" r="7" fill="#fff" filter="url(#soft-glow)"><animateMotion dur="5.5s" repeatCount="indefinite" path="M125 310H263M263 310C310 310 304 180 370 180M455 180C518 180 510 310 565 310M565 310H704"/></circle>
      </svg>
    </div>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="sr-only hero-text-alternative">
        <p>{stories[0].text}</p>
        {stories.slice(1).map(story => <section><h2>{story.title} {story.accent}</h2><p>{story.text}</p></section>)}
      </div>
      <div class="hero-stories" aria-hidden="true">
        {stories.map((story, i) => <div class="hero-story" data-story={i} style={i === 0 ? '' : 'opacity:0;visibility:hidden'}>
          <p class="hero-eyebrow"><span></span>{story.eyebrow}</p>
          <h2><span>{story.title}</span>{' '}<span class="hero-title-accent">{story.accent}</span>{' '}{story.end && <span>{story.end}</span>}</h2>
          <p class="hero-description">{story.text}</p>
          <p class="hero-cue">{story.cue}</p>
        </div>)}
      </div>
      <div class="hero-actions">
        <a href="/products/" class="hero-primary">Explore Products <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
        <a href={`${CALENDLY_URL}?utm_source=latentsig_website&utm_campaign=homepage_demo`} target="_blank" rel="noopener noreferrer" class="hero-secondary">Book a Demo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-category-line" aria-label="Our focus areas"><span>Annotation &amp; verification</span><i></i><span>Agentic AI</span><i></i><span>Web &amp; mobile</span></div>
  </div>
</section>
<style>
  .observatory-hero{--hero-bg:#f7f4ec;--hero-ink:#262821;--hero-muted:#5d6256;--hero-accent:#67784d;position:relative;isolation:isolate;overflow:hidden;background:var(--hero-bg);min-height:clamp(700px,calc(100svh - 80px),850px)}
  .hero-accessible-title{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .hero-visual{z-index:0;position:absolute;inset:0 43% 0 0;background:#ebe8df}
  .hero-scene{display:block;position:absolute;inset:0;width:100%;height:100%}
  .hero-workflow-art{position:absolute;inset:0;width:100%;height:100%;padding:clamp(18px,4vw,56px);box-sizing:border-box;background:radial-gradient(ellipse at 50% 50%,#e8e5db 0,#efede5 48%,#f1efe8 100%)}.art-grid path{fill:none;stroke:#68734c;stroke-width:.6;opacity:.24}.hero-workflow-art text{font:600 10px/1 Geist,system-ui,sans-serif;letter-spacing:1.2px;fill:#48513c}.art-route{fill:none;stroke:url(#flow-line);stroke-width:2;stroke-dasharray:6 8;animation:route-flow 7s linear infinite}.art-input rect,.art-node rect,.art-output rect{fill:#fffdf8;stroke:#dad8ce;stroke-width:1.4}.art-input path,.art-node path{stroke:#a6aa9c;stroke-width:2;stroke-linecap:round}.art-input circle{fill:#79865b}.art-node circle{fill:#8977b3}.art-output circle{fill:#7b9871}.art-output path{fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.art-node{animation:node-lift 5.5s ease-in-out infinite}.art-node-2{animation-delay:.45s}.art-node-3{animation-delay:.9s}.art-packet{opacity:.9}@keyframes route-flow{to{stroke-dashoffset:-56}}@keyframes node-lift{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
  .hero-anatomy{position:absolute;inset:0;pointer-events:none;z-index:2}.hero-anatomy>span{position:absolute;top:0;left:0;opacity:0;visibility:hidden;padding:5px 10px;margin-left:20px;background:#0b1326dc;border:1px solid #a6acdf66;border-radius:3px;color:#dae2fd;font:500 11px/1.3 Geist,sans-serif;letter-spacing:.03em}.hero-anatomy>span::before{content:"";position:absolute;right:100%;top:50%;width:20px;border-top:1px solid #a6acdf88}.hero-scene[data-state="poster"] .hero-anatomy,.hero-scene[data-state="fallback"] .hero-anatomy{display:none}
  .hero-shade{z-index:1;position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,transparent 30%,#f7f4ec55 43%,#f7f4ec 58%)}
  .hero-inner{z-index:2;position:relative;max-width:1280px;padding:60px 64px 140px;margin:0 auto;min-height:inherit;height:auto;display:flex;flex-direction:column;justify-content:center;pointer-events:none}
  .hero-copy{width:530px;max-width:45%;margin:0 0 0 auto;padding-left:32px}
  .hero-stories{display:grid;align-items:center;min-height:350px}
  .hero-story{grid-area:1/1;will-change:opacity}
  .hero-eyebrow{display:flex;align-items:center;gap:10px;margin:0 0 25px;color:var(--hero-accent);font:550 11px/1.5 Geist,sans-serif;letter-spacing:.12em}
  .hero-eyebrow>span{width:5px;height:5px;border-radius:50%;background:#a8aaff}
  h2{margin:0 0 24px;color:var(--hero-ink);font-family:'Hanken Grotesk',sans-serif;font-size:clamp(2.7rem,3.7vw,3.65rem);font-weight:500;line-height:1.08;letter-spacing:-.035em}h2>span{display:block}.hero-title-accent{color:var(--hero-accent)}
  .hero-description{max-width:455px;margin:0;color:var(--hero-muted);font:400 16px/1.75 Geist,sans-serif}
  .hero-cue{font:500 10px/1.6 Geist,sans-serif;letter-spacing:.12em;color:#747c68;margin:24px 0 0}
  .hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:27px;pointer-events:auto}
  .hero-actions>a{display:inline-flex;align-items:center;gap:17px;min-height:48px;padding:0 20px;border-radius:5px;font:550 14px/1.3 Geist,sans-serif;transition:background .2s,color .2s,border-color .2s}
  .hero-primary{background:#6d7b50;color:#fffdf8;border:1px solid #6d7b50}.hero-primary:hover{background:#596742;border-color:#596742}.hero-secondary{color:#30332b;border:1px solid #a8aa9e;background:#f7f4ecaa}.hero-secondary:hover{background:#fff;border-color:#747c68}.hero-secondary>span{font-size:20px;font-weight:400}
  .hero-actions>a:focus-visible,.hero-motion:focus-visible{outline:2px solid #dae2fd;outline-offset:5px}
  .hero-motion{pointer-events:auto;position:absolute;right:32px;bottom:120px;z-index:4;background:#fffdf8db;border:1px solid #dedbd1;border-radius:999px;min-height:44px;min-width:44px;color:#34372f;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 14px;cursor:pointer}.hero-motion[hidden]{display:none}.hero-motion:hover{background:#fff}.motion-label{font:400 12px/1.2 Geist,sans-serif;white-space:nowrap;opacity:1;transition:max-width .2s,opacity .2s}.hero-motion:hover .motion-label,.hero-motion:focus-visible .motion-label{max-width:110px;opacity:1}.resume-symbol{display:none}.hero-motion[data-paused="true"] .pause-symbol{display:none}.hero-motion[data-paused="true"] .resume-symbol{display:block}
  .hero-process{position:absolute;bottom:30px;left:64px;right:64px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;font-family:Geist,sans-serif;color:#787b70}
  .hero-process>span{min-width:0;overflow-wrap:anywhere;position:relative;padding:14px 0 0;border-top:1px solid #77796b4d;display:grid;gap:4px}.hero-process b{font-size:13px;font-weight:500}.hero-process small{font-size:11px}.hero-process i{position:absolute;top:-1px;height:2px;left:0;width:0;background:#6d7b50;transition:width .9s}.hero-process [data-active="true"]{color:#363a30}.hero-process [data-active="true"] i{width:100%}
  .hero-category-line{position:absolute;z-index:3;right:64px;bottom:42px;display:flex;align-items:center;gap:16px;color:#5e6454;font:500 11px/1.5 Geist,sans-serif;letter-spacing:.03em}.hero-category-line i{width:4px;height:4px;background:#89976e;border-radius:50%}
  @media(max-width:1100px) and (min-width:901px){.hero-inner{padding-left:36px;padding-right:36px}.hero-copy{max-width:48%;padding-left:24px}h2{font-size:clamp(2.5rem,4.1vw,3.1rem)}.hero-description{font-size:15px}.hero-category-line{right:36px;gap:10px}.hero-actions>a{font-size:13px;padding:0 14px}}
  @media(max-width:900px){
    .hero-workflow-art text{font-size:16px;letter-spacing:.7px}
    .observatory-hero{min-height:0;display:grid;grid-template-areas:"copy" "scene" "categories";grid-template-columns:minmax(0,1fr)}
    .hero-inner{display:contents}.hero-copy{grid-area:copy;max-width:none;width:auto;margin:0;padding:38px 24px 30px;z-index:2}
    .hero-stories{min-height:0;align-items:start}.hero-eyebrow{font-size:.625rem;letter-spacing:.07em;margin-bottom:21px}
    h2{font-size:clamp(2.4rem,9.5vw,3.625rem);line-height:1.06;margin-bottom:20px;overflow-wrap:anywhere}
    .hero-description{font-size:1rem;line-height:1.65;max-width:520px}.hero-cue{font-size:.625rem;margin-top:18px}
    .hero-actions{margin-top:24px;gap:10px}.hero-actions>a{font-size:.8125rem;padding:0 15px;min-height:44px;gap:12px}
    .hero-visual{position:relative;grid-area:scene;inset:auto;height:clamp(300px,83vw,460px);width:100%;min-width:0}
    .hero-shade{display:none}
    .hero-category-line{position:relative;right:auto;bottom:auto;grid-area:categories;margin:0 24px 26px;flex-wrap:wrap;gap:9px 12px}
    .hero-motion{position:relative;grid-area:controls;right:auto;bottom:auto;justify-self:start;margin:16px 24px 0;padding:8px 12px}
    .hero-workflow-art{padding:12px}
  }
  @media(max-width:480px){.hero-process{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(forced-colors:active){.hero-stories,.hero-actions,.hero-motion{forced-color-adjust:auto}.hero-shade,.hero-visual{display:none}.hero-motion{display:none}.hero-actions>a{border:1px solid ButtonText}}
  @media(prefers-reduced-motion:reduce){.art-route,.art-node{animation:none}.art-packet{display:none}.hero-actions>a{transition:none}}
</style>
