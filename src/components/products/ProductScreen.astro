---
interface Props {
  kind: 'agentic' | 'annotation';
}

const { kind } = Astro.props;
const agentic = kind === 'agentic';
---

<div class:list={['product-screen', kind]} aria-label={`${agentic ? 'Agentic AI Studio' : 'Annotation & Verification Platform'} illustrative interface preview`}>
  <div class="screen-topline">
    <div class="screen-brand"><span class="screen-mark">∿</span><strong>latentsig</strong><span class="screen-divider">/</span><span>{agentic ? 'Agentic AI Studio' : 'Annotation & Verification Platform'}</span></div>
    <span class="sample-tag">Illustrative preview · sample data</span>
  </div>
  <div class="screen-body">
    <div class="screen-side" aria-hidden="true">
      <span class="side-label">WORKSPACE</span>
      <span class="side-item active">{agentic ? '◈  Workflows' : '▤  Datasets'}</span>
      <span class="side-item">{agentic ? '▤  Runs' : '☷  Annotation'}</span>
      <span class="side-item">{agentic ? '◎  Reviews' : '◎  Review'}</span>
      <span class="side-item">{agentic ? '▧  Evidence' : '▧  Exports'}</span>
      <span class="side-foot">SAMPLE WORKSPACE</span>
    </div>
    {agentic ? (
      <div class="screen-main">
        <div class="screen-heading"><div><span class="eyebrow">WORKFLOW  /  RUN 04</span><h3>Release evidence review</h3><p>Compare two policy drafts and prepare a cited summary.</p></div><span class="status">● Review ready</span></div>
        <div class="request-strip"><span>INPUT</span><strong>“What changed between the April and May policy drafts?”</strong></div>
        <div class="flow-diagram" aria-label="Planner to document reader to comparison to evidence check to human review">
          <div><span class="node-icon">01</span><strong>Planner</strong><small>Sets the steps</small></div>
          <i>→</i><div><span class="node-icon">02</span><strong>Document reader</strong><small>Extracts passages</small></div>
          <i>→</i><div class="node-active"><span class="node-icon">03</span><strong>Comparison</strong><small>Finds changes</small></div>
          <i>→</i><div><span class="node-icon">04</span><strong>Review</strong><small>Human decision</small></div>
        </div>
        <div class="screen-lower"><div class="result-card"><span class="eyebrow">DRAFT OUTPUT</span><strong>Two clauses changed</strong><p>Access reviews move from quarterly to monthly; exception owners must now be named.</p></div><div class="source-card"><span class="eyebrow">EVIDENCE</span><span>April draft · §2.1</span><span>May draft · §2.1, §4.3</span><b>2 linked sources</b></div></div>
      </div>
    ) : (
      <div class="screen-main">
        <div class="screen-heading"><div><span class="eyebrow">DATASET  /  REVIEW QUEUE</span><h3>Support request labels</h3><p>Two independent annotations, one reviewer decision.</p></div><span class="status">● 1 conflict</span></div>
        <div class="dataset-meta"><span><strong>3</strong> sample records</span><span><strong>2</strong> annotators</span><span><strong>1</strong> item to review</span></div>
        <div class="table-wrap"><table><thead><tr><th>RECORD</th><th>ANNOTATOR A</th><th>ANNOTATOR B</th><th>STATUS</th></tr></thead><tbody><tr><td><b>#R-101</b><small>Update billing address</small></td><td>Billing</td><td>Billing</td><td><span class="table-ok">Agreed</span></td></tr><tr class="conflict-row"><td><b>#R-102</b><small>Can’t access invoice</small></td><td>Access</td><td>Billing</td><td><span class="table-alert">Disagreement</span></td></tr><tr><td><b>#R-103</b><small>Download receipt</small></td><td>Billing</td><td>Billing</td><td><span class="table-ok">Agreed</span></td></tr></tbody></table></div>
        <div class="review-strip"><div><span class="eyebrow">REVIEWER DECISION</span><strong>#R-102 → Billing</strong><small>“Invoice” makes the billing queue the better fit in this sample.</small></div><span class="approved">✓ Approved for export</span></div>
      </div>
    )}
  </div>
</div>

<style>
  .product-screen{width:100%;min-width:0;overflow:hidden;border:1px solid #343e59;border-radius:18px;background:#0d1528;color:#e9edff;box-shadow:0 30px 65px rgba(0,0,0,.22);font-family:Geist,system-ui,sans-serif;text-align:left}
  .screen-topline{min-height:54px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 18px;border-bottom:1px solid #303a53;background:#101b30}
  .screen-brand{min-width:0;display:flex;align-items:center;gap:8px;color:#dfe4fb;font-size:12px;white-space:nowrap}.screen-brand strong{font-size:14px;letter-spacing:-.045em}.screen-mark{display:grid;place-items:center;width:25px;height:25px;border-radius:7px;color:#b9b9ff;background:#202b53;font-size:22px;line-height:1}.screen-divider{color:#5e6986}
  .sample-tag{flex:none;padding:6px 9px;border:1px solid #485374;border-radius:999px;color:#c3caff;font:600 10px/1 Geist,sans-serif;letter-spacing:.035em}
  .screen-body{display:grid;grid-template-columns:160px minmax(0,1fr);min-height:390px}.screen-side{display:flex;flex-direction:column;gap:5px;padding:22px 10px;background:#111c31;border-right:1px solid #303a53}.side-label,.side-foot{padding:0 10px;color:#8b96b5;font-size:9px;font-weight:700;letter-spacing:.11em}.side-label{margin-bottom:12px}.side-foot{margin-top:auto}.side-item{padding:9px 10px;border-radius:8px;color:#aab4d0;font-size:11px;white-space:nowrap}.side-item.active{background:#2b3156;color:#e6e8ff;font-weight:700}
  .screen-main{min-width:0;padding:22px 24px 26px;background:radial-gradient(circle at 90% 5%,rgba(119,124,224,.1),transparent 42%),#0d1528}.screen-heading{display:flex;align-items:start;justify-content:space-between;gap:16px}.eyebrow{color:#aeb2ed;font-size:9px;font-weight:700;letter-spacing:.11em}.screen-heading h3{margin:8px 0 4px;color:#f0f2ff;font-size:20px;font-weight:650;letter-spacing:-.035em}.screen-heading p{margin:0;color:#aeb8d0;font-size:11px;line-height:1.5}.status{flex:none;border:1px solid #456b6e;border-radius:999px;padding:6px 9px;color:#a7e0d2;font-size:10px;white-space:nowrap}
  .request-strip{display:flex;align-items:center;gap:18px;margin-top:24px;padding:13px 16px;border:1px solid #35415d;border-radius:9px;background:#17223a}.request-strip span{color:#a7acd7;font-size:9px;font-weight:700;letter-spacing:.1em}.request-strip strong{font-size:12px;font-weight:550}
  .flow-diagram{display:flex;align-items:stretch;gap:8px;margin-top:20px}.flow-diagram>div{min-width:0;flex:1;display:flex;flex-direction:column;gap:5px;padding:13px 10px;border:1px solid #36415e;border-radius:9px;background:#172138}.flow-diagram>i{display:grid;place-items:center;align-self:center;color:#828eb4;font-size:15px;font-style:normal}.flow-diagram .node-active{border-color:#a9aaff;background:#262a55}.node-icon{display:grid;place-items:center;width:24px;height:24px;border-radius:6px;color:#c5c7ff;background:#303b66;font-size:9px;font-weight:700}.flow-diagram strong{font-size:10px;line-height:1.3}.flow-diagram small{color:#a4aec9;font-size:9px;line-height:1.2}
  .screen-lower{display:grid;grid-template-columns:1.4fr 1fr;gap:12px;margin-top:18px}.result-card,.source-card{min-width:0;display:flex;flex-direction:column;gap:6px;padding:14px 15px;border:1px solid #35415b;border-radius:10px;background:#131e33}.result-card strong{font-size:13px}.result-card p{margin:0;color:#acb6cd;font-size:10px;line-height:1.45}.source-card>span:not(.eyebrow){color:#c8d0e6;font-size:10px}.source-card b{margin-top:auto;color:#a8d7ed;font-size:9px}
  .dataset-meta{display:flex;gap:8px;margin:22px 0 13px}.dataset-meta>span{flex:1;padding:10px;border:1px solid #35415b;border-radius:8px;background:#172138;color:#b7c0d7;font-size:10px;white-space:nowrap}.dataset-meta strong{color:#edf0ff;font-size:17px;margin-right:4px}
  .table-wrap{overflow-x:auto;border:1px solid #35415b;border-radius:9px}.table-wrap table{width:100%;min-width:500px;border-collapse:collapse;font-size:10px}.table-wrap th{padding:11px 12px;background:#19243c;color:#9faaca;text-align:left;font-size:8px;letter-spacing:.08em}.table-wrap td{padding:11px 12px;border-top:1px solid #303b54;color:#d6ddf0}.table-wrap td:first-child{display:flex;flex-direction:column;gap:3px}.table-wrap td small{color:#9eaac5;font-size:9px}.conflict-row{background:#2b2440}.table-ok,.table-alert{display:inline-block;padding:5px 7px;border-radius:5px;white-space:nowrap}.table-ok{background:#1d3b3b;color:#a9e6d6}.table-alert{background:#49314c;color:#ffcad9}
  .review-strip{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:13px;padding:12px 14px;border:1px solid #4a4d76;border-radius:9px;background:#242946}.review-strip>div{display:flex;flex-direction:column;gap:4px}.review-strip strong{font-size:11px}.review-strip small{color:#b5bdd7;font-size:9px;line-height:1.4}.approved{flex:none;color:#aad9cc;font-size:9px;font-weight:700;white-space:nowrap}
  @media(max-width:760px){.screen-side{display:none}.screen-body{grid-template-columns:minmax(0,1fr)}.screen-main{padding:18px}.screen-topline{padding:9px 12px}.screen-brand{font-size:10px}.sample-tag{font-size:8px}.flow-diagram{gap:4px}.flow-diagram>div{padding:9px 6px}.flow-diagram>i{font-size:11px}.flow-diagram strong{font-size:9px}.flow-diagram small{font-size:8px}}
  @media(max-width:480px){.screen-topline{align-items:start}.screen-brand{gap:5px}.screen-brand>span:last-child{max-width:135px;overflow:hidden;text-overflow:ellipsis}.sample-tag{max-width:96px;white-space:normal;line-height:1.2;text-align:center}.screen-heading{display:block}.status{display:inline-block;margin-top:10px}.request-strip{display:block}.request-strip strong{display:block;margin-top:5px}.flow-diagram{flex-wrap:wrap}.flow-diagram>div{flex-basis:42%}.flow-diagram>i{display:none}.screen-lower{grid-template-columns:1fr}.dataset-meta{flex-wrap:wrap}.dataset-meta>span{min-width:90px}.review-strip{align-items:start;flex-direction:column}.approved{white-space:normal}}
</style>
