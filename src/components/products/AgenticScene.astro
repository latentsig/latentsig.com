<section class="agent-workspace" data-agent-workspace data-execution-state="idle" data-evaluation-mode="llm" data-inspector-open="false" aria-label="Interactive Agentic AI Studio demonstration">
  <header class="workspace-head">
    <div class="studio-mark"><span class="studio-symbol" aria-hidden="true">✳</span><div><span class="workspace-kicker">AGENTIC AI STUDIO</span><h3>AI workspace</h3></div></div>
    <span class="run-state" data-run-state aria-live="polite">Ready to run</span>
    <button class="workspace-expand" type="button" data-open-dialog aria-label="Enter fullscreen">⤢</button>
  </header>

  <div class="orchestration-canvas" aria-label="Visual workflow from medical scan review through three parallel agents, evaluation and approval to a verified result">
    <div class="scene-atmosphere" aria-hidden="true"></div>
    <svg class="connections" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="agent-signal" x1="0" x2="1"><stop stop-color="#798eff"/><stop offset=".55" stop-color="#69c8b0"/><stop offset="1" stop-color="#b9df9d"/></linearGradient>
        <marker id="agent-flow-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0 0L7 3.5L0 7Z"/></marker>
      </defs>
      <path data-connection="input-document" marker-end="url(#agent-flow-arrow)"/><path data-connection="input-analytics" marker-end="url(#agent-flow-arrow)"/><path data-connection="input-retrieval" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="document-merge" marker-end="url(#agent-flow-arrow)"/><path data-connection="analytics-merge" marker-end="url(#agent-flow-arrow)"/><path data-connection="retrieval-merge" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="merge-llm" marker-end="url(#agent-flow-arrow)"/><path data-connection="merge-manual" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="llm-approval" marker-end="url(#agent-flow-arrow)"/><path data-connection="manual-approval" marker-end="url(#agent-flow-arrow)"/><path data-connection="approval-output" marker-end="url(#agent-flow-arrow)"/>
      <circle class="flow-token" data-flow-token="input-document" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze"/></circle><circle class="flow-token" data-flow-token="input-analytics" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze"/></circle><circle class="flow-token" data-flow-token="input-retrieval" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze"/></circle>
      <circle class="flow-token" data-flow-token="document-merge" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze"/></circle><circle class="flow-token" data-flow-token="analytics-merge" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze"/></circle><circle class="flow-token" data-flow-token="retrieval-merge" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze"/></circle>
      <circle class="flow-token" data-flow-token="merge-llm" r="4"><animateMotion dur=".7s" begin="indefinite" fill="freeze"/></circle><circle class="flow-token" data-flow-token="merge-manual" r="4"><animateMotion dur=".7s" begin="indefinite" fill="freeze"/></circle>
      <circle class="flow-token" data-flow-token="llm-approval" r="4"><animateMotion dur=".7s" begin="indefinite" fill="freeze"/></circle><circle class="flow-token" data-flow-token="manual-approval" r="4"><animateMotion dur=".7s" begin="indefinite" fill="freeze"/></circle><circle class="flow-token" data-flow-token="approval-output" r="4"><animateMotion dur=".75s" begin="indefinite" fill="freeze"/></circle>
    </svg>

    <div class="scene-caption"><span class="live-dot" aria-hidden="true"></span> LOCAL SAMPLE <span class="caption-divider">·</span> NO API</div>

    <div class="scene-flow-grid">
      <div class="input-lane scene-lane">
        <span class="scene-zone-label">INTAKE</span>
        <button class="flow-node input-node" type="button" data-work-node="input" aria-pressed="true" aria-label="Inspect sample input">
          <span class="input-photo" aria-hidden="true"><img src="/images/agentic-healthcare-diagnostics.png" alt="" loading="lazy"/><span class="scan-frame"></span><span class="photo-reticle">＋</span><span class="input-chip">01 / SCAN</span></span>
          <span class="input-bottom"><span class="file-icon" aria-hidden="true">▧</span><span><strong>Diagnostic scan</strong><small>CT + case record</small></span><i class="node-state" data-node-status>Ready</i></span>
        </button>
      </div>

      <div class="specialist-lane scene-lane">
        <span class="scene-zone-label">PARALLEL SPECIALISTS</span>
        <div class="specialist-stage" aria-label="Document intelligence, analytics and retrieval agents">
          <button class="flow-node agent-node document-node" type="button" data-work-node="document" aria-pressed="false" aria-label="Inspect document intelligence result"><span class="module-top"><span class="module-icon" aria-hidden="true">▤</span><span class="node-label">Document intelligence</span><i class="node-state" data-node-status>Ready</i></span><span class="paper-stack" aria-hidden="true"><span class="paper-back"></span><span class="paper-front"><i></i><i></i><i class="lit"></i><i></i><b>✓</b></span><span class="paper-glint"></span></span></button>
          <button class="flow-node agent-node analytics-node" type="button" data-work-node="analytics" aria-pressed="false" aria-label="Inspect analytics result"><span class="module-top"><span class="module-icon chart-icon" aria-hidden="true">⌁</span><span class="node-label">Analytics</span><i class="node-state" data-node-status>Ready</i></span><span class="mini-chart" aria-hidden="true"><svg viewBox="0 0 150 64" preserveAspectRatio="none"><path class="grid" d="M0 16H150M0 32H150M0 48H150"/><path class="area" d="M0 52L25 42L45 47L65 29L84 35L107 19L128 24L150 7V64H0Z"/><path class="trend" d="M0 52L25 42L45 47L65 29L84 35L107 19L128 24L150 7"/></svg><span class="chart-point"></span><span class="chart-axis"><i>01</i><i>04</i><i>08</i></span></span></button>
          <button class="flow-node agent-node retrieval-node" type="button" data-work-node="retrieval" aria-pressed="false" aria-label="Inspect retrieval evidence"><span class="module-top"><span class="module-icon retrieval-icon" aria-hidden="true">◎</span><span class="node-label">RAG retrieval</span><i class="node-state" data-node-status>Ready</i></span><span class="evidence-film" aria-hidden="true"><span class="evidence-image"></span><span class="evidence-snippets"><i><b>4.2</b><em></em></i><i><b>7.1</b><em></em></i></span><span class="evidence-match">✓</span></span></button>
        </div>
      </div>

      <button class="flow-node merge-node" type="button" data-work-node="merge" aria-pressed="false" aria-label="Inspect combined findings"><span class="merge-rings" aria-hidden="true"><i></i><i></i><b>✦</b></span><span class="node-label">Synthesis</span><i class="node-state" data-node-status>Ready</i></button>

      <div class="review-stage">
        <div class="evaluation-stage"><span class="eval-heading">EVALUATION</span><div class="evaluation-switch">
          <button class="flow-node evaluation-node llm-node" type="button" data-work-node="llm-evaluation" data-evaluation-choice="llm" aria-pressed="true"><span class="eval-visual" aria-hidden="true"><i></i><i></i><b>✓</b></span><span class="node-label">LLM evaluation</span><i class="node-state" data-node-status>Ready</i></button>
          <button class="flow-node evaluation-node manual-node" type="button" data-work-node="manual-evaluation" data-evaluation-choice="manual" aria-pressed="false"><span class="review-avatar" aria-hidden="true">JR</span><span class="node-label">Human evaluation</span><i class="node-state" data-node-status>Available</i></button>
        </div></div>
        <button class="flow-node approval-node" type="button" data-work-node="approval" aria-pressed="false" aria-label="Inspect approval checkpoint"><span class="approval-orbit" aria-hidden="true"><i>✓</i></span><span class="node-label">Approval</span><i class="node-state" data-node-status>Waiting</i></button>
      </div>

      <button class="flow-node output-node" type="button" data-work-node="output" aria-pressed="false" aria-label="Inspect verified output" disabled><span class="output-top"><span class="node-label">Reviewed result</span><i class="node-state" data-node-status>Pending</i></span><span class="output-pending" aria-hidden="true"><i></i><i></i><b>Awaiting review</b></span><span class="output-preview" aria-hidden="true"><span class="output-image"></span><span class="output-sheet"><i></i><i></i><i class="lit"></i><i></i><b>✓</b></span><span class="output-check">✓</span></span><span class="output-meta"><span>2 SOURCES</span><span data-output-verdict>NOT VERIFIED</span></span></button>
    </div>

    <section class="workspace-inspector" aria-live="polite" aria-atomic="true" aria-hidden="true"><button class="inspector-close" type="button" data-close-inspector aria-label="Close visual detail">×</button><div class="inspector-heading"><span class="workspace-kicker">VISUAL DETAIL</span><strong data-detail-title>Input</strong><p data-detail-copy>Sample input</p><ul data-preview-items><li>CT scan</li><li>Case record</li></ul></div><div class="inspector-visual" data-preview-stage aria-label="Selected module visual preview"></div><button class="human-approve" type="button" data-human-approve hidden disabled>Approve <span aria-hidden="true">↗</span></button></section>
  </div>

  <footer class="workspace-toolbar"><span>Fictional sample · local run</span><div><button type="button" data-run>Run <span aria-hidden="true">→</span></button><button type="button" data-pause disabled>Pause</button><button type="button" data-replay>Replay</button><button type="button" data-reset>Reset</button></div></footer>

  <template data-preview-template="input"><div class="preview-document"><span class="preview-caption">SOURCE / CT + CASE</span><div class="detail-photo"><img src="/images/agentic-healthcare-diagnostics.png" alt="Diagnostic scan review"/><span>＋</span></div></div></template>
  <template data-preview-template="document"><div class="preview-document"><span class="preview-caption">DOCUMENT / EXTRACT</span><div class="detail-paper"><i></i><i></i><i class="highlight"></i><i></i><i></i><b>✓</b></div></div></template>
  <template data-preview-template="analytics"><div class="preview-chart"><span class="preview-caption">ANALYTICS / SIGNAL</span><div class="detail-chart"><svg viewBox="0 0 220 95" preserveAspectRatio="none"><path d="M0 74L35 60L67 69L97 39L132 48L168 26L190 31L220 9"/></svg><span>↗ 12%</span></div></div></template>
  <template data-preview-template="retrieval"><div class="preview-evidence"><span class="preview-caption">RETRIEVED / SOURCES</span><div class="detail-source"><span>01</span><i></i><i></i><b>✓</b></div><div class="detail-source"><span>02</span><i></i><i></i><b>✓</b></div></div></template>
  <template data-preview-template="merge"><div class="preview-merge"><span class="preview-caption">SYNTHESIS / SIGNALS</span><div class="detail-merge"><span>▤</span><i></i><b>✦</b><i></i><span>⌁</span></div></div></template>
  <template data-preview-template="llm-evaluation"><div class="preview-checks"><span class="preview-caption">LLM / EVALUATION</span><div class="detail-check"><span>✓</span><span>✓</span><span>✓</span></div><small>3 checks</small></div></template>
  <template data-preview-template="manual-evaluation"><div class="preview-manual"><span class="preview-caption">HUMAN / REVIEW</span><label><input type="checkbox" data-review-check/><span>Source</span></label><label><input type="checkbox" data-review-check/><span>Result</span></label></div></template>
  <template data-preview-template="approval"><div class="preview-approval"><span class="preview-caption">REVIEW / APPROVAL</span><div class="detail-approval"><span>JR</span><i></i><b>✓</b></div></div></template>
  <template data-preview-template="output"><div class="preview-output"><span class="preview-caption">VERIFIED / 2 SOURCES</span><div class="detail-output"><img src="/images/agentic-healthcare-diagnostics.png" alt="Reviewed diagnostic result"/><span><b>✓</b><i>4.2</i><i>7.1</i></span></div></div></template>
</section>

<style>
  .agent-workspace{--ink:#273129;--muted:#6c756b;--olive:#71825d;--olive-strong:#60764b;--line:#e1dfd3;--paper:#fffefa;position:relative;isolation:isolate;overflow:hidden;border:1px solid #dfddd2;border-radius:24px;background:#f7f5ee;color:var(--ink);color-scheme:light;font-family:Geist,system-ui,sans-serif;box-shadow:0 28px 72px rgba(54,51,40,.12)}
  .agent-workspace *,.agent-workspace *:before,.agent-workspace *:after{animation:none!important;transition:none!important}
  .workspace-head{display:flex;align-items:center;gap:14px;padding:13px 18px;border-bottom:1px solid var(--line);background:#fffefa}
  .studio-mark{display:flex;align-items:center;gap:10px;margin-right:auto}
  .studio-symbol{display:grid;place-items:center;width:31px;height:31px;border:1px solid #e0e2d5;border-radius:10px;background:#edf0e6;color:#687b50;font-size:17px}
  .workspace-kicker,.scene-zone-label,.scene-caption,.eval-heading,.preview-caption{font-size:8px;letter-spacing:.13em;font-weight:760;color:#78816f}
  .workspace-head h3{margin:2px 0 0;color:#293229;font-size:14px;font-weight:650;letter-spacing:-.025em}
  .run-state{display:flex;align-items:center;gap:7px;color:#53684b;font-size:9px;white-space:nowrap}
  .run-state:before,.live-dot{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:#81976a}
  .workspace-expand{display:grid;place-items:center;width:31px;height:31px;border:1px solid #e4e2d8;border-radius:9px;background:#f8f7f1;color:#4f594e;font-size:16px;cursor:pointer}
  .workspace-expand:hover{border-color:#b8c2a3;background:#f0f2e9;color:#526a3c}
  .orchestration-canvas{position:relative;isolation:isolate;display:grid;grid-template-rows:auto 1fr auto;gap:12px;padding:15px 22px 18px;min-height:610px;background:radial-gradient(ellipse at 82% 7%,rgba(206,211,178,.23),transparent 32%),linear-gradient(135deg,#fcfbf7,#f3f1e8 72%,#f1efe6)}
  .scene-atmosphere{position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 14% 76%,rgba(224,220,199,.28),transparent 34%);pointer-events:none}
  .scene-caption{grid-row:1;justify-self:end;display:flex;align-items:center;gap:7px;color:#788075;font-size:7px}
  .live-dot{width:5px;height:5px}
  .caption-divider{color:#a6a899}
  .scene-flow-grid{position:relative;z-index:1;grid-row:2;display:grid;grid-template-columns:minmax(155px,.9fr) minmax(235px,1.3fr) minmax(46px,.28fr) minmax(155px,.8fr) minmax(170px,.9fr);grid-template-areas:"input agents merge review output";align-items:center;gap:clamp(13px,1.5vw,24px);min-height:450px}
  .connections{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;overflow:visible}
  .connections>path{fill:none;stroke:#889474;stroke-width:1.3;stroke-opacity:.32;vector-effect:non-scaling-stroke}
  .connections>path.is-active{stroke:#63794f;stroke-opacity:.92;stroke-width:2}
  .connections marker path{fill:#63794f}
  .flow-token{fill:#657d4d;opacity:0;filter:drop-shadow(0 0 3px rgba(110,131,80,.35));pointer-events:none}
  .flow-token.is-moving{opacity:1}
  .scene-lane{display:grid;grid-template-rows:auto 1fr;gap:9px;min-width:0}
  .input-lane{grid-area:input}
  .specialist-lane{grid-area:agents}
  .scene-zone-label{color:#78816f;font-size:7px}
  .flow-node{font:inherit;color:var(--ink);cursor:pointer}
  .flow-node:hover:not(:disabled){filter:brightness(.985)}
  .flow-node:focus-visible,.workspace-toolbar button:focus-visible,.workspace-expand:focus-visible,.human-approve:focus-visible,.inspector-close:focus-visible,.preview-manual input:focus-visible{outline:2px solid #7f9466;outline-offset:3px}
  .flow-node[data-phase=active]{filter:drop-shadow(0 4px 8px rgba(107,128,81,.18))}
  .flow-node[data-phase=review]{filter:drop-shadow(0 4px 8px rgba(164,141,91,.16))}
  .node-label{font-size:9px;font-weight:680;letter-spacing:.005em}
  .node-state{color:#7c8479;font-size:7px;font-style:normal;white-space:nowrap}
  .flow-node[data-phase=active] .node-state,.flow-node[data-phase=complete] .node-state{color:#5e7449}
  .flow-node[data-phase=review] .node-state{color:#947648}
  .input-node{display:grid;grid-template-rows:minmax(0,1fr) auto;position:relative;width:100%;min-width:0;min-height:300px;max-height:375px;aspect-ratio:.78;padding:0;border:1px solid #d8d7ca;border-radius:17px;background:#fffefa;text-align:left;overflow:hidden;box-shadow:0 16px 34px rgba(67,63,48,.13)}
  .input-node[aria-pressed=true]{border-color:#9ca984;box-shadow:0 0 0 2px rgba(126,145,98,.16),0 17px 34px rgba(67,63,48,.15)}
  .input-photo{position:relative;display:block;min-height:0;overflow:hidden;background:#e6e3d8}
  .input-photo:after{content:"";position:absolute;inset:55% 0 0;background:linear-gradient(180deg,transparent,rgba(35,42,31,.12));pointer-events:none}
  .input-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:71% center;filter:none!important}
  .scan-frame{position:absolute;left:60%;top:34%;width:21%;height:31%;border:1px solid rgba(240,239,221,.88);border-radius:48% 43% 40% 46%;box-shadow:0 0 0 4px rgba(110,131,80,.13)}
  .photo-reticle{position:absolute;right:11px;top:10px;z-index:1;display:grid;place-items:center;width:20px;height:20px;border:1px solid rgba(255,255,255,.72);border-radius:50%;background:rgba(255,255,255,.35);color:#fff;font-size:14px}
  .input-chip{position:absolute;left:10px;top:10px;z-index:1;padding:5px 7px;border:1px solid rgba(255,255,255,.65);border-radius:5px;background:rgba(250,249,243,.82);color:#46533d;font-size:6px;font-weight:750;letter-spacing:.1em}
  .input-bottom{display:flex;align-items:center;gap:8px;min-width:0;padding:10px 11px;background:#fffefa}
  .input-bottom strong,.input-bottom small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .input-bottom strong{color:#313b31;font-size:8px;font-weight:680}
  .input-bottom small{margin-top:3px;color:#7a8278;font-size:7px}
  .input-bottom .node-state{margin-left:auto}
  .file-icon{display:grid;place-items:center;width:27px;height:27px;flex:none;border:1px solid #e5e4d9;border-radius:8px;background:#f4f3eb;color:#788a60;font-size:13px}
  .specialist-stage{display:grid;grid-template-rows:repeat(3,minmax(86px,1fr));gap:10px;min-width:0}
  .agent-node{position:relative;display:grid;grid-template-rows:auto 1fr;min-width:0;min-height:86px;padding:9px 11px 8px;border:1px solid #e4e1d5;border-radius:13px;background:linear-gradient(135deg,#fffefa,#f7f6ef);box-shadow:0 7px 17px rgba(65,62,48,.07);overflow:hidden;text-align:left}
  .agent-node[aria-pressed=true]{border-color:#9ca984;background:#fffefa;box-shadow:0 0 0 2px rgba(126,145,98,.12),0 9px 20px rgba(65,62,48,.09)}
  .module-top{display:flex;align-items:center;gap:7px;min-width:0}
  .module-icon{display:grid;place-items:center;width:22px;height:22px;flex:none;border:1px solid #e5e5d9;border-radius:7px;background:#f0f1e8;color:#76885c;font-size:12px}
  .chart-icon{background:#f2eee4;color:#9a855b}
  .retrieval-icon{background:#eaf0e8;color:#66826b}
  .module-top .node-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#354035;font-size:8px}
  .module-top .node-state{margin-left:auto;font-size:6px}
  .paper-stack{position:relative;display:block;width:60px;height:42px;justify-self:end;align-self:end;margin:1px 8px 0 0}
  .paper-back,.paper-front{position:absolute;display:block;width:42px;height:37px;border:1px solid #dedecf;border-radius:4px;background:#fbfaf3;box-shadow:0 3px 7px rgba(53,57,43,.08)}
  .paper-back{right:4px;top:1px;transform:rotate(7deg);background:#eeeee3}
  .paper-front{right:10px;top:3px;padding:7px 5px}
  .paper-front i,.output-sheet i{display:block;height:2px;margin:0 0 4px;border-radius:2px;background:#d9d9ce}
  .paper-front i:nth-child(2){width:72%}
  .paper-front i.lit,.output-sheet i.lit{width:78%;background:#b5c397}
  .paper-front i:nth-child(4){width:56%}
  .paper-front b,.output-sheet b{position:absolute;right:4px;bottom:3px;color:#73895c;font-size:8px}
  .paper-glint{display:none}
  .mini-chart{position:relative;width:100%;height:44px;align-self:end;margin:1px 0 0;overflow:hidden}
  .mini-chart:after{content:"";position:absolute;right:4px;top:2px;width:6px;height:6px;border:1px solid #a4aa84;border-radius:50%;background:#fbfaf4}
  .mini-chart svg{display:block;width:100%;height:100%;filter:none!important}
  .mini-chart .grid{fill:none;stroke:#e9e7dc;stroke-width:1}
  .mini-chart .area{fill:rgba(172,185,139,.18)}
  .mini-chart .trend{fill:none;stroke:#84936b;stroke-width:2}
  .chart-point{display:none}
  .chart-axis{display:flex;justify-content:space-between;color:#9a9b8d;font-size:5px}
  .evidence-film{display:flex;align-items:center;gap:7px;min-height:40px;align-self:end;margin:0 0 0 auto}
  .evidence-image{position:relative;width:46px;height:31px;overflow:hidden;border:1px solid #d9d9ca;border-radius:5px;background:linear-gradient(135deg,#d8ded0,#f1eee2 55%,#afb99d)}
  .evidence-image:after{content:"";position:absolute;inset:30% 20% 24%;border:1px solid rgba(102,126,84,.6);border-radius:4px}
  .evidence-snippets{display:grid;gap:4px}
  .evidence-snippets i{display:flex;align-items:center;gap:4px;width:56px;font-style:normal}
  .evidence-snippets b{color:#76835f;font-size:6px}
  .evidence-snippets em{height:2px;flex:1;border-radius:2px;background:#d3d4c6}
  .evidence-snippets i:nth-child(2) em{background:#aebd97}
  .evidence-match{display:grid;place-items:center;width:15px;height:15px;border:1px solid #cfd8bd;border-radius:50%;background:#eef2e6;color:#6d8455;font-size:8px}
  .merge-node{grid-area:merge;display:grid;justify-items:center;align-content:center;gap:6px;min-width:0;padding:4px;border:0;background:transparent;z-index:1}
  .merge-rings{position:relative;display:grid;place-items:center;width:58px;height:58px;border:1px solid #d5d9c8;border-radius:50%;background:radial-gradient(circle,#fffefa 0,#f4f4ea 68%,#edf0e4);box-shadow:0 0 0 6px rgba(128,145,102,.08)}
  .merge-rings:after{content:"";position:absolute;inset:-7px;border:1px solid #e1e2d6;border-radius:50%}
  .merge-rings i{position:absolute;width:22px;height:22px;border:1px solid #98a584;border-radius:50%;transform:translateX(-8px);background:#f5f4ec}
  .merge-rings i:nth-child(2){transform:translateX(8px);border-color:#b4a482}
  .merge-rings b{z-index:1;color:#6f8358;font-size:15px}
  .merge-node .node-label,.merge-node .node-state{font-size:6px}
