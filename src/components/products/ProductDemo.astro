---
interface Props {
  kind: 'agentic' | 'annotation';
  instanceId: string;
}

const { kind, instanceId } = Astro.props;
const agentic = kind === 'agentic';
const productName = agentic ? 'Agentic AI Studio' : 'Annotation & Verification Platform';
const steps = agentic ? [
  { name: 'Sample input', short: 'Input', detail: 'A request and two source drafts enter the sample workflow.' },
  { name: 'Agents and tools', short: 'Connect', detail: 'Select an agent to inspect its bounded contribution.' },
  { name: 'Execution trace', short: 'Run', detail: 'The run records each step and what it returned.' },
  { name: 'Human review', short: 'Review', detail: 'A person checks the proposed answer before sharing it.' },
  { name: 'Cited output', short: 'Output', detail: 'The result remains linked to the passages behind it.' },
] : [
  { name: 'Sample dataset', short: 'Dataset', detail: 'Three fictional support records form a small annotation queue.' },
  { name: 'Independent labels', short: 'Annotate', detail: 'Two annotators label isolated copies of the same record.' },
  { name: 'Disagreement', short: 'Compare', detail: 'One differing label is surfaced for review.' },
  { name: 'Reviewer decision', short: 'Review', detail: 'Choose and approve a final sample label.' },
  { name: 'Reviewed export', short: 'Export', detail: 'Download a local CSV of the reviewed sample.' },
];
---

<section class="product-demo" data-product-demo data-product={kind} aria-label={`${productName} guided sample walkthrough`}>
  <div class="demo-header">
    <div class="demo-header-title"><span class="demo-mark">∿</span><span><strong>{productName}</strong><small>Guided sample walkthrough</small></span></div>
    <span class="demo-sample">Illustrative preview · sample data</span>
  </div>
  <div class="demo-progress" aria-hidden="true"><span data-progress></span></div>
  <div class="demo-layout">
    <div class="step-list" role="tablist" aria-label={`${productName} walkthrough steps`}>
      {steps.map((step, index) => (
        <button
          id={`${instanceId}-tab-${index}`}
          type="button"
          role="tab"
          aria-controls={`${instanceId}-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-step-button
          data-step-index={index}
        ><span class="step-number">0{index + 1}</span><span><b>{step.name}</b><small>{step.short}</small></span><span class="step-arrow" aria-hidden="true">↗</span></button>
      ))}
    </div>
    <div class="stage-area">
      {steps.map((step, index) => (
        <section
          id={`${instanceId}-panel-${index}`}
          class="step-panel"
          role="tabpanel"
          aria-labelledby={`${instanceId}-tab-${index}`}
          tabindex="0"
          hidden={index !== 0}
          data-step-panel
        >
          <div class="panel-heading"><span class="panel-overline">STAGE 0{index + 1} / 05</span><h3>{step.name}</h3><p>{step.detail}</p></div>
          {agentic ? (
            <div class="panel-content">
              {index === 0 && (
                <div class="two-col">
                  <div class="ui-card input-card"><span class="card-kicker">REQUEST  /  SAMPLE</span><strong>What changed between the April and May policy drafts?</strong><p>Prepare a concise answer for a release review and link every claim to its source passage.</p><span class="pill">Input received</span></div>
                  <div class="ui-card"><span class="card-kicker">ATTACHED SOURCES</span><div class="document-row"><span class="file-icon">A</span><span><b>Policy · April draft</b><small>8 sections · fictional document</small></span></div><div class="document-row"><span class="file-icon">M</span><span><b>Policy · May draft</b><small>9 sections · fictional document</small></span></div></div>
                </div>
              )}
              {index === 1 && (
                <div class="agent-stage"><div class="agent-grid" aria-label="Select an agent contribution"><button type="button" data-agent data-agent-name="Planner" data-agent-detail="Splits the request into reading, comparison, and evidence checks." aria-pressed="true"><span>01</span><b>Planner</b><small>Plan steps</small></button><button type="button" data-agent data-agent-name="Document reader" data-agent-detail="Extracts candidate passages from the two sample drafts." aria-pressed="false"><span>02</span><b>Document reader</b><small>Read sources</small></button><button type="button" data-agent data-agent-name="Comparison agent" data-agent-detail="Pairs related clauses and marks changed language for review." aria-pressed="false"><span>03</span><b>Comparison agent</b><small>Compare clauses</small></button><button type="button" data-agent data-agent-name="Evidence checker" data-agent-detail="Checks that each proposed finding points to a source passage." aria-pressed="false"><span>04</span><b>Evidence checker</b><small>Link evidence</small></button></div><div class="ui-card agent-detail" aria-live="polite"><span class="card-kicker">SELECTED CONTRIBUTION</span><strong data-agent-detail-name>Planner</strong><p data-agent-detail-text>Splits the request into reading, comparison, and evidence checks.</p></div></div>
              )}
              {index === 2 && (
                <div class="trace-list"><div class="trace-row"><span class="trace-index">01</span><span><b>Plan created</b><small>Read both drafts, compare related clauses, verify source links.</small></span><em>Complete</em></div><div class="trace-row"><span class="trace-index">02</span><span><b>Documents read</b><small>Passages captured from §2.1 and §4.3 of the sample drafts.</small></span><em>Complete</em></div><div class="trace-row trace-highlight"><span class="trace-index">03</span><span><b>Changes compared</b><small>Review frequency and exception ownership differ.</small></span><em>Highlighted</em></div><div class="trace-row"><span class="trace-index">04</span><span><b>Evidence checked</b><small>Two findings have linked passages.</small></span><em>Complete</em></div></div>
              )}
              {index === 3 && (
                <div class="two-col"><div class="ui-card"><span class="card-kicker">DRAFT FINDING</span><strong>Access reviews change from quarterly to monthly.</strong><p>Linked source: April §2.1 → May §2.1.</p><div class="review-actions"><button type="button" data-agent-approve>Approve sample finding</button></div></div><div class="ui-card review-card"><span class="card-kicker">HUMAN REVIEW</span><strong data-agent-review-status>Waiting for a reviewer</strong><p>A person decides whether this draft is ready to share; this button only updates the local example.</p></div></div>
              )}
              {index === 4 && (
                <div class="ui-card output-card"><div class="output-top"><span class="card-kicker">REVIEWABLE OUTPUT  /  SAMPLE</span><span class="pill">Evidence linked</span></div><strong>Two changes to review</strong><ol><li>Access reviews move from quarterly to monthly. <span>May §2.1</span></li><li>Exception requests now require a named owner. <span>May §4.3</span></li></ol><div class="evidence-foot"><b>Source trail</b><span>April draft §2.1</span><span>May draft §2.1, §4.3</span></div></div>
              )}
            </div>
          ) : (
            <div class="panel-content">
              {index === 0 && (
                <div class="ui-card dataset-card"><div class="dataset-head"><span class="card-kicker">DATASET  /  SAMPLE SUPPORT REQUESTS</span><span class="pill">3 fictional records</span></div><div class="record-row"><b>#R-101</b><span>“Please update the billing address on our account.”</span><small>Unlabelled</small></div><div class="record-row is-featured"><b>#R-102</b><span>“I can’t access last month’s invoice.”</span><small>Unlabelled</small></div><div class="record-row"><b>#R-103</b><span>“Where can I download my receipt?”</span><small>Unlabelled</small></div><p>Task: choose the best routing label from Billing or Access.</p></div>
              )}
              {index === 1 && (
                <div class="two-col"><div class="ui-card annotator-card"><span class="card-kicker">ANNOTATOR A  /  ISOLATED COPY</span><strong>#R-102</strong><p>“I can’t access last month’s invoice.”</p><span class="label-choice">Access</span><small>Reason: the phrase “can’t access” stands out.</small></div><div class="ui-card annotator-card"><span class="card-kicker">ANNOTATOR B  /  ISOLATED COPY</span><strong>#R-102</strong><p>“I can’t access last month’s invoice.”</p><span class="label-choice alternate">Billing</span><small>Reason: the object being requested is an invoice.</small></div></div>
              )}
              {index === 2 && (
                <div class="ui-card conflict-card"><div class="conflict-top"><span class="card-kicker">AGREEMENT CHECK  /  #R-102</span><span class="conflict-badge">Needs review</span></div><strong>Two labels, one record.</strong><div class="comparison"><span>Annotator A <b>Access</b></span><span class="versus">≠</span><span>Annotator B <b>Billing</b></span></div><p>The other two records agree. A reviewer resolves this one before export.</p></div>
              )}
              {index === 3 && (
                <div class="two-col"><div class="ui-card"><span class="card-kicker">REVIEWER  /  #R-102</span><strong>Choose the final label</strong><p>“I can’t access last month’s invoice.”</p><div class="review-actions"><button type="button" data-review-choice data-label="Billing" aria-pressed="true">Billing</button><button type="button" data-review-choice data-label="Access" aria-pressed="false">Access</button></div><button class="approve-button" type="button" data-review-approve>Approve sample label</button></div><div class="ui-card review-card"><span class="card-kicker">REVIEW STATUS</span><strong data-review-status>Decision pending</strong><p>The reviewer’s choice is reflected in the sample export on the next step.</p></div></div>
              )}
              {index === 4 && (
                <div class="ui-card export-card"><div class="output-top"><span class="card-kicker">REVIEWED DATA  /  SAMPLE CSV</span><span class="pill">3 rows</span></div><div class="csv-head"><span>record_id</span><span>reviewed_label</span><span>status</span></div><div class="csv-row"><span>R-101</span><span>Billing</span><span>approved</span></div><div class="csv-row"><span>R-102</span><span data-export-label>Billing</span><span>approved</span></div><div class="csv-row"><span>R-103</span><span>Billing</span><span>approved</span></div><button type="button" data-export>Download sample CSV ↗</button><small data-export-status aria-live="polite">Generated locally; no data leaves this browser.</small></div>
              )}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
  <div class="demo-controls"><span data-step-status aria-live="polite">Step 1 of 5 · {steps[0].name}</span><div><button type="button" data-step-prev disabled>← Back</button><button type="button" data-step-next>Next step →</button></div></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-demo]').forEach((demo) => {
    if (demo.dataset.ready === 'true') return;
    demo.dataset.ready = 'true';
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[data-step-button]')];
    const panels = [...demo.querySelectorAll<HTMLElement>('[data-step-panel]')];
    const previous = demo.querySelector<HTMLButtonElement>('[data-step-prev]')!;
    const next = demo.querySelector<HTMLButtonElement>('[data-step-next]')!;
    const status = demo.querySelector<HTMLElement>('[data-step-status]')!;
    const progress = demo.querySelector<HTMLElement>('[data-progress]')!;
    let current = 0;

    const activate = (step: number, focusTab = false) => {
      current = Math.max(0, Math.min(tabs.length - 1, step));
      tabs.forEach((tab, index) => {
        const selected = index === current;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[index].hidden = !selected;
      });
      previous.disabled = current === 0;
      next.disabled = current === tabs.length - 1;
      status.textContent = `Step ${current + 1} of ${tabs.length} · ${tabs[current].querySelector('b')?.textContent ?? ''}`;
      progress.style.width = `${((current + 1) / tabs.length) * 100}%`;
      if (focusTab) tabs[current].focus();
    };
    tabs.forEach((tab, index) => tab.addEventListener('click', () => activate(index)));
    demo.querySelector('.step-list')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowRight' || key === 'ArrowDown') { event.preventDefault(); activate((current + 1) % tabs.length, true); }
      if (key === 'ArrowLeft' || key === 'ArrowUp') { event.preventDefault(); activate((current - 1 + tabs.length) % tabs.length, true); }
      if (key === 'Home') { event.preventDefault(); activate(0, true); }
      if (key === 'End') { event.preventDefault(); activate(tabs.length - 1, true); }
    });
    previous.addEventListener('click', () => activate(current - 1));
    next.addEventListener('click', () => activate(current + 1));

    const agentButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-agent]')];
    agentButtons.forEach((button) => button.addEventListener('click', () => {
      agentButtons.forEach((agent) => agent.setAttribute('aria-pressed', String(agent === button)));
      demo.querySelector<HTMLElement>('[data-agent-detail-name]')!.textContent = button.dataset.agentName ?? '';
      demo.querySelector<HTMLElement>('[data-agent-detail-text]')!.textContent = button.dataset.agentDetail ?? '';
    }));
    demo.querySelector<HTMLButtonElement>('[data-agent-approve]')?.addEventListener('click', () => {
      demo.querySelector<HTMLElement>('[data-agent-review-status]')!.textContent = 'Sample finding approved';
    });

    let finalLabel = 'Billing';
    const labelButtons = [...demo.querySelectorAll<HTMLButtonElement>('[data-review-choice]')];
    labelButtons.forEach((button) => button.addEventListener('click', () => {
      finalLabel = button.dataset.label ?? 'Billing';
      labelButtons.forEach((choice) => choice.setAttribute('aria-pressed', String(choice === button)));
      demo.querySelector<HTMLElement>('[data-review-status]')!.textContent = `${finalLabel} selected · approval pending`;
      demo.querySelector<HTMLElement>('[data-export-label]')!.textContent = finalLabel;
    }));
    demo.querySelector<HTMLButtonElement>('[data-review-approve]')?.addEventListener('click', () => {
      demo.querySelector<HTMLElement>('[data-review-status]')!.textContent = `Approved: #R-102 → ${finalLabel}`;
    });
    demo.querySelector<HTMLButtonElement>('[data-export]')?.addEventListener('click', () => {
      const csv = `record_id,reviewed_label,status\nR-101,Billing,approved\nR-102,${finalLabel},approved\nR-103,Billing,approved\n`;
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'latentsig-sample-reviewed-data.csv';
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      demo.querySelector<HTMLElement>('[data-export-status]')!.textContent = 'Sample CSV downloaded locally.';
    });
    activate(0);
  });
</script>

<style>
