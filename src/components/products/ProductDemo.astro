  .agent-stage{display:grid;grid-template-columns:1.5fr 1fr;gap:13px}.agent-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.agent-grid button{display:flex;flex-direction:column;align-items:start;gap:7px;min-height:116px;padding:15px;border:1px solid #3c4967;border-radius:10px;background:#17223b;color:#e5eaff;text-align:left;cursor:pointer}.agent-grid button:hover,.agent-grid button[aria-pressed="true"]{border-color:#aaaaff;background:#2b3155}.agent-grid button>span{color:#b4b8f3;font-size:10px;font-weight:700}.agent-grid b{font-size:12px}.agent-grid small{color:#acb7cf;font-size:10px}.agent-detail{display:flex;flex-direction:column;justify-content:center}.agent-detail strong{font-size:20px}
