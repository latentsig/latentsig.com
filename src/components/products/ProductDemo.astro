  .dataset-card{padding-bottom:9px}.record-row{display:grid;grid-template-columns:58px minmax(0,1fr) auto;gap:12px;align-items:center;min-height:58px;border-top:1px solid #3b4865}.record-row:first-of-type{margin-top:15px}.record-row b{color:#bec3ff;font-size:11px}.record-row span{font-size:12px;line-height:1.4}.record-row small{color:#98a5c1;font-size:10px}.record-row.is-featured{margin:0 -10px;padding:0 10px;background:#2b2b4d}.dataset-card>p{margin:14px 0;color:#aebbd2;font-size:10px}.annotator-card>small{display:block;margin-top:25px;color:#aebbd3;font-size:10px;line-height:1.45}.label-choice{display:inline-block;padding:7px 11px;margin-top:21px;border:1px solid #8ea4c9;border-radius:6px;color:#c9e9ff;background:#23435b;font-size:11px;font-weight:700}.label-choice.alternate{border-color:#aca5de;color:#e5dcff;background:#3d365e}.conflict-card>strong{font-size:22px}.conflict-badge{padding:6px 9px;border-radius:999px;background:#49314d;color:#ffccdf;font-size:10px;font-weight:700}.comparison{display:flex;align-items:center;justify-content:center;gap:20px;min-height:105px;margin:20px 0;padding:12px;border:1px solid #5a506b;border-radius:10px;background:#282940}.comparison>span:not(.versus){display:flex;flex-direction:column;gap:9px;color:#aeb8d2;font-size:10px}.comparison b{color:#f0f2ff;font-size:18px}.comparison .versus{color:#ffb7d1;font-size:24px}
  .csv-head,.csv-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding:10px 12px;font:11px/1.3 ui-monospace,SFMono-Regular,monospace}.csv-head{margin-top:15px;border-radius:6px 6px 0 0;background:#2a3650;color:#c6cbed}.csv-row{border:1px solid #394663;border-top:0;color:#dfe6f6}.csv-row:last-of-type{border-radius:0 0 6px 6px}.export-card>button{margin-top:16px}.export-card>small{display:block;margin-top:9px;color:#aebbd2;font-size:10px}
