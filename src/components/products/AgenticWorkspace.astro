<section class="agent-workspace" data-agent-workspace data-execution-state="idle" aria-label="Interactive Agentic AI Studio workflow demonstration">
  <header class="workspace-head">
    <div>
      <span class="workspace-kicker">INTERACTIVE DEMONSTRATION · FICTIONAL SAMPLE</span>
      <h3>Policy review workflow</h3>
    </div>
    <span class="run-state" data-run-state aria-live="polite">Ready to run</span>
    <button class="workspace-expand" type="button" data-open-dialog aria-haspopup="dialog" aria-label="Open enlarged orchestration workspace">⤢</button>
  </header>

  <div class="orchestration-canvas" aria-label="Workflow: request, orchestrator, parallel specialist agents, evaluation, human approval, and reviewed output">
    <svg class="connections" viewBox="0 0 1000 440" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <marker id="agent-flow-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" /></marker>
      </defs>
      <path data-connection="input-orchestrator" d="M132 220H206" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="dispatch-reader" d="M316 220C340 220 340 100 372 100" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="dispatch-compare" d="M316 220H372" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="dispatch-evidence" d="M316 220C340 220 340 340 372 340" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="merge-reader" d="M516 100C548 100 548 220 578 220" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="merge-compare" d="M516 220H578" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="merge-evidence" d="M516 340C548 340 548 220 578 220" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="evaluation-human" d="M700 220H758" marker-end="url(#agent-flow-arrow)" />
      <path data-connection="human-output" d="M878 220H940" marker-end="url(#agent-flow-arrow)" />
      <circle class="flow-token" data-flow-token="input-orchestrator" r="4"><animateMotion dur=".65s" begin="indefinite" fill="freeze" path="M132 220H206" /></circle>
      <circle class="flow-token" data-flow-token="dispatch-reader" r="4"><animateMotion dur="1.05s" begin="indefinite" repeatCount="indefinite" path="M316 220C340 220 340 100 372 100" /></circle>
      <circle class="flow-token" data-flow-token="dispatch-compare" r="4"><animateMotion dur="1.05s" begin="indefinite" repeatCount="indefinite" path="M316 220H372" /></circle>
      <circle class="flow-token" data-flow-token="dispatch-evidence" r="4"><animateMotion dur="1.05s" begin="indefinite" repeatCount="indefinite" path="M316 220C340 220 340 340 372 340" /></circle>
      <circle class="flow-token" data-flow-token="merge-reader" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze" path="M516 100C548 100 548 220 578 220" /></circle>
      <circle class="flow-token" data-flow-token="merge-compare" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze" path="M516 220H578" /></circle>
      <circle class="flow-token" data-flow-token="merge-evidence" r="4"><animateMotion dur=".8s" begin="indefinite" fill="freeze" path="M516 340C548 340 548 220 578 220" /></circle>
      <circle class="flow-token" data-flow-token="evaluation-human" r="4"><animateMotion dur=".65s" begin="indefinite" fill="freeze" path="M700 220H758" /></circle>
      <circle class="flow-token" data-flow-token="human-output" r="4"><animateMotion dur=".65s" begin="indefinite" fill="freeze" path="M878 220H940" /></circle>
    </svg>

    <button class="flow-node source-node" data-work-node="input" aria-pressed="false">
      <span class="node-overline">INCOMING REQUEST</span>
      <span class="document-preview" aria-hidden="true"><b>FIELD OPERATIONS</b><i></i><i></i><i></i><span>APR 26&nbsp; · &nbsp;MAY 26</span></span>
      <b>Compare policy drafts</b><small>April v1.4 · May v1.5</small><i class="node-state" data-node-status>Input ready</i>
    </button>
    <span class="mobile-flow" aria-hidden="true">↓ &nbsp; route request</span>

    <button class="flow-node orchestrator-node" data-work-node="orchestrator" aria-pressed="true">
      <span class="orchestrator-mark" aria-hidden="true"><svg viewBox="0 0 36 36"><path d="M8 18h8m4 0h8M16 10l4 8-4 8" /><circle cx="7" cy="18" r="3"/><circle cx="29" cy="18" r="3"/><circle cx="18" cy="8" r="3"/><circle cx="18" cy="28" r="3"/></svg></span>
      <b>Orchestrator</b><small>Routes work &amp; gathers evidence</small><i class="node-state" data-node-status>Ready</i>
    </button>
    <span class="mobile-flow" aria-hidden="true">↓ &nbsp; fan out in parallel</span>

    <div class="agent-stack" aria-label="Three specialist agents running in parallel">
      <span class="parallel-label"><i></i> THREE PARALLEL AGENTS</span>
      <button class="agent-node" data-work-node="reader" aria-pressed="false"><span class="tool-icon doc-icon" aria-hidden="true">▤</span><span class="agent-copy"><b>Document reader</b><small>Finds source clauses</small></span><span class="agent-result" data-agent-result>14 clauses</span><i data-node-status>Ready</i></button>
      <button class="agent-node" data-work-node="compare" aria-pressed="false"><span class="tool-icon compare-icon" aria-hidden="true">⇄</span><span class="agent-copy"><b>Change analyst</b><small>Compares revisions</small></span><span class="agent-result" data-agent-result>2 changes</span><i data-node-status>Ready</i></button>
      <button class="agent-node" data-work-node="evidence" aria-pressed="false"><span class="tool-icon evidence-icon" aria-hidden="true">↗</span><span class="agent-copy"><b>Evidence linker</b><small>Connects source lines</small></span><span class="agent-result" data-agent-result>2 citations</span><i data-node-status>Ready</i></button>
    </div>
    <span class="mobile-flow" aria-hidden="true">↓ &nbsp; aggregate findings</span>

    <button class="flow-node evaluation-node" data-work-node="evaluation" aria-pressed="false">
      <span class="checklist-preview" aria-hidden="true"><i>✓</i><i>✓</i><i>✓</i></span>
      <b>LLM evaluation</b><small>Checks each finding against its source</small><i class="node-state" data-node-status>Ready</i>
    </button>
    <span class="mobile-flow" aria-hidden="true">↓ &nbsp; evaluation passed</span>
    <button class="flow-node human-node" data-work-node="human" aria-pressed="false">
      <span class="reviewer-preview" aria-hidden="true">JR</span>
      <b>Human approval</b><small>Reviewer checks the evidence</small><i class="node-state" data-node-status>Awaiting run</i>
    </button>
    <span class="mobile-flow" aria-hidden="true">↓ &nbsp; publish after approval</span>
    <button class="flow-node output-node" data-work-node="output" aria-pressed="false">
      <span class="output-preview" aria-hidden="true"><b>REVIEW SUMMARY</b><i>01&nbsp; Review cycle</i><i>02&nbsp; Ownership</i><span>2 SOURCES LINKED</span></span>
      <b>Reviewed output</b><small>Findings with source evidence</small><i class="node-state" data-node-status>Pending</i>
    </button>

  </div>

  <div class="workspace-detail" aria-live="polite" aria-atomic="true">
    <div class="detail-copy"><span class="workspace-kicker" data-detail-label>WORKFLOW STEP</span><strong data-detail-title>Orchestrator</strong><p data-detail-copy>Routes the request to focused agents, then brings their findings together for review.</p></div>
    <article class="detail-preview" aria-label="Selected workflow step sample output"><span class="preview-heading" data-preview-heading>ROUTING PLAN</span><ul data-preview-items><li>Read the April and May policy drafts</li><li>Compare changed clauses in parallel</li><li>Require source evidence before review</li></ul></article>
    <button class="human-approve" type="button" data-human-approve hidden>Approve sample output <span aria-hidden="true">→</span></button>
  </div>

  <div class="execution-trace" aria-label="Workflow execution trace">
    <span data-trace="0">Request</span><span data-trace="1">Route</span><span data-trace="2">Agents</span><span data-trace="3">Aggregate</span><span data-trace="4">Evaluate</span><span data-trace="5">Approve</span><span data-trace="6">Output</span>
  </div>

  <footer class="workspace-toolbar">
    <span>Deterministic local run · fictional policy data · no external API</span>
    <div><button type="button" data-run>Run demo</button><button type="button" data-pause disabled>Pause</button><button type="button" data-replay>Replay</button><button type="button" data-reset>Reset</button></div>
  </footer>
</section>

<script>
  const detailData: Record<string, { title: string; copy: string; heading: string; items: string[] }> = {
    input: { title: 'Request & source documents', copy: 'A sample request asks for the policy changes between two revisions.', heading: 'SAMPLE INPUT', items: ['“Compare the field operations policy drafts.”', 'April 2026 · revision 1.4', 'May 2026 · revision 1.5'] },
    orchestrator: { title: 'Orchestrator', copy: 'Routes the request to focused agents, then brings their findings together for review.', heading: 'ROUTING PLAN', items: ['Read both policy drafts', 'Compare changed clauses in parallel', 'Require source evidence before review'] },
    reader: { title: 'Document reader', copy: 'Finds matching passages in both fictional policy revisions for downstream review.', heading: 'INTERMEDIATE RESULT · READER', items: ['14 clauses indexed across both drafts', 'Matched clause 4.2 · review interval', 'Matched clause 7.1 · exception owner'] },
    compare: { title: 'Change analyst', copy: 'Pairs matching clauses and summarizes the two changes for a reviewer.', heading: 'INTERMEDIATE RESULT · COMPARISON', items: ['Review interval · 30 days → 90 days', 'Exception owner · regional lead → site lead', '2 changes sent for evidence checking'] },
    evidence: { title: 'Evidence linker', copy: 'Attaches each proposed change to the specific sample clauses that support it.', heading: 'INTERMEDIATE RESULT · SOURCES', items: ['Finding 01 · April §4.2 / May §4.2', 'Finding 02 · April §7.1 / May §7.1', '2 of 2 findings have linked evidence'] },
    evaluation: { title: 'LLM evaluation checkpoint', copy: 'A deterministic local check confirms each finding has a corresponding source reference.', heading: 'EVALUATION CHECKS', items: ['2 findings include source references', '2 clause pairs are present', 'Ready for human review'] },
    human: { title: 'Human approval checkpoint', copy: 'Review the sample findings and approve them to release the final output.', heading: 'REVIEW QUEUE', items: ['2 findings · 2 linked sources', 'Approval is required before output', 'This action stays in the local demo'] },
    output: { title: 'Final output with evidence', copy: 'The reviewed summary preserves both findings and their source references.', heading: 'REVIEWED SAMPLE OUTPUT', items: ['Review interval changed from 30 to 90 days · §4.2', 'Exception owner changed to site lead · §7.1', 'Approved sample · 2 sources attached'] },
  };

  document.querySelectorAll<HTMLElement>('[data-agent-workspace]').forEach((root) => {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('[data-work-node]')];
    const run = root.querySelector<HTMLButtonElement>('[data-run]');
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]');
    const state = root.querySelector<HTMLElement>('[data-run-state]');
    const connections = [...root.querySelectorAll<SVGPathElement>('[data-connection]')];
    const tokens = [...root.querySelectorAll<SVGCircleElement>('[data-flow-token]')];
    let timer = 0;
    let continuation: (() => void) | undefined;
    let paused = false;
    let active = false;
    let activeFlows: string[] = [];
    let pausedStage = '';
    let pausedLabel = '';

    const expand = root.querySelector<HTMLButtonElement>('[data-open-dialog]');
    if (expand && !root.closest('.product-page')) expand.hidden = true;

    const select = (key: string) => {
      const detail = detailData[key] ?? detailData.orchestrator;
      root.querySelector<HTMLElement>('[data-detail-title]')!.textContent = detail.title;
      root.querySelector<HTMLElement>('[data-detail-copy]')!.textContent = detail.copy;
      root.querySelector<HTMLElement>('[data-preview-heading]')!.textContent = detail.heading;
      const list = root.querySelector<HTMLUListElement>('[data-preview-items]')!;
      list.replaceChildren(...detail.items.map((text) => { const item = document.createElement('li'); item.textContent = text; return item; }));
      nodes.forEach((node) => node.setAttribute('aria-pressed', String(node.dataset.workNode === key)));
    };

    const setNode = (key: string, status: string, phase: 'idle' | 'active' | 'complete' | 'review' = 'idle') => {
      const node = nodes.find((item) => item.dataset.workNode === key);
      const statusEl = node?.querySelector<HTMLElement>('[data-node-status]');
      if (statusEl) statusEl.textContent = status;
      if (node) node.dataset.phase = phase;
    };

    const stopFlows = (clear = true) => {
      connections.forEach((path) => path.classList.remove('is-active'));
      tokens.forEach((token) => {
        token.querySelector<SVGAnimateMotionElement>('animateMotion')?.endElement();
        token.classList.remove('is-moving');
      });
      if (clear) activeFlows = [];
    };

    const animate = (...names: string[]) => {
      stopFlows();
      activeFlows = names;
      names.forEach((name) => {
        root.querySelector(`[data-connection="${name}"]`)?.classList.add('is-active');
        const token = root.querySelector<SVGCircleElement>(`[data-flow-token="${name}"]`);
        if (!token) return;
        token.classList.add('is-moving');
        token.querySelector<SVGAnimateMotionElement>('animateMotion')?.beginElement();
      });
    };

    const setStage = (stage: string, label: string) => {
      root.dataset.executionState = stage;
      if (state) state.textContent = label;
    };

    const schedule = (next: () => void, delay: number) => {
      continuation = next;
      timer = window.setTimeout(() => {
        if (paused) return;
        continuation = undefined;
        next();
      }, delay);
    };

    const markTrace = (step: number) => root.querySelector(`[data-trace="${step}"]`)?.classList.add('is-complete');

    const reset = () => {
      window.clearTimeout(timer);
      continuation = undefined;
      active = false;
      paused = false;
      root.dataset.executionState = 'idle';
      if (state) state.textContent = 'Ready to run';
      if (run) run.disabled = false;
      if (pause) { pause.disabled = true; pause.textContent = 'Pause'; }
      stopFlows();
      root.querySelectorAll<HTMLElement>('[data-phase]').forEach((node) => delete node.dataset.phase);
      const statuses: Record<string, string> = { input: 'Input ready', orchestrator: 'Ready', reader: 'Ready', compare: 'Ready', evidence: 'Ready', evaluation: 'Ready', human: 'Awaiting run', output: 'Pending' };
      Object.entries(statuses).forEach(([key, value]) => setNode(key, value));
      root.querySelectorAll('[data-trace]').forEach((item) => item.classList.remove('is-complete'));
      const approve = root.querySelector<HTMLButtonElement>('[data-human-approve]');
      if (approve) { approve.hidden = true; approve.disabled = false; }
      select('orchestrator');
    };

    const finish = () => {
      setNode('output', 'Complete', 'complete');
      markTrace(6);
      setStage('complete', 'Complete · approved output ready');
      active = false;
      continuation = undefined;
      if (run) run.disabled = false;
      if (pause) pause.disabled = true;
      stopFlows();
      select('output');
    };

    const waitForApproval = () => {
      setStage('approval', 'Waiting for human approval');
      setNode('evaluation', 'Passed · 2 findings checked', 'complete');
      setNode('human', 'Review required', 'review');
      animate('evaluation-human');
      markTrace(4);
      select('human');
      const approve = root.querySelector<HTMLButtonElement>('[data-human-approve]');
      if (approve) { approve.hidden = false; approve.disabled = paused; }
      markTrace(5);
    };

    const startOutput = () => {
      setStage('publishing', 'Approval recorded · preparing output');
      setNode('human', 'Approved locally', 'complete');
      if (pause) pause.disabled = false;
      animate('human-output');
      schedule(finish, 750);
    };

    const start = () => {
      reset();
      active = true;
      if (run) run.disabled = true;
      if (pause) pause.disabled = false;
      setStage('planning', 'Routing request');
      setNode('input', 'Sent', 'complete');
      setNode('orchestrator', 'Planning', 'active');
      select('orchestrator');
      animate('input-orchestrator');
      schedule(() => {
        markTrace(0); markTrace(1);
        setStage('parallel', 'Three agents working in parallel');
        setNode('orchestrator', 'Work dispatched', 'complete');
        ['reader', 'compare', 'evidence'].forEach((key) => setNode(key, 'Running', 'active'));
        select('reader');
        animate('dispatch-reader', 'dispatch-compare', 'dispatch-evidence');
        schedule(() => {
          ['reader', 'compare', 'evidence'].forEach((key) => setNode(key, 'Complete', 'complete'));
          markTrace(2);
          setStage('aggregation', 'Aggregating agent results');
          setNode('evaluation', 'Collecting evidence', 'active');
          select('compare');
          animate('merge-reader', 'merge-compare', 'merge-evidence');
          schedule(() => {
            markTrace(3);
            setStage('evaluation', 'Checking findings and evidence');
            setNode('evaluation', 'Evaluating', 'active');
            select('evaluation');
            stopFlows();
            schedule(waitForApproval, 850);
          }, 800);
        }, 1450);
      }, 650);
    };

    nodes.forEach((node) => node.addEventListener('click', () => select(node.dataset.workNode ?? 'orchestrator')));
    run?.addEventListener('click', start);
    root.querySelector('[data-replay]')?.addEventListener('click', start);
    root.querySelector('[data-reset]')?.addEventListener('click', reset);
    pause?.addEventListener('click', () => {
      if (!active && root.dataset.executionState !== 'approval') return;
      paused = !paused;
      pause.textContent = paused ? 'Resume' : 'Pause';
      if (paused) {
        pausedStage = root.dataset.executionState ?? 'running';
        pausedLabel = state?.textContent ?? 'Running sample';
        window.clearTimeout(timer);
        setStage('paused', 'Paused · sample state saved');
        stopFlows(false);
        const approve = root.querySelector<HTMLButtonElement>('[data-human-approve]');
        if (approve) approve.disabled = true;
      } else if (continuation) {
        setStage(pausedStage, pausedLabel);
        const approve = root.querySelector<HTMLButtonElement>('[data-human-approve]');
        if (approve) approve.disabled = false;
        if (activeFlows.length) animate(...activeFlows);
        schedule(continuation, 300);
      } else if (root.dataset.executionState === 'paused') {
        setStage(pausedStage || 'approval', pausedLabel || 'Waiting for human approval');
        if (activeFlows.length) animate(...activeFlows);
        const approve = root.querySelector<HTMLButtonElement>('[data-human-approve]');
        if (approve) approve.disabled = false;
      }
    });
    root.querySelector('[data-human-approve]')?.addEventListener('click', () => {
      if (paused || root.dataset.executionState !== 'approval') return;
      const approve = root.querySelector<HTMLButtonElement>('[data-human-approve]');
      if (approve) { approve.hidden = true; approve.disabled = false; }
      markTrace(5);
      startOutput();
    });
    reset();
  });
</script>

<style>
  .agent-workspace{--ink:#19232c;--muted:#66737c;--line:#d9ded9;--sage:#769181;--warm:#f4f3ee;overflow:hidden;border:1px solid #d4dad5;border-radius:18px;background:#f6f5f0;color:var(--ink);font-family:Geist,system-ui,sans-serif;box-shadow:0 24px 60px rgba(23,35,40,.12)}
  .workspace-head,.workspace-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 20px;border-bottom:1px solid var(--line)}.workspace-head h3{margin:5px 0 0;font-size:18px;letter-spacing:-.03em}.workspace-kicker{color:#728274;font-size:9px;font-weight:750;letter-spacing:.13em}.run-state{padding:7px 10px;border:1px solid #d5ddd5;border-radius:99px;color:#506657;background:#edf0e9;font-size:10px;font-weight:650}.workspace-expand{width:31px;height:31px;border:1px solid var(--line);border-radius:7px;background:#eef0ea;color:#293b34;font-size:15px;cursor:pointer}.workspace-expand[hidden]{display:none}
