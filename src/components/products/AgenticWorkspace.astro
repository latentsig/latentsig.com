<section class="agent-workspace" data-agent-workspace data-execution-state="idle" data-evaluation-mode="llm" aria-label="Interactive Agentic AI Studio workflow demonstration">
  <header class="workspace-head">
    <div><span class="workspace-kicker">INTERACTIVE DEMONSTRATION · FICTIONAL SAMPLE</span><h3>Agent workflow</h3></div>
    <span class="run-state" data-run-state aria-live="polite">Ready to run</span>
    <button class="workspace-expand" type="button" data-open-dialog aria-haspopup="dialog" aria-label="Open enlarged workflow workspace">⤢</button>
  </header>
  <div class="orchestration-canvas" aria-label="Input to parallel document and analytics agents, retrieval, merge, evaluation, human approval and reviewed output">
    <svg class="connections" viewBox="0 0 1200 500" preserveAspectRatio="none" aria-hidden="true">
      <defs><marker id="agent-flow-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9Z"/></marker></defs>
      <path data-connection="input-document" d="M105 250H154Q178 250 178 150H198" marker-end="url(#agent-flow-arrow)"/><path data-connection="input-analytics" d="M105 250H154Q178 250 178 350H198" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="document-retrieval" d="M358 150H398Q428 150 428 250H449" marker-end="url(#agent-flow-arrow)"/><path data-connection="analytics-retrieval" d="M358 350H398Q428 350 428 250H449" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="retrieval-merge" d="M569 250H601" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="merge-llm" d="M704 250H741Q767 250 767 170H790" marker-end="url(#agent-flow-arrow)"/><path data-connection="merge-manual" d="M704 250H741Q767 250 767 340H790" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="llm-approval" d="M926 170H962Q985 170 985 250H1000" marker-end="url(#agent-flow-arrow)"/><path data-connection="manual-approval" d="M926 340H962Q985 340 985 250H1000" marker-end="url(#agent-flow-arrow)"/>
      <path data-connection="approval-output" d="M1090 250H1120" marker-end="url(#agent-flow-arrow)"/>
      <circle class="flow-token" data-flow-token="input-document" r="5"><animateMotion dur=".75s" begin="indefinite" fill="freeze" path="M105 250H154Q178 250 178 150H198"/></circle><circle class="flow-token" data-flow-token="input-analytics" r="5"><animateMotion dur=".75s" begin="indefinite" fill="freeze" path="M105 250H154Q178 250 178 350H198"/></circle>
      <circle class="flow-token" data-flow-token="document-retrieval" r="5"><animateMotion dur=".8s" begin="indefinite" fill="freeze" path="M358 150H398Q428 150 428 250H449"/></circle><circle class="flow-token" data-flow-token="analytics-retrieval" r="5"><animateMotion dur=".8s" begin="indefinite" fill="freeze" path="M358 350H398Q428 350 428 250H449"/></circle>
      <circle class="flow-token" data-flow-token="retrieval-merge" r="5"><animateMotion dur=".65s" begin="indefinite" fill="freeze" path="M569 250H601"/></circle>
      <circle class="flow-token" data-flow-token="merge-llm" r="5"><animateMotion dur=".7s" begin="indefinite" fill="freeze" path="M704 250H741Q767 250 767 170H790"/></circle><circle class="flow-token" data-flow-token="merge-manual" r="5"><animateMotion dur=".7s" begin="indefinite" fill="freeze" path="M704 250H741Q767 250 767 340H790"/></circle>
      <circle class="flow-token" data-flow-token="llm-approval" r="5"><animateMotion dur=".65s" begin="indefinite" fill="freeze" path="M926 170H962Q985 170 985 250H1000"/></circle><circle class="flow-token" data-flow-token="manual-approval" r="5"><animateMotion dur=".65s" begin="indefinite" fill="freeze" path="M926 340H962Q985 340 985 250H1000"/></circle>
      <circle class="flow-token" data-flow-token="approval-output" r="5"><animateMotion dur=".65s" begin="indefinite" fill="freeze" path="M1090 250H1120"/></circle>
    </svg>
    <button class="flow-node input-node" data-work-node="input" aria-pressed="true"><span class="node-overline">INPUT</span><span class="mini-document" aria-hidden="true"><b>FIELD OPERATIONS · v1.5</b><i></i><i></i><i class="highlight"></i><i></i><small>Policy draft · 8 pages</small></span><span class="node-label">Compare revisions</span><i class="node-state" data-node-status>Ready</i></button>
    <span class="mobile-flow" aria-hidden="true">Parallel execution ↓</span>
    <div class="agent-pair" aria-label="Two specialist agents working in parallel"><span class="parallel-label"><i></i> PARALLEL AGENTS</span>
      <button class="flow-node agent-node" data-work-node="document" aria-pressed="false"><span class="agent-glyph" aria-hidden="true">▤</span><span class="node-label">Document agent</span><span class="node-visual document-thumb" aria-hidden="true"><i></i><i></i><i></i><i></i><b>§ 4.2</b></span><i class="node-state" data-node-status>Ready</i></button>
      <button class="flow-node agent-node" data-work-node="analytics" aria-pressed="false"><span class="agent-glyph chart-glyph" aria-hidden="true">▥</span><span class="node-label">Analytics agent</span><span class="node-visual analytics-thumb" aria-hidden="true"><i style="--bar:34%"></i><i style="--bar:54%"></i><i style="--bar:72%"></i><i style="--bar:94%"></i></span><i class="node-state" data-node-status>Ready</i></button>
    </div>
    <span class="mobile-flow" aria-hidden="true">Find supporting sources ↓</span>
    <button class="flow-node retrieval-node" data-work-node="retrieval" aria-pressed="false"><span class="node-overline">RAG / RETRIEVAL</span><span class="retrieval-thumb" aria-hidden="true"><i>§ 4.2</i><b>90 days</b><i>§ 7.1</i><b>Site lead</b></span><span class="node-label">Evidence search</span><small>2 cited passages</small><i class="node-state" data-node-status>Ready</i></button>
    <span class="mobile-flow" aria-hidden="true">Combine findings ↓</span>
    <button class="flow-node merge-node" data-work-node="merge" aria-pressed="false"><span class="merge-symbol" aria-hidden="true">＋</span><span class="node-label">Merge</span><span class="merge-count" aria-hidden="true">2 findings</span><i class="node-state" data-node-status>Ready</i></button>
    <span class="mobile-flow" aria-hidden="true">Choose evaluation ↓</span>
    <div class="evaluation-pair" aria-label="Choose an evaluation method"><span class="parallel-label">EVALUATION</span>
      <button class="flow-node evaluation-node" data-work-node="llm-evaluation" data-evaluation-choice="llm" aria-pressed="true"><span class="evaluation-mark" aria-hidden="true">✓</span><span class="node-label">LLM evaluation</span><small>Evidence checks</small><i class="node-state" data-node-status>Ready</i></button>
      <button class="flow-node evaluation-node manual-evaluation" data-work-node="manual-evaluation" data-evaluation-choice="manual" aria-pressed="false"><span class="evaluation-mark" aria-hidden="true">JR</span><span class="node-label">Human evaluation</span><small>Manual review</small><i class="node-state" data-node-status>Available</i></button>
    </div>
    <span class="mobile-flow" aria-hidden="true">Approval gate ↓</span>
    <button class="flow-node approval-node" data-work-node="approval" aria-pressed="false"><span class="approval-mark" aria-hidden="true">✓</span><span class="node-label">Human approval</span><small>Required to publish</small><i class="node-state" data-node-status>Waiting</i></button>
    <span class="mobile-flow" aria-hidden="true">Publish ↓</span>
    <button class="flow-node output-node" data-work-node="output" aria-pressed="false"><span class="node-overline">REVIEWED</span><span class="output-sheet" aria-hidden="true"><b>POLICY REVIEW</b><i>2 findings</i><i>2 sources</i><i class="approved">APPROVED</i></span><span class="node-label">Reviewed output</span><i class="node-state" data-node-status>Pending</i></button>
  </div>
  <section class="workspace-inspector" aria-live="polite" aria-atomic="true"><div class="inspector-copy"><span class="workspace-kicker">SELECTED STEP</span><strong data-detail-title>Input</strong><p data-detail-copy>Two policy revisions enter the workflow.</p><ul class="inspector-facts" data-preview-items><li>April · revision 1.4</li><li>May · revision 1.5</li></ul></div><div class="inspector-visual" data-preview-stage aria-label="Selected step visual preview"></div><button class="human-approve" type="button" data-human-approve hidden disabled>Approve &amp; publish <span aria-hidden="true">→</span></button></section>
  <footer class="workspace-toolbar"><span>Local interactive sample · deterministic data · no API required</span><div><button type="button" data-run>Run demo</button><button type="button" data-pause disabled>Pause</button><button type="button" data-replay>Replay</button><button type="button" data-reset>Reset</button></div></footer>
  <template data-preview-template="input"><div class="preview-document"><span class="preview-caption">SOURCE DOCUMENT · REVISION 1.5</span><b>Field operations policy</b><i></i><i></i><i class="highlight"></i><i></i><i></i><small>Clause 4.2 highlighted</small></div></template>
  <template data-preview-template="document"><div class="preview-document"><span class="preview-caption">DOCUMENT AGENT · EXTRACTED CLAUSE</span><b>§ 4.2 · Review interval</b><p>Scheduled reviews occur every <mark>90 days</mark>.</p><i></i><i></i><small>Matched to revision 1.4</small></div></template>
  <template data-preview-template="analytics"><div class="preview-chart"><span class="preview-caption">ANALYTICS AGENT · CHANGE SUMMARY</span><div class="chart-area"><i style="--bar:42%"></i><i style="--bar:65%"></i><i style="--bar:58%"></i><i style="--bar:88%"></i><i style="--bar:74%"></i></div><div class="chart-legend"><span>30 days</span><b>90 days</b></div></div></template>
  <template data-preview-template="retrieval"><div class="preview-evidence"><span class="preview-caption">RETRIEVAL · 2 SOURCE MATCHES</span><article><b>April · § 4.2</b><p>Review interval: every 30 days.</p></article><article><b>May · § 4.2</b><p>Review interval: every 90 days.</p></article></div></template>
  <template data-preview-template="merge"><div class="preview-merge"><span class="preview-caption">MERGED FINDINGS</span><article><b>01</b><span>Review interval <strong>30 → 90 days</strong></span></article><article><b>02</b><span>Exception owner <strong>Regional → Site lead</strong></span></article></div></template>
  <template data-preview-template="llm-evaluation"><div class="preview-checks"><span class="preview-caption">LLM EVALUATION · LOCAL SAMPLE</span><p><i>✓</i> Source linked</p><p><i>✓</i> Change supported</p><p><i>✓</i> Output complete</p><strong>Checks passed · 3 / 3</strong></div></template>
  <template data-preview-template="manual-evaluation"><div class="preview-manual"><span class="preview-caption">HUMAN EVALUATION · REVIEWER QUEUE</span><label><input type="checkbox" data-review-check> Finding matches cited source</label><label><input type="checkbox" data-review-check> Wording preserves the change</label><small>Complete both checks before approval.</small></div></template>
  <template data-preview-template="approval"><div class="preview-approval"><span class="preview-caption">HUMAN APPROVAL GATE</span><b>Reviewer: Jordan R.</b><p>2 findings · 2 cited sources</p><small>Output stays on hold until approval.</small></div></template>
  <template data-preview-template="output"><div class="preview-output"><span class="preview-caption">REVIEWED OUTPUT · APPROVED</span><b>Policy changes</b><p>Review interval <strong>30 → 90 days</strong> <small>§ 4.2</small></p><p>Exception owner <strong>Site lead</strong> <small>§ 7.1</small></p><span class="output-stamp">✓ REVIEWED</span></div></template>
</section>

<script>
  const agentStepData: Record<string, { title: string; copy: string; facts: string[]; visual: string }> = {
    input: { title: 'Input', copy: 'Two policy revisions enter the workflow.', facts: ['April · revision 1.4', 'May · revision 1.5'], visual: 'input' },
    document: { title: 'Document agent', copy: 'Extracts the changed clause from the source pages.', facts: ['Clause 4.2 · review interval', 'Clause 7.1 · exception owner'], visual: 'document' },
    analytics: { title: 'Analytics agent', copy: 'Summarizes the two changes for review.', facts: ['30 → 90 days', 'Regional → Site lead'], visual: 'analytics' },
    retrieval: { title: 'Retrieval agent', copy: 'Links each finding to the matching source passages.', facts: ['April · § 4.2', 'May · § 4.2 · 2 matches'], visual: 'retrieval' },
    merge: { title: 'Combined findings', copy: 'Parallel agent results are combined before evaluation.', facts: ['2 findings ready', '2 citations attached'], visual: 'merge' },
    'llm-evaluation': { title: 'LLM evaluation', copy: 'A local evaluator checks source links and completeness.', facts: ['Evidence linked', 'Change supported'], visual: 'llm-evaluation' },
    'manual-evaluation': { title: 'Human evaluation', copy: 'A reviewer checks each finding against its cited passage.', facts: ['Two checks required', 'Local sample review'], visual: 'manual-evaluation' },
    approval: { title: 'Human approval', copy: 'The sample stays on hold until a reviewer approves it.', facts: ['2 findings · 2 sources', 'Approval required to publish'], visual: 'approval' },
    output: { title: 'Reviewed output', copy: 'The approved summary retains its evidence references.', facts: ['Review interval · § 4.2', 'Exception owner · § 7.1'], visual: 'output' },
  };
  document.querySelectorAll<HTMLElement>('[data-agent-workspace]').forEach((root) => {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('[data-work-node]')];
    const run = root.querySelector<HTMLButtonElement>('[data-run]');
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]');
    const state = root.querySelector<HTMLElement>('[data-run-state]');
    const svg = root.querySelector<SVGSVGElement>('.connections');
    let timer = 0, continuation: (() => void) | undefined, dueAt = 0, remaining = 0, paused = false, active = false;
    const setStage = (stage: string, label: string) => { root.dataset.executionState = stage; if (state) state.textContent = label; };
    const setNode = (key: string, label: string, phase = 'idle') => {
      const node = nodes.find((item) => item.dataset.workNode === key);
      const status = node?.querySelector<HTMLElement>('[data-node-status]');
      if (status) status.textContent = label;
      if (node) node.dataset.phase = phase;
    };
    const updateApproval = () => {
      const approve = root.querySelector<HTMLButtonElement>('[data-human-approve]');
      if (!approve) return;
      const visible = root.dataset.executionState === 'approval';
      approve.hidden = !visible;
      const checks = [...root.querySelectorAll<HTMLInputElement>('[data-review-check]')];
      const ready = root.dataset.evaluationMode !== 'manual' || (checks.length === 2 && checks.every((check) => check.checked));
      approve.disabled = !visible || !ready;
    };
    const select = (key: string) => {
      const item = agentStepData[key] || agentStepData.input;
      root.querySelector<HTMLElement>('[data-detail-title]')!.textContent = item.title;
      root.querySelector<HTMLElement>('[data-detail-copy]')!.textContent = item.copy;
      const facts = root.querySelector<HTMLUListElement>('[data-preview-items]')!;
      facts.replaceChildren(...item.facts.map((text) => { const li = document.createElement('li'); li.textContent = text; return li; }));
      const visual = root.querySelector<HTMLElement>('[data-preview-stage]')!;
      const template = root.querySelector<HTMLTemplateElement>('[data-preview-template="' + item.visual + '"]')!;
      visual.replaceChildren(template.content.cloneNode(true));
      nodes.forEach((node) => node.setAttribute('aria-pressed', String(node.dataset.workNode === key)));
      root.dataset.selectedStep = key;
      updateApproval();
    };
    const clearFlows = () => {
      root.querySelectorAll<SVGPathElement>('[data-connection]').forEach((path) => path.classList.remove('is-active'));
      root.querySelectorAll<SVGCircleElement>('[data-flow-token]').forEach((token) => {
        try { token.querySelector<SVGAnimateMotionElement>('animateMotion')?.endElement(); } catch {}
        token.classList.remove('is-moving');
      });
    };
    const animate = (...names: string[]) => {
      clearFlows();
      names.forEach((name) => {
        root.querySelector<SVGPathElement>('[data-connection="' + name + '"]')?.classList.add('is-active');
        const token = root.querySelector<SVGCircleElement>('[data-flow-token="' + name + '"]');
        if (token) { token.classList.add('is-moving'); try { token.querySelector<SVGAnimateMotionElement>('animateMotion')?.beginElement(); } catch {} }
      });
    };
    const schedule = (next: () => void, delay: number) => {
      continuation = next; remaining = delay; dueAt = Date.now() + delay;
      timer = window.setTimeout(() => { continuation = undefined; remaining = 0; next(); }, delay);
    };
    const reset = () => {
      window.clearTimeout(timer); continuation = undefined; remaining = 0; paused = false; active = false;
      setStage('idle', 'Ready to run'); if (run) run.disabled = false;
      if (pause) { pause.disabled = true; pause.textContent = 'Pause'; }
      try { svg?.unpauseAnimations(); } catch {}
      clearFlows();
      nodes.forEach((node) => { delete node.dataset.phase; node.setAttribute('aria-pressed', 'false'); });
      const initial: Record<string, string> = { input: 'Ready', document: 'Ready', analytics: 'Ready', retrieval: 'Ready', merge: 'Ready', 'llm-evaluation': 'Ready', 'manual-evaluation': 'Available', approval: 'Waiting', output: 'Pending' };
      Object.entries(initial).forEach(([key, label]) => setNode(key, label));
      root.querySelectorAll<HTMLInputElement>('[data-review-check]').forEach((check) => { check.checked = false; });
      root.querySelectorAll<HTMLButtonElement>('[data-evaluation-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.evaluationChoice === root.dataset.evaluationMode)));
      select('input');
    };
    const finish = () => {
      setNode('approval', 'Approved', 'complete'); setNode('output', 'Complete', 'complete');
      setStage('complete', 'Reviewed output ready'); active = false;
      if (run) run.disabled = false; if (pause) pause.disabled = true;
      clearFlows(); select('output');
    };
    const runDemo = () => {
      const mode = root.dataset.evaluationMode || 'llm';
      reset(); root.dataset.evaluationMode = mode;
      root.querySelectorAll<HTMLButtonElement>('[data-evaluation-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.evaluationChoice === mode)));
      active = true; if (run) run.disabled = true; if (pause) pause.disabled = false;
      setStage('dispatch', 'Sending work to agents'); setNode('input', 'Sent', 'complete');
      setNode('document', 'Running', 'active'); setNode('analytics', 'Running', 'active'); select('input');
      animate('input-document', 'input-analytics');
      schedule(() => {
        setNode('document', 'Complete', 'complete'); setNode('analytics', 'Complete', 'complete');
        setStage('retrieval', 'Searching linked evidence'); setNode('retrieval', 'Searching', 'active'); select('retrieval');
        animate('document-retrieval', 'analytics-retrieval');
        schedule(() => {
          setNode('retrieval', '2 sources found', 'complete'); setStage('merge', 'Combining findings'); setNode('merge', 'Combining', 'active'); select('merge'); animate('retrieval-merge');
          schedule(() => {
            setNode('merge', '2 findings ready', 'complete');
            const chosen = mode === 'manual' ? 'manual-evaluation' : 'llm-evaluation';
            setNode(chosen, mode === 'manual' ? 'Review required' : 'Checking', mode === 'manual' ? 'review' : 'active');
            setStage(mode === 'manual' ? 'manual-evaluation' : 'llm-evaluation', mode === 'manual' ? 'Manual evaluation required' : 'Running LLM evaluation');
            select(chosen); animate(mode === 'manual' ? 'merge-manual' : 'merge-llm');
            schedule(() => {
              if (mode === 'llm') { setNode('llm-evaluation', 'Passed · 3 checks', 'complete'); animate('llm-approval'); }
              else { animate('manual-approval'); }
              setStage('approval', mode === 'manual' ? 'Review both findings, then approve' : 'LLM checks passed · review required');
              setNode('approval', 'Review required', 'review'); if (pause) pause.disabled = true;
              if (mode !== 'manual') select('approval');
            }, 850);
          }, 650);
        }, 950);
      }, 1250);
    };
    nodes.forEach((node) => node.addEventListener('click', () => {
      if (node.dataset.evaluationChoice) {
        if (active) return;
        root.dataset.evaluationMode = node.dataset.evaluationChoice;
        root.querySelectorAll<HTMLButtonElement>('[data-evaluation-choice]').forEach((choice) => choice.setAttribute('aria-pressed', String(choice === node)));
      }
      select(node.dataset.workNode || 'input');
    }));
    root.addEventListener('change', (event) => {
      if (!(event.target as HTMLElement).matches('[data-review-check]')) return;
      const checks = [...root.querySelectorAll<HTMLInputElement>('[data-review-check]')];
      if (root.dataset.executionState === 'manual-evaluation' && checks.length === 2 && checks.every((check) => check.checked)) {
        window.clearTimeout(timer); continuation = undefined;
        setNode('manual-evaluation', 'Reviewed · 2 checks', 'complete');
        setNode('approval', 'Review required', 'review');
        setStage('approval', 'Manual review complete · approval required');
        if (pause) pause.disabled = true;
        animate('manual-approval');
      }
      updateApproval();
    });
    run?.addEventListener('click', runDemo);
    root.querySelector('[data-replay]')?.addEventListener('click', runDemo);
    root.querySelector('[data-reset]')?.addEventListener('click', () => { root.dataset.evaluationMode = 'llm'; reset(); });
    root.querySelector('[data-human-approve]')?.addEventListener('click', () => {
      if (root.dataset.evaluationMode === 'manual') {
        const checks = [...root.querySelectorAll<HTMLInputElement>('[data-review-check]')];
        if (checks.length !== 2 || !checks.every((check) => check.checked)) return;
        setNode('manual-evaluation', 'Reviewed', 'complete');
      } else setNode('llm-evaluation', 'Passed · 3 checks', 'complete');
      setStage('publishing', 'Approval recorded · publishing'); setNode('approval', 'Approved', 'complete');
      if (pause) pause.disabled = false; animate('approval-output'); schedule(finish, 700);
    });
    pause?.addEventListener('click', () => {
      if (!active) return;
      paused = !paused;
      if (paused) {
        if (continuation) { remaining = Math.max(0, dueAt - Date.now()); window.clearTimeout(timer); }
        root.dataset.pausedStage = root.dataset.executionState; setStage('paused', 'Paused'); pause.textContent = 'Resume';
        try { svg?.pauseAnimations(); } catch {}
      } else {
        root.dataset.executionState = root.dataset.pausedStage || 'dispatch'; if (state) state.textContent = 'Agents working';
        pause.textContent = 'Pause'; try { svg?.unpauseAnimations(); } catch {}
        if (continuation) schedule(continuation, remaining);
      }
    });
    reset();
  });
</script>

<style>
.agent-workspace{--ink:#202a31;--muted:#68747a;--line:#e0e5e2;overflow:hidden;border:1px solid #dfe4e0;border-radius:16px;background:#fafbf9;color:var(--ink);font-family:Geist,system-ui,sans-serif;box-shadow:0 14px 38px rgba(24,38,35,.09)}
.workspace-head,.workspace-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 18px}.workspace-head{position:relative;border-bottom:1px solid var(--line);background:#fff}.workspace-head h3{margin:3px 0 0;font-size:17px;letter-spacing:-.025em}.workspace-kicker,.node-overline,.parallel-label,.preview-caption{color:#78837b;font-size:8px;font-weight:750;letter-spacing:.105em}.run-state{padding:7px 10px;border:1px solid #d8e1d9;border-radius:999px;background:#f5f8f4;color:#526d58;font-size:9px;font-weight:650}.workspace-expand{width:30px;height:30px;border:1px solid var(--line);border-radius:50%;background:#fff;color:#47544c;cursor:pointer}.workspace-expand[hidden]{display:none}
.orchestration-canvas{position:relative;display:grid;grid-template-columns:.72fr 1.35fr .9fr .62fr 1.05fr .82fr .78fr;align-items:center;gap:14px;min-height:350px;padding:36px 20px;background:linear-gradient(180deg,#f8faf8,#f3f6f4)}.connections{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}.connections path{fill:none;stroke:#c7d0cb;stroke-width:2;vector-effect:non-scaling-stroke}.connections path.is-active{stroke:#557b64;stroke-width:3}.connections marker path{fill:#557b64;stroke:none}.flow-token{fill:#527e5e;opacity:0;filter:drop-shadow(0 0 3px rgba(73,118,87,.4))}.flow-token.is-moving{opacity:1}
