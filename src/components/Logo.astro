---
interface Props {
  height?: number;
  showWordmark?: boolean;
  class?: string;
}

const { height = 32, showWordmark = true, class: className = '' } = Astro.props;
---

{showWordmark ? (
  <img
    src="/logo.png"
    alt="Latentsig"
    width={2778}
    height={950}
    style={`height: ${height}px; width: auto; max-width: none; aspect-ratio: 2778 / 950;`}
    class={className}
  />
) : (
  <div
    style={`height: ${height}px; width: ${height}px; overflow: hidden; border-radius: 10px; background: #10152d; display: grid; place-items: center;`}
    class={className}
  >
    <img
      src="/favicon.svg?v=2"
      alt="Latentsig"
      width={height}
      height={height}
      style="display:block; width:100%; height:100%; object-fit:cover;"
    />
  </div>
)}
