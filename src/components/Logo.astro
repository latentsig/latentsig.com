---
interface Props {
  height?: number;
  showWordmark?: boolean;
  class?: string;
}

const { height = 32, showWordmark = true, class: className = '' } = Astro.props;
---

{showWordmark ? (
  <img
    src="/logo.png"
    alt="Latentsig"
    height={height}
    style={`height: ${height}px; width: auto;`}
    class={className}
  />
) : (
  <div
    style={`height: ${height}px; width: ${height}px; overflow: hidden;`}
    class={className}
  >
    <img
      src="/logo.png"
      alt="Latentsig"
      height={height}
      style={`height: ${height}px; width: auto;`}
    />
  </div>
)}
