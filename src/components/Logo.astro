---
interface Props {
  height?: number;
  showWordmark?: boolean;
  class?: string;
}

const { height = 32, showWordmark = true, class: className = '' } = Astro.props;
---

{showWordmark ? (
  <img
    src="/latentsig-waveform-logo.png"
    alt="LatentSig"
    width={2168}
    height={725}
    style={`height: ${height}px; width: auto; max-width: 100%; aspect-ratio: 2168 / 725;`}
    class:list={['brand-wordmark', className]}
  />
) : (
  <img
    src="/latentsig-waveform-mark.png"
    alt="LatentSig"
    width={700}
    height={400}
    style={`height: ${height}px; width: ${height}px; aspect-ratio: 1;`}
    class:list={['brand-symbol', className]}
  />
)}

<style>
  .brand-wordmark{display:block;padding:5px 8px;border-radius:3px;background:#080c2b;object-fit:contain}
  .brand-symbol{display:block;padding:5px;border-radius:5px;background:#080c2b;object-fit:contain}
</style>
