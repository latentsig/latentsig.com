  @media(max-width:360px){.footer-grid{grid-template-columns:minmax(0,1fr)}.footer-brand,.footer-copyright{grid-column:1/-1}}
  @media(prefers-reduced-motion:reduce){.footer-video{visibility:hidden}.footer-socials a,.footer-group a{transition:none}}
