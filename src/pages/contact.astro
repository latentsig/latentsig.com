---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Latentsig AI" description="Get in touch with Latentsig AI.">
  <section class="relative overflow-hidden bg-grid-pattern">
    <div class="absolute inset-0 bg-gradient-to-b from-surface/40 via-surface/70 to-surface"></div>
    <div class="relative max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-24">
      <div class="flex flex-col gap-6 max-w-3xl">
        <span class="text-primary font-label-md text-label-md font-bold tracking-widest uppercase">Contact</span>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface leading-tight">
          Let's talk.
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          Tell us a little about what you're working on. We read everything that comes in.
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 bg-surface">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-12 gap-gutter">
      <div class="col-span-12 md:col-span-5 flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <span class="font-label-sm text-label-sm text-on-surface-variant tracking-widest uppercase">Email</span>
          <a href="mailto:hello@latentsig.com" class="font-headline-sm text-headline-sm text-primary hover:underline">hello@latentsig.com</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-label-sm text-label-sm text-on-surface-variant tracking-widest uppercase">Code</span>
          <a href="https://github.com/latentsig" target="_blank" rel="noopener" class="font-headline-sm text-headline-sm text-primary hover:underline">github.com/latentsig</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-label-sm text-label-sm text-on-surface-variant tracking-widest uppercase">Response time</span>
          <span class="font-body-lg text-body-lg text-on-surface">Usually within two business days.</span>
        </div>
      </div>
      <form class="col-span-12 md:col-span-7 flex flex-col gap-5 p-8 border border-outline-variant/30 rounded-2xl bg-surface-container-low" onsubmit="event.preventDefault(); window.location.href='mailto:hello@latentsig.com?subject=' + encodeURIComponent('Latentsig AI inquiry from ' + (document.getElementById('name').value || 'website')) + '&body=' + encodeURIComponent(document.getElementById('message').value + '\n\n— ' + document.getElementById('name').value + '\n' + document.getElementById('email').value);">
        <div class="flex flex-col gap-2">
          <label for="name" class="font-label-sm text-label-sm text-on-surface-variant tracking-widest uppercase">Name</label>
          <input id="name" required class="px-4 py-3 bg-surface-container border border-outline-variant/40 rounded-lg text-on-surface font-body-md focus:outline-none focus:border-primary" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="email" class="font-label-sm text-label-sm text-on-surface-variant tracking-widest uppercase">Email</label>
          <input id="email" type="email" required class="px-4 py-3 bg-surface-container border border-outline-variant/40 rounded-lg text-on-surface font-body-md focus:outline-none focus:border-primary" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="message" class="font-label-sm text-label-sm text-on-surface-variant tracking-widest uppercase">Message</label>
          <textarea id="message" rows="6" required class="px-4 py-3 bg-surface-container border border-outline-variant/40 rounded-lg text-on-surface font-body-md focus:outline-none focus:border-primary resize-y"></textarea>
        </div>
        <button class="self-start px-8 py-4 bg-primary text-on-primary font-label-md text-label-md font-bold rounded-lg hover:brightness-110 shadow-lg shadow-primary/20 transition-all">
          Send via email
        </button>
        <p class="font-label-sm text-label-sm text-on-surface-variant">This form opens your mail client. We'll wire it to a real submit endpoint when you choose one.</p>
      </form>
    </div>
  </section>
</Layout>
