---
import Layout from '../layouts/Layout.astro';
import { CALENDLY_EMBED_URL } from '../consts';
---
<Layout title="Contact · LatentSig" description="Contact LatentSig to discuss an AI workflow, product direction, or implementation question.">
  <section class="contact-hero"><div class="contact-wrap"><p>CONTACT</p><h1>Let's talk about the work.</h1><span>Bring a product idea, a workflow, or a technical question. Choose a meeting time or email us directly.</span></div></section>
  <section class="booking"><div class="contact-wrap"><div class="booking-heading"><p>BOOK A MEETING</p><h2>Pick a time that works for you.</h2></div><div class="calendar-frame"><iframe src={CALENDLY_EMBED_URL} title="Schedule a meeting with LatentSig" width="100%" height="700" frameborder="0" loading="lazy"></iframe></div></div></section>
  <section class="contact-options"><div class="contact-wrap"><div><p>EMAIL</p><a href="mailto:latentsig@gmail.com">latentsig@gmail.com ↗</a><small>Your email app will open. The website does not submit or store messages.</small></div><div><p>PRODUCT CONTEXT</p><a href="/products/">Explore product directions ↗</a><small>Products marked as concepts are not represented as available software.</small></div><div><p>CODE</p><a href="https://github.com/latentsig" target="_blank" rel="noopener noreferrer">github.com/latentsig ↗</a><small>Public organization profile.</small></div></div></section>
</Layout>
<style>
  .contact-hero,.booking,.contact-options{padding:80px 24px;background:#0b1020;color:#f4f2ff;font-family:Geist,system-ui,sans-serif}.contact-wrap{max-width:1120px;margin:auto}.contact-hero{padding-top:100px;background:radial-gradient(ellipse at 70% 0,#3e377455,transparent 52%),#0b1020}.contact-hero p,.booking-heading p,.contact-options p{color:#c0c1ff;font-size:11px;font-weight:700;letter-spacing:.14em}.contact-hero h1{font:600 clamp(2.8rem,6vw,5rem)/1.02 'Hanken Grotesk',sans-serif;letter-spacing:-.04em;margin:18px 0}.contact-hero span{color:#bcbacf;font-size:17px;line-height:1.7}.booking{background:#080c18}.booking-heading{text-align:center;margin-bottom:28px}.booking-heading h2{font:600 clamp(1.9rem,4vw,3rem) 'Hanken Grotesk',sans-serif}.calendar-frame{max-width:920px;margin:auto;border:1px solid #3b3d55;border-radius:12px;padding:12px;background:#11182a;overflow:hidden}.calendar-frame iframe{border:0;border-radius:8px}.contact-options .contact-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.contact-options .contact-wrap>div{padding:20px;border:1px solid #383b51;border-radius:10px;background:#11182a}.contact-options a{color:#e1dfff;text-decoration:none;font-weight:650}.contact-options small{display:block;margin-top:12px;color:#9f9db3;line-height:1.5;font-size:12px}@media(max-width:700px){.contact-hero,.booking,.contact-options{padding:55px 18px}.contact-options .contact-wrap{grid-template-columns:1fr}.calendar-frame{padding:6px}.calendar-frame iframe{height:640px}}
</style>
