---
import Layout from '../layouts/Layout.astro';
import QuantizationBanner from '../components/QuantizationBanner.astro';

const posts = [
  {
    tag: 'Research',
    tagColor: 'primary',
    readTime: '12 min',
    title: 'Laya and RLCD: fast decisions for AI workflows',
    excerpt: 'How typed questions, encoder models, and probability-focused training can move bounded AI judgments into ordinary software.',
    author: 'Latentsig AI Research',
    href: '/insights/laya-rlcd-system-one/',
    image: '/images/research/laya/laya-rlcd-system-one-hero.jpg',
    imageAlt: 'Unstructured signals passing through a decision core into three probability distributions',
  },
  {
    tag: 'Research',
    tagColor: 'primary',
    readTime: '13 min',
    title: 'DFlash explained: how block-diffusion drafting makes LLMs generate faster',
    excerpt: 'A visual walkthrough of DFlash architecture, Apple Silicon and RTX execution, and what a Muse Spark integration would actually require.',
    author: 'Latentsig AI Research',
    href: '/insights/dflash-muse-spark-1-2/',
    image: '/images/research/dflash/dflash-muse-spark-hero.jpg',
    imageAlt: 'DFlash token blocks moving from sequential drafting to parallel verification',
  },
  {
    tag: 'Engineering',
    tagColor: 'tertiary',
    readTime: '16 min',
    title: 'INT8 post-training quantization without tears: a production checklist',
    excerpt: 'INT8 PTQ in prod is a workflow, not a switch. The six steps we run before any model ships at reduced precision.',
    author: 'Latentsig AI Eng',
    href: '/blog/quantization-without-tears/',
    image: undefined,
    visual: 'quantization',
  },
];
---

<Layout title="Insights &amp; Research · Latentsig AI" description="Engineering Journal: notes from the confluence of frontier AI theory and production practice.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-grid-pattern">
    <div class="absolute inset-0 bg-gradient-to-b from-surface/40 via-surface/70 to-surface"></div>
    <div class="relative max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-24">
      <div class="flex flex-col gap-6 max-w-4xl">
        <div class="inline-flex self-start items-center gap-3 px-4 py-1.5 rounded-full border border-outline-variant/40 bg-surface-container-low text-primary">
          <span class="material-symbols-outlined text-base">menu_book</span>
          <span class="font-label-sm text-label-sm tracking-widest uppercase">Engineering Journal</span>
        </div>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface leading-tight">Insights &amp; Research</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
          Exploring the confluence of frontier AI theory and the engineering realities of shipping it. Field notes, benchmarks, and the occasional opinion.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="py-24 bg-surface">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <span class="text-primary font-label-md text-label-md font-bold tracking-widest uppercase mb-8 block">Featured</span>
      <div class="grid grid-cols-12 gap-gutter">
        <div class="col-span-12 md:col-span-6 bg-surface-container-low border border-outline-variant/30 rounded-2xl overflow-hidden relative min-h-[400px]">
          <img src="/images/research/latent-signals/activation-manifold-hero.jpg" alt="Abstract layered activation manifolds revealing a coherent signal direction" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-secondary/10"></div>
          <div class="absolute inset-0 dot-grid-bg opacity-50"></div>
          <div class="absolute bottom-0 inset-x-0 h-1/2 bg-gradient-to-t from-surface to-transparent"></div>
        </div>
        <a href="/insights/latent-signals-activation-probing/" class="col-span-12 md:col-span-6 flex flex-col gap-6 justify-center group rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1 bg-primary/10 border border-primary/30 rounded text-primary font-label-sm text-label-sm">FEATURED RESEARCH</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">18 min read</span>
          </div>
          <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface group-hover:text-primary transition-colors">Latent Signals: what model internals tell us before the loss curve does</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant">A practical primer on activation probing during fine-tuning runs, and the early signals that predict whether your model is actually learning what you think it is.</p>
          <div class="flex items-center gap-3 pt-2">
            <div class="w-10 h-10 rounded-full bg-primary/20 border border-primary/40 flex items-center justify-center">
              <span class="material-symbols-outlined text-primary text-base">person</span>
            </div>
            <div class="flex flex-col">
              <span class="font-label-md text-label-md text-on-surface">Latentsig AI Research</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">May 2026</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="py-24 bg-surface-container-lowest">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="grid grid-cols-12 gap-gutter">
        {
          posts.map((p) => {
            const Tag = p.href ? 'a' : 'div';
            return (
            <Tag
              href={p.href}
              class="col-span-12 md:col-span-4 bg-surface-container-low border border-outline-variant/30 rounded-2xl overflow-hidden hover:border-primary transition-all flex flex-col group"
            >
              <div class={`h-48 relative overflow-hidden bg-gradient-to-br ${p.tagColor === 'primary' ? 'from-primary/20 to-surface-container' : p.tagColor === 'secondary' ? 'from-secondary/20 to-surface-container' : 'from-tertiary/20 to-surface-container'}`}>
                {p.visual === 'quantization' ? (
                  <QuantizationBanner compact />
                ) : p.image ? (
                  <>
                    <img src={p.image} alt={p.imageAlt} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-surface-container/60 to-transparent" />
                  </>
                ) : (
                  <div class="absolute inset-0 dot-grid-bg opacity-50" />
                )}
              </div>
              <div class="p-6 flex flex-col gap-4 flex-1">
                <div class="flex items-center gap-3">
                  <span
                    class={`px-3 py-1 rounded font-label-sm text-label-sm border ${
                      p.tagColor === 'primary'
                        ? 'bg-primary/10 border-primary/30 text-primary'
                        : p.tagColor === 'secondary'
                          ? 'bg-secondary/10 border-secondary/30 text-secondary'
                          : 'bg-tertiary/10 border-tertiary/30 text-tertiary'
                    }`}
                  >
                    {p.tag}
                  </span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant">{p.readTime}</span>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">{p.title}</h3>
                <p class="font-body-md text-body-md text-on-surface-variant line-clamp-3 flex-1">{p.excerpt}</p>
                <div class="flex items-center gap-2 pt-2 border-t border-outline-variant/20">
                  <span class="material-symbols-outlined text-on-surface-variant text-base">person</span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant">{p.author}</span>
                </div>
              </div>
            </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

</Layout>
