  body.home-visual .mega-panel{background:#101114!important;color:#fff!important;border-color:rgba(255,255,255,.16)!important;box-shadow:0 24px 80px rgba(0,0,0,.55);backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
  body.home-visual .product-discovery,body.home-visual .compact-content{background:transparent!important;color:#fff!important}
  body.home-visual .product-intro h2,body.home-visual .compact-inner h2,body.home-visual .mega-item{color:#fff!important}
  body.home-visual .product-intro p,body.home-visual .mega-item small{color:rgba(255,255,255,.58)!important}
  body.home-visual .product-menu-card{background:rgba(255,255,255,.035)!important;border-color:rgba(255,255,255,.14)!important}
  body.home-visual .product-title,body.home-visual .compact-items .mega-item{border-color:rgba(255,255,255,.12)!important}
