---
import Layout from '../layouts/Layout.astro';
import ObservatoryHero from '../components/hero/ObservatoryHero.astro';
import { CALENDLY_URL } from '../consts';
---

<Layout title="Latentsig AI" description="Bengaluru-based AI engineering and consulting for enterprise teams: R&D advisory, architecture, implementation, and on-site or remote engagements.">
  <ObservatoryHero />

  <!-- Vertical Logos -->
  <section class="py-10 border-y border-outline-variant/20 bg-surface-container-lowest">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <p class="font-label-sm text-label-sm text-center text-on-surface-variant mb-7 tracking-[0.2em] uppercase">Built for high-stakes industries</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        <a href="/solutions/healthcare/" class="group flex items-center justify-center gap-3 px-4 py-3.5 rounded-xl border border-outline-variant/20 bg-surface/60 text-on-surface-variant hover:text-on-surface hover:border-primary/50 transition-all duration-200">
          <span aria-hidden="true" class="material-symbols-outlined text-2xl text-primary/80 group-hover:text-primary transition-colors">biotech</span>
          <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Healthcare</span>
        </a>
        <a href="/solutions/industry/" class="group flex items-center justify-center gap-3 px-4 py-3.5 rounded-xl border border-outline-variant/20 bg-surface/60 text-on-surface-variant hover:text-on-surface hover:border-primary/50 transition-all duration-200">
          <span aria-hidden="true" class="material-symbols-outlined text-2xl text-primary/80 group-hover:text-primary transition-colors">precision_manufacturing</span>
          <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Industrial AI</span>
        </a>
        <a href="/solutions/retail/" class="group flex items-center justify-center gap-3 px-4 py-3.5 rounded-xl border border-outline-variant/20 bg-surface/60 text-on-surface-variant hover:text-on-surface hover:border-primary/50 transition-all duration-200">
          <span aria-hidden="true" class="material-symbols-outlined text-2xl text-primary/80 group-hover:text-primary transition-colors">shopping_cart</span>
          <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Retail</span>
        </a>
        <a href="/solutions/education/" class="group flex items-center justify-center gap-3 px-4 py-3.5 rounded-xl border border-outline-variant/20 bg-surface/60 text-on-surface-variant hover:text-on-surface hover:border-primary/50 transition-all duration-200">
          <span aria-hidden="true" class="material-symbols-outlined text-2xl text-primary/80 group-hover:text-primary transition-colors">school</span>
          <span class="font-label-md text-label-md font-semibold tracking-wider uppercase">Education</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Flagship Products -->
  <section class="py-24 bg-surface border-b border-outline-variant/20">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
        <div class="flex flex-col gap-3 max-w-2xl">
          <span class="text-primary font-label-md text-label-md font-bold tracking-widest uppercase">Products</span>
          <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Flagship Platforms &amp; Products</h2>
        </div>
        <a href="/demos/" class="inline-flex items-center gap-2 font-label-md text-label-md font-semibold text-primary hover:underline">
          <span>Explore interactive demos</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter">
        <article class="group flex flex-col rounded-2xl border border-outline-variant/30 bg-surface-container-low overflow-hidden hover:border-primary/60 transition-all duration-300">
          <a href="/demos/#agentic-ai-platform" class="block aspect-[16/10] overflow-hidden bg-surface-container-lowest border-b border-outline-variant/20">
            <img
              src="/images/nav/product-agentic-menu.webp"
              alt="Agentic AI Studio connected orchestration nodes"
              width="720"
              height="440"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-500"
            />
          </a>
          <div class="p-6 sm:p-8 flex flex-col flex-1 gap-4">
            <div class="flex items-center justify-between gap-3">
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">Agentic Workflows</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">Human checkpoints</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface">Agentic AI Studio</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Build agentic workflows through an intuitive visual UI or natural-language queries—with visible execution traces, tool calls, and human approval gates before actions reach production.
            </p>
            <div class="mt-auto pt-4 flex flex-wrap items-center gap-5 border-t border-outline-variant/20">
              <a href="/demos/#agentic-ai-platform" class="inline-flex items-center gap-1.5 font-label-md text-label-md font-semibold text-primary hover:underline">
                <span>Launch walkthrough</span><span aria-hidden="true">↗</span>
              </a>
              <a href="/products/agentic-ai-platform/" class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors">
                Product overview
              </a>
            </div>
          </div>
        </article>

        <article class="group flex flex-col rounded-2xl border border-outline-variant/30 bg-surface-container-low overflow-hidden hover:border-primary/60 transition-all duration-300">
          <a href="/demos/#annotation-verification" class="block aspect-[16/10] overflow-hidden bg-surface-container-lowest border-b border-outline-variant/20">
            <img
              src="/images/nav/product-annotation-menu.webp"
              alt="Annotation and Verification optical inspection and label review"
              width="720"
              height="440"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-500"
            />
          </a>
          <div class="p-6 sm:p-8 flex flex-col flex-1 gap-4">
            <div class="flex items-center justify-between gap-3">
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">Annotation &amp; Verification</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">Audited exports</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface">LatentVerify</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Surface label disagreements automatically, route edge cases to domain reviewers, and ship verified ground-truth datasets with full provenance.
            </p>
            <div class="mt-auto pt-4 flex flex-wrap items-center gap-5 border-t border-outline-variant/20">
              <a href="/demos/#annotation-verification" class="inline-flex items-center gap-1.5 font-label-md text-label-md font-semibold text-primary hover:underline">
                <span>Launch walkthrough</span><span aria-hidden="true">↗</span>
              </a>
              <a href="/products/annotation-verification/" class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors">
                Product overview
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Services Bento Grid -->
  <section class="py-24 bg-surface">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="flex flex-col mb-16 gap-4">
        <span class="text-primary font-label-md text-label-md font-bold tracking-widest uppercase">Expertise</span>
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Precision AI Services</h2>
      </div>
      <div class="grid grid-cols-12 gap-gutter">
        <a href="/rd-advisory/" class="col-span-12 md:col-span-7 group bg-surface-container-low border border-outline-variant/30 rounded-2xl p-6 sm:p-10 hover:border-primary transition-all duration-300 relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors"></div>
          <span aria-hidden="true" class="material-symbols-outlined text-primary text-5xl mb-8">query_stats</span>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">R&amp;D Advisory</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md mb-8">
            Strategic guidance for long-term AI roadmapping, patent strategy, and feasibility studies for emerging architectures.
          </p>
          <ul class="space-y-3 font-label-md text-label-md text-on-surface">
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Architecture Review</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Technology Scouting</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Governance &amp; Safety</li>
          </ul>
        </a>

        <a href="/implementation/" class="col-span-12 md:col-span-5 bg-surface-container-high border border-outline-variant/30 rounded-2xl p-6 sm:p-10 hover:border-secondary transition-all duration-300 block">
          <span aria-hidden="true" class="material-symbols-outlined text-secondary text-5xl mb-8">terminal</span>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Implementation</h3>
          <p class="font-body-md text-body-md text-on-surface-variant mb-8">
            Full-cycle engineering of production-ready AI systems.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">PyTorch</span>
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">CUDA</span>
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">Kubernetes</span>
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">LLMOps</span>
          </div>
        </a>

        <a href="/consulting/" class="col-span-12 md:col-span-4 bg-surface-container border border-outline-variant/30 rounded-2xl p-6 sm:p-10 hover:border-tertiary transition-all duration-300 block">
          <span aria-hidden="true" class="material-symbols-outlined text-tertiary text-5xl mb-8">group</span>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Consulting</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Deep-dive technical audits and workflow optimization for internal engineering teams.
          </p>
        </a>

        <div class="col-span-12 md:col-span-8 bg-surface-container-highest border border-outline-variant/30 rounded-2xl p-6 sm:p-10 flex flex-col justify-between overflow-hidden group">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Technical Rigour</h3>
              <p class="font-body-md text-body-md text-on-surface-variant">Performance metrics of deployed models</p>
            </div>
            <span aria-hidden="true" class="material-symbols-outlined text-primary-container">monitoring</span>
          </div>
          <div class="mt-12 h-32 flex items-end gap-1">
            <div class="flex-1 bg-primary/20 h-1/2 group-hover:h-3/4 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/30 h-2/3 group-hover:h-5/6 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary h-full group-hover:brightness-110 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/40 h-1/3 group-hover:h-1/2 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/20 h-2/3 group-hover:h-2/3 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/50 h-3/4 group-hover:h-full transition-all duration-500 rounded-t"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Latentsig AI -->
  <section class="py-24 bg-surface-container-lowest">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-12 gap-gutter items-center">
      <div class="col-span-12 lg:col-span-5 order-2 lg:order-1">
        <div class="w-full h-[500px] rounded-2xl border border-outline-variant/20 shadow-2xl bg-surface-container-low relative overflow-hidden">
          <div class="absolute inset-0 dot-grid-bg"></div>
          <div class="absolute inset-0 bg-gradient-to-br from-secondary/10 via-transparent to-primary/10"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="grid grid-cols-3 gap-3 p-8 w-full max-w-xs">
              {Array.from({ length: 9 }).map((_, i) => (
                <div class={`w-full aspect-square rounded border border-outline-variant/30 ${i === 4 ? 'bg-primary/30' : i % 2 === 0 ? 'bg-surface-container-high' : 'bg-surface-container'}`}></div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7 order-1 lg:order-2 flex flex-col gap-10">
        <div class="flex flex-col gap-4">
          <span class="text-secondary font-label-md text-label-md font-bold tracking-widest uppercase">The Latentsig AI Advantage</span>
          <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Engineered for Reliability</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant">
            We don't just "implement" AI; we engineer systems that are scalable, observable, and secure. Our team consists of researchers and engineers who have built at the edge of what's possible.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span aria-hidden="true" class="material-symbols-outlined text-primary">verified</span>
              Quality First
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Rigorous testing frameworks for non-deterministic systems.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span aria-hidden="true" class="material-symbols-outlined text-primary">encrypted</span>
              Secure IP
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Your data and weights remain entirely under your control.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span aria-hidden="true" class="material-symbols-outlined text-primary">speed</span>
              Optimization
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Reducing latency and compute costs by up to 60%.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span aria-hidden="true" class="material-symbols-outlined text-primary">settings_input_component</span>
              Modular Design
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Future-proof architecture that adapts to new model paradigms.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-primary/5"></div>
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-outline-variant/30 to-transparent"></div>
    <div class="relative max-w-4xl mx-auto px-margin-mobile text-center flex flex-col items-center gap-10">
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Ready to unlock your technical latent potential?</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        Schedule a deep-dive technical consultation with our engineering leads to discuss your AI roadmap and implementation challenges.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={CALENDLY_URL} target="_blank" rel="noopener" class="px-10 py-5 bg-primary text-on-primary font-label-md text-label-md font-bold rounded-lg hover:brightness-110 shadow-lg shadow-primary/20 transition-all">
          Schedule a Consultation
        </a>
        <a href="/insights/" class="px-10 py-5 border border-outline-variant text-on-surface font-label-md text-label-md font-bold rounded-lg hover:bg-surface-container transition-all">
          View Insights
        </a>
      </div>
    </div>
  </section>
</Layout>
