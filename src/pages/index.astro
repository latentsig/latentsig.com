  body.home-visual .site-header{position:fixed;top:0;left:0;right:0;width:100%;box-sizing:border-box;display:flex;justify-content:center;background:transparent!important;border:0!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;pointer-events:none;z-index:60}
  body.home-visual .site-nav{pointer-events:auto;position:relative;max-width:1040px;width:calc(100% - 24px)!important;height:66px;margin:14px auto 0!important;padding:0 16px 0 20px!important;box-sizing:border-box!important;border:1px solid rgba(17,19,24,.1);border-radius:999px!important;background:rgba(255,255,255,.96);box-shadow:0 10px 32px rgba(0,0,0,.18);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:space-between;gap:12px}
