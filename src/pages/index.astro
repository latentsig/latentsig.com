---
import Layout from '../layouts/Layout.astro';
import ObservatoryHero from '../components/hero/ObservatoryHero.astro';
import { BOOK_DEMO_URL } from '../consts';

const verticals = [
  {
    name: 'Healthcare',
    href: '/solutions/healthcare/',
    image: '/images/nav/solutions-healthcare.webp',
    summary: 'Clinical record review with cited evidence and clinician sign-off.',
  },
  {
    name: 'Industrial AI',
    href: '/solutions/industry/',
    image: '/images/nav/solutions-industry.webp',
    summary: 'Visual quality inspection and operations checklists with audit trails.',
  },
  {
    name: 'Retail',
    href: '/solutions/retail/',
    image: '/images/nav/solutions-retail.webp',
    summary: 'Catalog attribute extraction and taxonomy verification at scale.',
  },
  {
    name: 'Education',
    href: '/solutions/education/',
    image: '/images/nav/solutions-education.webp',
    summary: 'Curriculum tagging and learning-content review guided by educators.',
  },
];

const services = [
  {
    title: 'Applied AI Research & Model Engineering',
    href: '/rd-advisory/',
    summary: 'Architecture reviews, custom evaluation harnesses, feasibility studies, and safety governance for teams working near the frontier.',
    cta: 'Explore research',
  },
  {
    title: 'Production AI Implementation',
    href: '/implementation/',
    summary: 'Full-cycle engineering for PyTorch, CUDA, Kubernetes, and LLMOps pipelines built for low latency, observability, and uptime.',
    cta: 'Explore implementation',
  },
  {
    title: 'Embedded AI Consulting',
    href: '/consulting/',
    summary: 'Senior engineers working directly inside your team to audit reliability, optimize serving costs, and unblock critical launches.',
    cta: 'Explore consulting',
  },
];

const principles = [
  {
    title: 'Evaluation before deployment',
    body: 'Every model and agent ships behind automated evaluation contracts and human review gates so regressions are caught before users see them.',
  },
  {
    title: 'Your data and weights stay yours',
    body: 'We architect inside your cloud or on-premises perimeter. Training sets, fine-tuned weights, and audit logs remain strictly under your control.',
  },
  {
    title: 'Measurable latency and cost discipline',
    body: 'Through quantization, routing, and serving optimization, we cut inference latency and compute overhead by up to 60 percent without sacrificing accuracy.',
  },
  {
    title: 'Modular across model generations',
    body: 'Clean abstractions around retrieval, tool contracts, and verification let you swap foundation models in days instead of rewriting your stack.',
  },
];
---

<Layout title="Latentsig AI" description="Latentsig AI builds observable agentic AI systems, LatentVerify for audited training data, and production AI engineering for enterprise teams.">
  <ObservatoryHero />

  <div class="home-editorial">
    <!-- Flagship Platforms & Products -->
    <section class="home-section" aria-labelledby="products-heading">
      <div class="home-shell">
        <div class="section-header">
          <h2 id="products-heading">Flagship Platforms &amp; Products</h2>
          <p>Two production workspaces built to make AI workflows observable and training data trustworthy.</p>
        </div>

        <div class="product-showcase">
          <article class="product-row">
            <a href="/demos/#agentic-ai-platform" class="product-media">
              <img
                src="/images/nav/product-agentic-studio.webp"
                alt="Agentic AI Studio centered modular orchestration hub"
                width="720"
                height="440"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="product-body">
              <h3>Agentic AI Studio</h3>
              <p>
                Build agentic workflows using a workflow editor that is intuitive or natural-language queries. Run parallel specialist agents with full execution traces, grounded citations, and human approval gates before actions reach production.
              </p>
              <ul class="product-points">
                <li>Author multi-agent pipelines visually or in plain language</li>
                <li>Inspect every tool call, handoff, and cited source in one trace</li>
                <li>Hold high-stakes outputs for domain sign-off before dispatch</li>
              </ul>
              <div class="product-links">
                <a href="/demos/#agentic-ai-platform" class="home-cta">Launch interactive studio <span aria-hidden="true">↗</span></a>
                <a href="/products/agentic-ai-platform/" class="home-text-link">Product overview</a>
              </div>
            </div>
          </article>

          <article class="product-row product-row-reverse">
            <a href="/demos/#annotation-verification" class="product-media">
              <img
                src="/images/nav/product-annotation-menu.webp"
                alt="LatentVerify optical inspection and label verification"
                width="720"
                height="440"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="product-body">
              <h3>LatentVerify</h3>
              <p>
                Catch label drift before it enters training. LatentVerify compares independent annotation passes, surfaces IoU disagreements automatically, and routes edge cases to expert reviewers for audit-ready ground truth.
              </p>
              <ul class="product-points">
                <li>Run dual-pass consensus across bounding boxes, masks, and text</li>
                <li>Route sub-threshold disagreements directly to senior reviewers</li>
                <li>Export verified datasets locked with full provenance hashes</li>
              </ul>
              <div class="product-links">
                <a href="/demos/#annotation-verification" class="home-cta">Launch LatentVerify <span aria-hidden="true">↗</span></a>
                <a href="/products/annotation-verification/" class="home-text-link">Product overview</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Engineering Practice -->
    <section class="home-section home-section-tinted" aria-labelledby="services-heading">
      <div class="home-shell">
        <div class="section-header">
          <h2 id="services-heading">From frontier research to production systems</h2>
          <p>Senior researchers and systems engineers partnering with enterprise teams across the full AI lifecycle.</p>
        </div>

        <div class="services-grid">
          {services.map((service) => (
            <a href={service.href} class="service-item">
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <span class="service-action">{service.cta} <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Built for High-Stakes Industries -->
    <section class="home-section" aria-labelledby="industries-heading">
      <div class="home-shell">
        <div class="section-header">
          <h2 id="industries-heading">Built for high-stakes industries</h2>
          <p>Applied AI workflows designed for domains where accuracy, auditability, and human oversight are non-negotiable.</p>
        </div>

        <div class="verticals-grid">
          {verticals.map((vertical) => (
            <a href={vertical.href} class="vertical-item">
              <div class="vertical-media">
                <img
                  src={vertical.image}
                  alt={`${vertical.name} AI workflow`}
                  width="640"
                  height="420"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="vertical-copy">
                <h3>{vertical.name} <span aria-hidden="true">↗</span></h3>
                <p>{vertical.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Engineering Principles -->
    <section class="home-section home-section-tinted" aria-labelledby="principles-heading">
      <div class="home-shell principles-layout">
        <div class="principles-lead">
          <h2 id="principles-heading">Engineered for systems that cannot fail silently</h2>
          <p>
            We do not bolt prototypes onto production stacks. Every engagement is built around observability, data integrity, and measurable operational discipline.
          </p>
        </div>

        <div class="principles-list">
          {principles.map((item) => (
            <article class="principle-row">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="home-cta-band" aria-labelledby="cta-heading">
      <div class="home-shell cta-inner">
        <h2 id="cta-heading">Bring us your hardest AI workflow</h2>
        <p>
          Meet directly with our engineering leads to walk through your architecture, data verification pipeline, or production roadmap.
        </p>
        <a href={BOOK_DEMO_URL} class="home-cta home-cta-lg">Book a technical walkthrough <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Strict 3-size body scale below hero:
     --text-heading: clamp(2rem, 3.4vw, 3rem)
     --text-body: 1rem (16px)
     --text-sm: 0.9375rem (15px) for compact secondary links/captions */
  .home-editorial {
    --text-heading: clamp(2rem, 3.4vw, 3rem);
    --text-body: 1rem;
    --text-sm: 0.9375rem;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    background: #0b1326;
    color: #edf0ff;
    font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
  }

  .home-shell {
    width: min(1280px, 100%);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
  }

  .home-section {
    padding: clamp(72px, 8vw, 120px) 0;
    border-top: 1px solid rgba(192, 193, 255, 0.14);
  }

  .home-section-tinted {
    background: #0f182e;
  }

  .section-header {
    max-width: 680px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .section-header h2,
  .principles-lead h2,
  .cta-inner h2 {
    margin: 0 0 16px;
    color: #f3f5ff;
    font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-heading);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .section-header p,
  .principles-lead p,
  .cta-inner p {
    margin: 0;
    max-width: 58ch;
    color: #bcc4dc;
    font-size: var(--text-body);
    line-height: 1.65;
  }

  /* Flagship Products Showcase */
  .product-showcase {
    display: grid;
    gap: clamp(56px, 6vw, 88px);
  }

  .product-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 4.5vw, 64px);
    align-items: center;
  }

  .product-row-reverse {
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  }

  .product-row-reverse .product-media {
    order: 2;
  }

  .product-row-reverse .product-body {
    order: 1;
  }

  .product-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(192, 193, 255, 0.2);
    background: #070d1d;
  }

  .product-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s var(--ease-out);
  }

  .product-media:hover img {
    transform: scale(1.035);
  }

  .product-body h3 {
    margin: 0 0 14px;
    color: #f3f5ff;
    font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-heading);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .product-body p {
    margin: 0 0 22px;
    max-width: 54ch;
    color: #bcc4dc;
    font-size: var(--text-body);
    line-height: 1.65;
  }

  .product-points {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    border-top: 1px solid rgba(192, 193, 255, 0.14);
    padding-top: 20px;
  }

  .product-points li {
    position: relative;
    padding-left: 18px;
    color: #dde3f7;
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .product-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c0c1ff;
  }

  .product-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .home-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    background: #c0c1ff;
    color: #090d2d;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .home-cta:hover {
    background: #dedfff;
    transform: translateY(-1px);
  }

  .home-cta-lg {
    min-height: 52px;
    padding: 0 28px;
    font-size: var(--text-body);
  }

  .home-text-link {
    color: #c8ccff;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.18s var(--ease-out);
  }

  .home-text-link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Engineering Services Index */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid rgba(192, 193, 255, 0.18);
  }

  .service-item {
    display: flex;
    flex-direction: column;
    padding: 32px 28px 32px 0;
    border-right: 1px solid rgba(192, 193, 255, 0.14);
    text-decoration: none;
    transition: background-color 0.2s var(--ease-out);
  }

  .service-item:not(:first-child) {
    padding-left: 28px;
  }

  .service-item:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .service-item h3 {
    margin: 0 0 12px;
    color: #f3f5ff;
    font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-body);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .service-item p {
    margin: 0 0 28px;
    color: #bcc4dc;
    font-size: var(--text-body);
    line-height: 1.65;
  }

  .service-action {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #c0c1ff;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .service-action span {
    transition: transform 0.2s var(--ease-out);
  }

  .service-item:hover .service-action span {
    transform: translate(3px, -3px);
  }

  /* Industries Photographic Grid */
  .verticals-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .vertical-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .vertical-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(192, 193, 255, 0.16);
    background: #070d1d;
    margin-bottom: 16px;
  }

  .vertical-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .vertical-item:hover .vertical-media img {
    transform: scale(1.045);
  }

  .vertical-copy h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 8px;
    color: #f3f5ff;
    font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-body);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .vertical-copy h3 span {
    color: #c0c1ff;
    transition: transform 0.2s var(--ease-out);
  }

  .vertical-item:hover .vertical-copy h3 span {
    transform: translate(2px, -2px);
  }

  .vertical-copy p {
    margin: 0;
    color: #bcc4dc;
    font-size: var(--text-body);
    line-height: 1.55;
  }

  /* Principles Split */
  .principles-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .principles-lead {
    position: sticky;
    top: 112px;
  }

  .principles-list {
    border-top: 1px solid rgba(192, 193, 255, 0.18);
  }

  .principle-row {
    padding: 26px 0;
    border-bottom: 1px solid rgba(192, 193, 255, 0.14);
  }

  .principle-row h3 {
    margin: 0 0 8px;
    color: #f3f5ff;
    font-family: 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-body);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .principle-row p {
    margin: 0;
    max-width: 58ch;
    color: #bcc4dc;
    font-size: var(--text-body);
    line-height: 1.65;
  }

  /* Closing CTA */
  .home-cta-band {
    padding: clamp(80px, 9vw, 128px) 0;
    border-top: 1px solid rgba(192, 193, 255, 0.16);
    background: radial-gradient(ellipse at 50% 0%, rgba(128, 131, 255, 0.14), transparent 64%), #0b1326;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .cta-inner h2 {
    margin-bottom: 0;
    max-width: 22ch;
  }

  .home-editorial :where(a):focus-visible {
    outline: 2px solid #c0c1ff;
    outline-offset: 4px;
  }

  @media (max-width: 1024px) {
    .product-row,
    .product-row-reverse,
    .principles-layout {
      grid-template-columns: 1fr;
    }

    .product-row-reverse .product-media,
    .product-row-reverse .product-body {
      order: initial;
    }

    .principles-lead {
      position: static;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-item,
    .service-item:not(:first-child),
    .service-item:last-child {
      padding: 28px 0;
      border-right: 0;
      border-bottom: 1px solid rgba(192, 193, 255, 0.14);
    }

    .verticals-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .verticals-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-media img,
    .vertical-media img,
    .home-cta,
    .home-text-link,
    .service-action span,
    .vertical-copy h3 span {
      transition: none;
    }
  }
</style>
