---
import Layout from '../layouts/Layout.astro';
import ObservatoryHero from '../components/hero/ObservatoryHero.astro';
---
<Layout title="LatentSig · AI Platforms, Intelligent Agents & Digital Applications" description="We research, design, and build AI systems, annotation and verification platforms, and web and mobile applications. From early exploration to practical implementation.">
  <ObservatoryHero />
  <section class="home-section products-section"><div class="home-wrap"><div class="section-heading"><p>PRODUCTS &amp; SOLUTIONS</p><h2>Two platforms. One team for your digital work.</h2><a href="/products/">Explore all products <span aria-hidden="true">↗</span></a></div><div class="home-product-grid">
    <a class="home-product" href="/products/annotation-verification/"><div class="home-card-art annotation-art" aria-hidden="true"><div class="annotation-canvas"><span class="road"></span><i class="vehicle v1"></i><i class="vehicle v2"></i><i class="vehicle v3"></i><b>CAR · SAMPLE</b><b>BUS · SAMPLE</b></div><aside><strong>DATA REVIEW</strong><span>Objects <b>Example</b></span><span>Labels <b>Concept</b></span><span>Review <b>Human</b></span></aside><small>CONCEPT WORKSPACE</small></div><small>PRODUCT CONCEPT</small><h3>Annotation &amp; Verification Platform</h3><p>From raw data to reviewed, reliable datasets.</p><span class="card-link">Explore concept ↗</span></a>
    <a class="home-product" href="/products/agentic-ai-platform/"><div class="home-card-art agentic-art" aria-hidden="true"><span class="flow-request">USER REQUEST</span><div class="agent-branches"><i></i><i></i><i></i></div><div class="agent-nodes"><b>PLAN</b><b>RETRIEVE</b><b>ACT</b></div><span class="flow-result">RESULT</span><span class="flow-route route-one"></span><span class="flow-route route-two"></span><span class="flow-route route-three"></span><small>WORKFLOW TRACE · CONCEPT</small></div><small>PRODUCT CONCEPT</small><h3>Agentic AI Platform</h3><p>Make AI workflows easier to reason about.</p><span class="card-link">Explore concept ↗</span></a>
    <a class="home-product" href="/solutions/web-mobile-apps/"><div class="home-card-art apps-art" aria-hidden="true"><div class="app-window"><span></span><span></span><span></span><div class="app-pane"><i></i><i></i><i></i></div><div class="app-content"><b></b><b></b><div><i></i><i></i><i></i></div></div></div><div class="app-phone"><span></span><i></i><b></b><b></b><b></b></div><small>WEB + MOBILE · CONCEPT</small></div><small>SOLUTION · APPLICATION DEVELOPMENT</small><h3>Web &amp; Mobile Applications</h3><p>Digital products designed around real work.</p><span class="card-link">Explore solution ↗</span></a>
  </div></div></section>
  <section class="home-section workflow-section"><div class="home-wrap"><div class="section-heading"><p>HOW IT WORKS</p><h2>See the work move from input to outcome.</h2><span class="workflow-note">Illustrative workflows · not live product screens</span></div><div class="workflow-showcase">
    <article class="workflow-track annotation-track"><div class="track-copy"><span>01 · DATA QUALITY</span><h3>Prepare dependable datasets.</h3><p>Bring source data into a clear annotation, review, and verification path.</p><a href="/products/annotation-verification/">Explore Annotation &amp; Verification ↗</a></div><div class="track-flow"><div class="flow-node source-node"><i class="mini-image"><b></b><b></b><b></b></i><span>Source data</span></div><span class="flow-line"><i></i></span><div class="flow-node label-node"><i class="target-box"></i><span>Annotate</span></div><span class="flow-line"><i></i></span><div class="flow-node verified-node"><i class="checkmark">✓</i><span>Review &amp; verify</span></div></div></article>
    <article class="workflow-track agent-track"><div class="track-copy"><span>02 · AGENTIC AI</span><h3>Coordinate bounded agent steps.</h3><p>Show the request, the work assigned to agents, and where people review progress.</p><a href="/products/agentic-ai-platform/">Explore Agentic AI ↗</a></div><div class="track-flow"><div class="flow-node source-node"><i class="request-symbol">↗</i><span>Request</span></div><span class="flow-line"><i></i></span><div class="flow-node planner-node"><i class="planner-symbol">✳</i><span>Plan &amp; route</span></div><span class="flow-line"><i></i></span><div class="flow-node verified-node"><i class="checkmark">✓</i><span>Reviewed result</span></div></div></article>
    <article class="workflow-track apps-track"><div class="track-copy"><span>03 · DIGITAL APPLICATIONS</span><h3>Turn user needs into useful tools.</h3><p>Move from product discovery through interface design and responsive implementation.</p><a href="/solutions/web-mobile-apps/">Explore Application Solutions ↗</a></div><div class="track-flow"><div class="flow-node source-node"><i class="brief-symbol">≡</i><span>User need</span></div><span class="flow-line"><i></i></span><div class="flow-node design-node"><i class="screen-symbol"><b></b></i><span>Design</span></div><span class="flow-line"><i></i></span><div class="flow-node verified-node"><i class="device-symbol">▯</i><span>Web + mobile</span></div></div></article>
  </div></div></section>
  <section class="home-section research-section"><div class="home-wrap"><div class="section-heading"><p>RESEARCH &amp; INSIGHTS</p><h2>Ideas with the engineering details attached.</h2><a href="/insights/">Read Insights <span aria-hidden="true">↗</span></a></div><div class="research-cards">
    <a href="/insights/laya-rlcd-system-one/"><img src="/images/research/laya/laya-rlcd-system-one-hero.jpg" alt="Illustration of signals flowing into a decision core" loading="lazy"/><span>RESEARCH</span><h3>Laya and RLCD: fast decisions for AI workflows</h3></a>
    <a href="/insights/dflash-muse-spark-1-2/"><img src="/images/research/dflash/dflash-muse-spark-hero.jpg" alt="DFlash token blocks moving through a speculative decoding workflow" loading="lazy"/><span>ENGINEERING</span><h3>DFlash explained: how block-diffusion drafting works</h3></a>
    <a href="/blog/quantization-without-tears/"><div class="research-placeholder" aria-hidden="true">INT8<br/>PTQ</div><span>ENGINEERING</span><h3>INT8 post-training quantization without tears</h3></a>
  </div></div></section>
  <section class="home-section services-section"><div class="home-wrap"><div class="section-heading"><p>HOW WE WORK</p><h2>Services for the steps between idea and implementation.</h2></div><div class="service-cards"><a href="/rd-advisory/"><span>01</span><h3>AI R&amp;D Advisory</h3><p>Explore feasibility, architecture, and research direction.</p><b>Explore service ↗</b></a><a href="/consulting/"><span>02</span><h3>AI Consulting</h3><p>Work through technical choices and workflow challenges.</p><b>Explore service ↗</b></a><a href="/implementation/"><span>03</span><h3>AI Implementation</h3><p>Design and build systems around practical requirements.</p><b>Explore service ↗</b></a></div></div></section>
  <section class="home-cta"><div class="home-wrap"><p class="section-kicker">START WITH THE PROBLEM</p><h2>What would you like to make possible?</h2><p>Bring us a workflow, a product idea, or a technical question. We can find a useful next step together.</p><div><a href="/contact/">Talk to LatentSig</a><a href="/demos/">Explore product demos</a></div></div></section>
</Layout>

<style>
  .home-section,.home-cta{font-family:Geist,system-ui,sans-serif}.home-wrap{max-width:1240px;margin:auto}.home-section{padding:82px 24px;background:#0b1020;color:#f2f0ff}.section-heading{display:grid;grid-template-columns:1fr auto;align-items:end;gap:4px 20px;margin-bottom:30px}.section-heading>p,.section-kicker{grid-column:1/-1;color:#c0c1ff;font-size:11px;letter-spacing:.15em;font-weight:700;margin:0 0 10px}.section-heading h2,.workflow-wrap h2,.home-cta h2{font:600 clamp(2.1rem,4vw,3.5rem)/1.08 'Hanken Grotesk',sans-serif;letter-spacing:-.035em;margin:0;max-width:810px}.section-heading>a{display:inline-flex;align-items:center;min-height:44px;color:#c0c1ff;text-decoration:none;font-size:13px;font-weight:700;white-space:nowrap}.home-product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.home-product{padding:13px 13px 22px;border-radius:11px;border:1px solid #373a50;background:#11182a;color:inherit;text-decoration:none;transition:border-color .18s,transform .18s}.home-product:hover{border-color:#8985cd;transform:translateY(-3px)}.product-graphic{height:182px;margin-bottom:20px;border-radius:7px;background:radial-gradient(ellipse at center,#39346c55,transparent 65%),#0b1020;display:flex;align-items:center;justify-content:center;gap:9px;color:#dedcff;font-size:9px;letter-spacing:.08em}.data-graphic{flex-wrap:wrap;padding:12px}.data-graphic span{padding:10px;border:1px solid #666195;border-radius:5px;background:#171b31}.data-graphic b{color:#c0c1ff}.agent-graphic{flex-direction:column;gap:3px}.agent-graphic span{padding:8px 18px;border:1px solid #656191;border-radius:30px}.agent-graphic i{color:#c0c1ff;font-style:normal}.app-graphic span{display:grid;place-items:center;width:39%;height:112px;border:1px solid #656191;border-radius:8px;background:linear-gradient(135deg,#252344,#11182a)}.home-product>small,.research-cards>a>span{font-size:10px;color:#c0c1ff;font-weight:700;letter-spacing:.13em}.home-product h3{font:600 20px/1.25 'Hanken Grotesk',sans-serif;margin:12px 0 8px}.home-product p{min-height:46px;color:#b7b5c9;font-size:13px;line-height:1.6}.card-link{display:block;margin-top:17px;color:#c0c1ff;font-weight:700;font-size:12px}.illustration-note{margin:14px 0 0;color:#9695aa;font-size:11px}.workflow-section{background:#080c18;border-block:1px solid #24293b}.workflow-wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:50px;align-items:center}.workflow-wrap>div:first-child>p:last-child,.home-cta .home-wrap>p:not(.section-kicker){color:#b7b5c9;line-height:1.7;font-size:15px}.workflow-steps{display:flex;align-items:center;gap:12px}.workflow-steps article{min-width:0;flex:1;padding:18px 14px;border:1px solid #383b51;border-radius:9px;background:#11182a}.workflow-steps article span,.service-cards>a>span{color:#c0c1ff;font-size:10px;letter-spacing:.1em}.workflow-steps h3{font:600 17px 'Hanken Grotesk',sans-serif;margin:13px 0 6px}.workflow-steps p{font-size:11px;line-height:1.5;color:#aaa9c1;margin:0}.workflow-steps>b{color:#c0c1ff}.research-section{background:#0e1424}.research-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.research-cards>a{overflow:hidden;border:1px solid #34394f;border-radius:10px;background:#11182a;color:inherit;text-decoration:none;padding-bottom:18px}.research-cards img,.research-placeholder{display:grid;width:100%;height:170px;object-fit:cover;margin-bottom:16px}.research-placeholder{place-content:center;background:radial-gradient(circle,#514889,#101628 70%);font:700 23px/1.5 Geist,sans-serif;text-align:center;color:#d5d2ff;letter-spacing:.15em}.research-cards>a>span,.research-cards h3{margin-left:17px;margin-right:17px}.research-cards h3{font:600 17px/1.35 'Hanken Grotesk',sans-serif;margin-top:9px;margin-bottom:0}.services-section{background:#0b1020}.service-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.service-cards>a{padding:23px;border:1px solid #35394e;border-radius:10px;background:#11182a;color:inherit;text-decoration:none}.service-cards h3{font:600 19px 'Hanken Grotesk',sans-serif}.service-cards p{color:#afadc1;font-size:13px;line-height:1.6;min-height:44px}.service-cards b{font-size:12px;color:#c0c1ff}.home-cta{padding:68px 24px;background:radial-gradient(ellipse at 75% 50%,#39326755,transparent 55%),#0a0e1d;color:#f4f2ff}.home-cta .home-wrap{padding:clamp(28px,6vw,62px);border:1px solid #393c55;border-radius:13px;background:#101629}.home-cta h2{max-width:800px}.home-cta .home-wrap>p:not(.section-kicker){max-width:700px}.home-cta .home-wrap>div{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}.home-cta a{display:inline-flex;align-items:center;min-height:46px;padding:0 17px;border-radius:7px;text-decoration:none;font-size:13px;font-weight:700;background:#c0c1ff;color:#17142f}.home-cta a+a{background:transparent;border:1px solid #4a4965;color:#e5e3f5}
  @media(max-width:800px){.home-product-grid,.research-cards{grid-template-columns:1fr 1fr}.workflow-wrap{grid-template-columns:1fr}.workflow-steps article{padding:15px 10px}}@media(max-width:540px){.home-section{padding:58px 18px}.home-product-grid,.research-cards,.service-cards{grid-template-columns:1fr}.section-heading{grid-template-columns:1fr}.workflow-steps{align-items:stretch;flex-direction:column}.workflow-steps>b{align-self:center;transform:rotate(90deg)}.research-cards img,.research-placeholder{height:190px}}
  .home-product{overflow:hidden}.workflow-steps article{position:relative;overflow:hidden}.workflow-steps article::after{content:"";position:absolute;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,#9aae70,#c6b1e4,#9aae70);transform:scaleX(0);transform-origin:left;animation:workflow-progress 5.4s ease-in-out infinite}.workflow-steps article:nth-of-type(2)::after{animation-delay:1.8s}.workflow-steps article:nth-of-type(3)::after{animation-delay:3.6s}.workflow-steps article>i{display:block;width:8px;height:8px;margin-top:14px;border:1px solid #89976e;border-radius:50%;background:#dce5c6;box-shadow:0 0 0 5px #89976e18;animation:workflow-pulse 2.6s ease-in-out infinite}.workflow-steps article:nth-of-type(2)>i{animation-delay:.35s}.workflow-steps article:nth-of-type(3)>i{animation-delay:.7s}@keyframes workflow-progress{0%,12%{transform:scaleX(0)}60%,90%{transform:scaleX(1)}100%{transform:scaleX(0)}}@keyframes workflow-pulse{0%,100%{box-shadow:0 0 0 4px #89976e12;transform:scale(.92)}50%{box-shadow:0 0 0 8px #89976e20;transform:scale(1.08)}}
  .home-card-art{position:relative;height:218px;overflow:hidden;border-radius:14px;margin-bottom:20px}.home-product:hover .home-card-art{filter:saturate(1.08)}
  .home-card-art>small{position:absolute;left:16px;bottom:14px;color:#697455;font-size:9px;letter-spacing:.12em;font-weight:700}
  .annotation-art{display:grid;grid-template-columns:minmax(0,1fr) 124px;gap:12px;align-items:center;padding:16px;background:linear-gradient(135deg,#202a36,#101820);color:#edf3f0}
  .annotation-canvas{position:relative;overflow:hidden;height:100%;border:1px solid #52616b;border-radius:8px;background:linear-gradient(150deg,#3c555d 0 24%,#253e47 25% 50%,#172b33 51%);}
  .annotation-canvas:before,.annotation-canvas:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 40px,#9ba8a22a 41px 42px),repeating-linear-gradient(90deg,transparent 0 60px,#9ba8a21a 61px 62px)}
  .annotation-canvas .road{position:absolute;left:37%;top:-18%;width:24%;height:140%;transform:rotate(32deg);background:linear-gradient(90deg,#66727a,#28383c);border-inline:2px solid #b8b59b88}
  .annotation-canvas .vehicle{position:absolute;z-index:1;width:20px;height:11px;border:1px solid #6fcaad;border-radius:3px;transform:rotate(32deg);box-shadow:0 0 0 3px #56b89824}.annotation-canvas .v1{left:41%;top:26%}.annotation-canvas .v2{left:52%;top:57%;border-color:#b69ade}.annotation-canvas .v3{left:35%;top:73%;width:28px}
  .annotation-canvas b{position:absolute;z-index:2;padding:4px 5px;border:1px solid #b49ce4;border-radius:3px;background:#111cdb;color:#f5efff;font-size:7px;font-weight:500}.annotation-canvas b:first-of-type{left:12px;top:34px}.annotation-canvas b:last-of-type{right:12px;bottom:32px;border-color:#71d0b0}
  .annotation-art aside{display:grid;gap:12px;font-size:9px;color:#b7c0c0}.annotation-art aside strong{color:#dbe6e3;font-size:8px;letter-spacing:.1em}.annotation-art aside span{padding-top:8px;border-top:1px solid #ffffff20}.annotation-art aside b{float:right;color:#a9d2ba}
  .agentic-art{display:flex;align-items:center;justify-content:space-between;padding:28px 18px 42px;background:radial-gradient(ellipse at 52% 48%,#313050,#171a26 65%);color:#f6f2ff}
  .flow-request,.flow-result{position:relative;z-index:2;display:grid;place-items:center;min-width:82px;min-height:42px;padding:0 8px;border:1px solid #8776ae;border-radius:8px;background:#232239;font-size:8px;letter-spacing:.08em}
  .flow-result{border-color:#8aab7c;background:#223026}.agent-branches{position:absolute;left:28%;right:28%;top:50%;height:1px;background:#8580a4}.agent-branches:before,.agent-branches:after{content:"";position:absolute;left:48%;width:1px;height:40px;background:#8580a4}.agent-branches:before{bottom:0}.agent-branches:after{top:0}
  .agent-nodes{z-index:1;display:grid;gap:24px}.agent-nodes b{min-width:74px;padding:9px;border:1px solid #5f587b;border-radius:6px;background:#28263a;color:#d7d0ee;text-align:center;font-size:8px;letter-spacing:.08em;font-weight:550}
  .flow-route{position:absolute;z-index:3;top:50%;left:21%;width:55%;height:2px;background:linear-gradient(90deg,transparent,#b7a4e9,transparent);animation:flow-glint 2.8s linear infinite}.route-two{animation-delay:.9s}.route-three{animation-delay:1.8s}
  .apps-art{display:flex;align-items:center;justify-content:center;gap:16px;background:linear-gradient(130deg,#ebe7dc,#d7decd)}
  .app-window{width:64%;height:148px;padding:12px;border:1px solid #c2c6ba;border-radius:9px;background:#fbfaf5;box-shadow:0 14px 28px #30332820;display:grid;grid-template-columns:48px 1fr;gap:12px}.app-window>span{grid-column:1/-1;width:100%;height:5px;border-radius:4px;background:linear-gradient(90deg,#9ba77c 0 11%,#dadcd2 11% 100%)}.app-window>span:not(:first-child){display:none}.app-pane{display:grid;align-content:start;gap:7px;padding:7px 5px;background:#efeee8;border-radius:5px}.app-pane i{height:5px;border-radius:4px;background:#cfd2c7}.app-content{display:grid;grid-template-columns:1fr 1fr;gap:7px;align-content:start}.app-content>b{height:23px;border:1px solid #e0e1d8;border-radius:5px;background:#fff}.app-content>div{grid-column:1/-1;height:59px;display:flex;align-items:end;gap:6px;padding:8px;border-radius:5px;background:#eeeee8}.app-content>div i{flex:1;border-radius:3px 3px 0 0;background:#a2b28b}.app-content>div i:nth-child(1){height:40%}.app-content>div i:nth-child(2){height:78%;background:#a8a0c3}.app-content>div i:nth-child(3){height:60%;background:#83946f}
  .app-phone{width:49px;height:112px;padding:10px 6px;border:2px solid #7c8278;border-radius:11px;background:#faf9f4;display:grid;align-content:start;gap:7px;box-shadow:0 9px 18px #3033281b}.app-phone span{width:15px;height:3px;margin:auto auto 4px;border-radius:4px;background:#bcc0b5}.app-phone i{height:24px;border-radius:4px;background:#dfe4d6}.app-phone b{height:7px;border-radius:4px;background:#e9e8e1}.app-phone b:first-of-type{background:#b2bd9f}
  .workflow-note{align-self:end;color:#777c6e;font-size:11px}.workflow-showcase{display:grid;gap:14px}.workflow-track{display:grid;grid-template-columns:minmax(230px,.7fr) minmax(0,1.3fr);align-items:center;gap:34px;padding:22px 26px;border:1px solid #dedbd1;border-radius:16px;background:#fffdf8;box-shadow:0 9px 28px #292c2509;transition:box-shadow .25s,transform .25s}.workflow-track:hover{transform:translateY(-2px);box-shadow:0 16px 36px #292c2513}.track-copy>span{color:#68774d;font-size:9px;letter-spacing:.13em;font-weight:700}.track-copy h3{margin:9px 0 7px;color:#292c25;font:500 21px/1.2 'Hanken Grotesk',sans-serif}.track-copy p{margin:0;color:#676b60;font-size:12px;line-height:1.55}.track-copy a{display:inline-block;margin-top:11px;color:#52633d;font-size:11px;font-weight:700;text-decoration:none}.track-flow{display:flex;align-items:center;gap:12px}.flow-node{position:relative;min-width:94px;min-height:86px;display:grid;place-items:center;align-content:center;gap:8px;padding:10px 7px;border:1px solid #e1ded5;border-radius:10px;background:#f9f7f1;color:#51564b;text-align:center;font-size:9px}.flow-line{position:relative;flex:1;min-width:18px;height:2px;background:#d6d7cf}.flow-line i{position:absolute;top:-3px;left:0;width:8px;height:8px;border-radius:50%;background:#8b78b2;box-shadow:0 0 0 4px #8b78b220;animation:track-particle 2.6s linear infinite}.flow-line:nth-of-type(2) i{animation-delay:1.3s}.source-node{border-color:#d8ddd1}.mini-image{position:relative;width:40px;height:30px;overflow:hidden;border-radius:4px;background:linear-gradient(145deg,#627a69 0 34%,#879b7e 35% 50%,#d4c9aa 51% 65%,#3b5258 66%)}.mini-image b{position:absolute;width:8px;height:6px;border:1px solid #c2a5ed}.mini-image b:nth-child(1){left:5px;top:7px}.mini-image b:nth-child(2){right:6px;top:14px;border-color:#a1d1a0}.mini-image b:nth-child(3){left:19px;top:4px}.target-box{width:29px;height:23px;border:1px solid #907bbb;border-radius:3px;box-shadow:0 0 0 4px #907bbb16}.checkmark{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#e3eadb;color:#68794d;font-size:15px;font-weight:700}.request-symbol,.planner-symbol,.brief-symbol,.device-symbol{display:grid;place-items:center;width:27px;height:27px;border-radius:8px;background:#eeebf5;color:#75659d;font-size:17px}.planner-symbol{background:#ecefe5;color:#677a4c}.screen-symbol{display:block;width:34px;height:25px;border:2px solid #7d8a67;border-radius:4px}.screen-symbol b{display:block;width:7px;height:7px;margin:8px auto;border-radius:2px;background:#9ba77c}.device-symbol{font-size:19px;background:#f1eee2;color:#8a7952}.annotation-track .flow-line i{background:#917bbb}.agent-track .flow-line i{background:#7b8c5c}.apps-track .flow-line i{background:#b18a57}
