---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Latent Sig — Engineering the Latent Potential of AI" description="Latent Sig provides enterprise-grade AI architecture, R&D advisory, and implementation for demanding technical environments.">
  <!-- Hero -->
  <section class="relative min-h-[80vh] flex items-center overflow-hidden bg-grid-pattern">
    <div class="absolute inset-0 bg-gradient-to-b from-surface/20 via-surface/60 to-surface"></div>
    <div class="relative max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-12 gap-gutter items-center py-24 w-full">
      <div class="col-span-12 lg:col-span-8 flex flex-col items-start gap-8">
        <div class="flex items-center gap-3 px-4 py-1.5 rounded-full border border-outline-variant/40 bg-surface-container-low text-primary">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-sm text-label-sm tracking-widest uppercase">Next-Gen AI Engineering</span>
        </div>
        <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface max-w-3xl leading-tight">
          Engineering the <span class="text-primary italic">Latent Potential</span> of AI.
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
          We bridge the gap between academic research and industrial deployment. Latent Sig provides enterprise-grade AI architecture, R&amp;D advisory, and implementation for the most demanding technical environments.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/contact" class="px-8 py-4 bg-primary-container text-on-primary-container font-label-md text-label-md font-bold rounded-lg flex items-center gap-2 hover:shadow-[0_0_20px_rgba(128,131,255,0.4)] transition-all">
            Partner with Us
            <span class="material-symbols-outlined">arrow_forward</span>
          </a>
          <a href="/implementation" class="px-8 py-4 border border-outline-variant text-on-surface font-label-md text-label-md font-bold rounded-lg hover:bg-surface-container-high transition-colors">
            Our Capabilities
          </a>
        </div>
      </div>
      <div class="hidden lg:flex col-span-4 relative h-[500px] items-center justify-center">
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-secondary/10 rounded-full blur-[120px]"></div>
        <div class="relative w-full h-full rounded-2xl border border-outline-variant/30 bg-surface-container-low overflow-hidden glass-panel">
          <div class="absolute inset-0 bg-grid-pattern opacity-50"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center">
              <div class="font-headline-xl text-[160px] leading-none text-primary opacity-90">λ</div>
              <div class="font-label-sm text-label-sm text-on-surface-variant tracking-[0.3em] uppercase mt-4">latent · signal</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vertical Logos -->
  <section class="py-12 border-y border-outline-variant/20 bg-surface-container-lowest">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <p class="font-label-sm text-label-sm text-center text-on-surface-variant mb-10 tracking-[0.2em] uppercase">Trusted by leaders across industries</p>
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition-all duration-500">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-4xl">finance_chip</span>
          <span class="font-headline-sm text-headline-sm font-bold">FINTECH</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-4xl">biotech</span>
          <span class="font-headline-sm text-headline-sm font-bold">HEALTHCARE</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-4xl">precision_manufacturing</span>
          <span class="font-headline-sm text-headline-sm font-bold">INDUSTRIALS</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-4xl">shopping_cart</span>
          <span class="font-headline-sm text-headline-sm font-bold">RETAIL</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Bento Grid -->
  <section class="py-32 bg-surface">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="flex flex-col mb-16 gap-4">
        <span class="text-primary font-label-md text-label-md font-bold tracking-widest uppercase">Expertise</span>
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Precision AI Services</h2>
      </div>
      <div class="grid grid-cols-12 gap-gutter">
        <a href="/rd-advisory" class="col-span-12 md:col-span-7 group bg-surface-container-low border border-outline-variant/30 rounded-2xl p-10 hover:border-primary transition-all duration-300 relative overflow-hidden">
          <div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors"></div>
          <span class="material-symbols-outlined text-primary text-5xl mb-8">query_stats</span>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">R&amp;D Advisory</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md mb-8">
            Strategic guidance for long-term AI roadmapping, patent strategy, and feasibility studies for emerging architectures.
          </p>
          <ul class="space-y-3 font-label-md text-label-md text-on-surface">
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Architecture Review</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Technology Scouting</li>
            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Governance &amp; Safety</li>
          </ul>
        </a>

        <a href="/implementation" class="col-span-12 md:col-span-5 bg-surface-container-high border border-outline-variant/30 rounded-2xl p-10 hover:border-secondary transition-all duration-300 block">
          <span class="material-symbols-outlined text-secondary text-5xl mb-8">terminal</span>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Implementation</h3>
          <p class="font-body-md text-body-md text-on-surface-variant mb-8">
            Full-cycle engineering of production-ready AI systems.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">PyTorch</span>
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">CUDA</span>
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">Kubernetes</span>
            <span class="px-3 py-1 bg-surface rounded text-on-surface-variant font-label-sm text-label-sm border border-outline-variant/20">LLMOps</span>
          </div>
        </a>

        <a href="/consulting" class="col-span-12 md:col-span-4 bg-surface-container border border-outline-variant/30 rounded-2xl p-10 hover:border-tertiary transition-all duration-300 block">
          <span class="material-symbols-outlined text-tertiary text-5xl mb-8">group</span>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Consulting</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Deep-dive technical audits and workflow optimization for internal engineering teams.
          </p>
        </a>

        <div class="col-span-12 md:col-span-8 bg-surface-container-highest border border-outline-variant/30 rounded-2xl p-10 flex flex-col justify-between overflow-hidden group">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Technical Rigour</h3>
              <p class="font-body-md text-body-md text-on-surface-variant">Performance metrics of deployed models</p>
            </div>
            <span class="material-symbols-outlined text-primary-container">monitoring</span>
          </div>
          <div class="mt-12 h-32 flex items-end gap-1">
            <div class="flex-1 bg-primary/20 h-1/2 group-hover:h-3/4 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/30 h-2/3 group-hover:h-5/6 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary h-full group-hover:brightness-110 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/40 h-1/3 group-hover:h-1/2 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/20 h-2/3 group-hover:h-2/3 transition-all duration-500 rounded-t"></div>
            <div class="flex-1 bg-primary/50 h-3/4 group-hover:h-full transition-all duration-500 rounded-t"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Latent Sig -->
  <section class="py-32 bg-surface-container-lowest">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-12 gap-gutter items-center">
      <div class="col-span-12 lg:col-span-5 order-2 lg:order-1">
        <div class="w-full h-[500px] rounded-2xl border border-outline-variant/20 shadow-2xl bg-surface-container-low relative overflow-hidden">
          <div class="absolute inset-0 dot-grid-bg"></div>
          <div class="absolute inset-0 bg-gradient-to-br from-secondary/10 via-transparent to-primary/10"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="grid grid-cols-3 gap-3 p-8">
              {Array.from({ length: 9 }).map((_, i) => (
                <div class={`w-16 h-16 rounded border border-outline-variant/30 ${i === 4 ? 'bg-primary/30' : i % 2 === 0 ? 'bg-surface-container-high' : 'bg-surface-container'}`}></div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7 order-1 lg:order-2 flex flex-col gap-10">
        <div class="flex flex-col gap-4">
          <span class="text-secondary font-label-md text-label-md font-bold tracking-widest uppercase">The Latent Sig Advantage</span>
          <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Engineered for Reliability</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant">
            We don't just "implement" AI; we engineer systems that are scalable, observable, and secure. Our team consists of researchers and engineers who have built at the edge of what's possible.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">verified</span>
              Quality First
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Rigorous testing frameworks for non-deterministic systems.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">encrypted</span>
              Secure IP
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Your data and weights remain entirely under your control.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">speed</span>
              Optimization
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Reducing latency and compute costs by up to 60%.</p>
          </div>
          <div class="flex flex-col gap-3">
            <span class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">settings_input_component</span>
              Modular Design
            </span>
            <p class="font-body-md text-body-md text-on-surface-variant">Future-proof architecture that adapts to new model paradigms.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-primary/5"></div>
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-outline-variant/30 to-transparent"></div>
    <div class="relative max-w-4xl mx-auto px-margin-mobile text-center flex flex-col items-center gap-10">
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Ready to unlock your technical latent potential?</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        Schedule a deep-dive technical consultation with our engineering leads to discuss your AI roadmap and implementation challenges.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="px-10 py-5 bg-primary text-on-primary font-label-md text-label-md font-bold rounded-lg hover:brightness-110 shadow-lg shadow-primary/20 transition-all">
          Schedule a Consultation
        </a>
        <a href="/insights" class="px-10 py-5 border border-outline-variant text-on-surface font-label-md text-label-md font-bold rounded-lg hover:bg-surface-container transition-all">
          View Insights
        </a>
      </div>
    </div>
  </section>
</Layout>
