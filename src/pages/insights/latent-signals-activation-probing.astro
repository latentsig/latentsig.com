  .back-link{display:inline-flex;align-items:center;gap:8px;margin-bottom:26px;color:#b9c1d5;text-decoration:none;font:500 14px/1 var(--body);transition:color .2s}.back-link:hover{color:var(--violet)}.back-link .material-symbols-outlined{font-size:18px}
