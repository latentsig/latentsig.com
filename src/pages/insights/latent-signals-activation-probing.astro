  .signal-strip{width:min(1280px,100%);margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);padding:0 clamp(22px,5vw,72px);border-bottom:1px solid var(--line)}.signal-strip>div{padding:35px 32px 36px 0;display:grid;grid-template-columns:34px 1fr;grid-template-rows:auto auto;column-gap:10px}.signal-strip>div+div{border-left:1px solid var(--line);padding-left:32px}.signal-strip span{grid-row:1/3;font:500 11px/1.3 var(--mono);color:var(--violet)}.signal-strip strong{font:600 15px/1.35 var(--serif)}.signal-strip small{font-size:13px;line-height:1.5;color:var(--muted);margin-top:5px}
