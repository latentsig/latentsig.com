  .system-figure,.case-study{margin:50px 0 60px;border:1px solid var(--line);border-radius:12px;background:#0b1527;overflow:hidden}.figure-heading{display:flex;align-items:center;gap:15px;padding:18px 21px;border-bottom:1px solid var(--line)}.figure-heading span{font:500 9px/1 var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--saffron)}.figure-heading b{font:600 14px/1.35 var(--display)}.system-figure figcaption{padding:16px 21px 18px;border-top:1px solid var(--line);font-size:12px;line-height:1.55;color:#909bb4}.reality-grid{display:grid;grid-template-columns:1fr 110px 1fr;padding:27px 23px 30px;align-items:stretch}.reality-column{padding:21px 19px;border:1px solid #2d3a54;border-radius:9px;background:#101b2f}.reality-column small{font:500 8px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:#7f8ca6}.reality-column strong{display:block;font:600 17px/1.3 var(--display);margin:15px 0 19px}.reality-column>div{display:flex;flex-wrap:wrap;gap:6px}.reality-column span{padding:7px 8px;border:1px solid #303d57;border-radius:5px;font:400 8px/1 var(--mono);color:#909bb4}.production-column{border-color:rgba(255,159,82,.36);background:linear-gradient(145deg,rgba(255,159,82,.08),#101b2f)}.production-column small{color:var(--saffron)}.production-column span{border-color:rgba(255,159,82,.22);color:#c4b5a7}.contact-zone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px}.contact-zone span{writing-mode:vertical-rl;transform:rotate(180deg);font:500 7px/1 var(--mono);letter-spacing:.13em;color:#66728d;margin-bottom:7px}.contact-zone i{display:block;width:42px;height:1px;background:linear-gradient(90deg,transparent,var(--saffron),transparent)}
