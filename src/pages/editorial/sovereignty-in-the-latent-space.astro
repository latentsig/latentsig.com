  .hero-inner{width:min(1380px,100%);margin:auto;padding:86px clamp(22px,5vw,72px) 80px;position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(430px,.85fr);gap:70px;align-items:center}.back-link{display:inline-flex;gap:8px;margin-bottom:31px;color:#b9c2d6;text-decoration:none;font:500 13px/1 var(--body)}.back-link:hover{color:var(--saffron)}.eyebrow-row{display:flex;gap:18px;margin-bottom:25px;font:500 10px/1 var(--mono);text-transform:uppercase;letter-spacing:.14em;color:var(--muted)}.eyebrow{color:var(--saffron);border-left:2px solid var(--saffron);padding-left:10px}.hero h1{font:600 clamp(55px,6.4vw,91px)/.97 var(--display);letter-spacing:-.052em;margin:0;max-width:820px;text-wrap:balance}.hero h1 em{display:block;font-style:normal;color:var(--ivory)}.dek{max-width:720px;margin:31px 0 37px;color:#c6ccdc;font-size:clamp(18px,2vw,21px);line-height:1.55}.author-row{display:flex;align-items:center;gap:13px}.author-mark{width:40px;height:40px;border:1px solid rgba(255,159,82,.42);background:rgba(255,159,82,.1);color:var(--saffron);border-radius:50%;display:grid;place-items:center;font:600 21px/1 var(--display)}.author-row>span:last-child{display:flex;flex-direction:column}.author-row strong{font-size:14px}.author-row small{font:400 11px/1.5 var(--mono);color:var(--muted);margin-top:2px}
  .sovereignty-console{border:1px solid rgba(169,171,255,.32);background:rgba(8,16,31,.78);box-shadow:0 30px 80px rgba(0,0,0,.32),inset 0 0 70px rgba(124,128,255,.05);backdrop-filter:blur(10px);border-radius:14px;overflow:hidden;transform:rotate(1deg)}.console-meta{display:flex;align-items:center;gap:16px;padding:14px 17px;border-bottom:1px solid var(--line);font:400 8px/1 var(--mono);letter-spacing:.1em;color:#77839f}.console-meta b{margin-left:auto;color:var(--ivory);font-weight:500}.console-stage{padding:29px 22px;display:grid;grid-template-columns:1fr 78px 1fr;align-items:stretch;min-height:285px}.dependency-side,.ownership-side{display:flex;flex-direction:column;gap:8px}.dependency-side small,.ownership-side small{font:500 8px/1 var(--mono);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}.dependency-side small{color:#7f8ba4}.ownership-side small{color:var(--green)}.dependency-side span,.ownership-side span{flex:1;min-height:51px;display:flex;align-items:center;padding:11px;border:1px solid #2b3851;border-radius:7px;background:#0d1729;font:500 10px/1.35 var(--mono)}.dependency-side span{color:#7e8aa3}.ownership-side span{color:#dbe9e3;border-color:rgba(113,198,154,.32);background:rgba(113,198,154,.06)}.signal-gate{display:grid;place-items:center;grid-template-rows:1fr 1fr 1fr auto 1fr 1fr 1fr;padding:0 18px}.signal-gate i{display:block;width:100%;height:1px;background:linear-gradient(90deg,rgba(124,128,255,.15),var(--violet),rgba(124,128,255,.15))}.signal-gate strong{writing-mode:vertical-rl;transform:rotate(180deg);font:500 8px/1 var(--mono);letter-spacing:.18em;color:var(--saffron);padding:8px 0}.console-footer{border-top:1px solid var(--line);padding:15px 17px;display:flex;align-items:center;justify-content:space-between;gap:16px}.console-footer span{font:500 8px/1 var(--mono);letter-spacing:.11em;color:var(--saffron)}.console-footer strong{font:600 11px/1.3 var(--display);color:#cdd3e6;text-align:right}

  .principle-strip{width:min(1280px,100%);margin:auto;padding:0 clamp(22px,5vw,72px);display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line)}.principle-strip>div{padding:35px 31px 38px 0;display:flex;flex-direction:column}.principle-strip>div+div{border-left:1px solid var(--line);padding-left:31px}.principle-strip small{font:500 9px/1 var(--mono);text-transform:uppercase;letter-spacing:.11em;color:var(--saffron)}.principle-strip strong{font:600 16px/1.35 var(--display);margin:12px 0 6px}.principle-strip span{font-size:12px;line-height:1.5;color:var(--muted)}
