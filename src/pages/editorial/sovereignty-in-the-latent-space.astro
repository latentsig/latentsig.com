  *{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.72 var(--body);text-rendering:optimizeLegibility}a{color:inherit}::selection{background:var(--saffron);color:#08101f}
