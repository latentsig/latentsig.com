---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout title={`${post.data.title} · Latentsig AI`} description={post.data.description}>
  <article class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-20">
    <div class="max-w-3xl mx-auto">
      <a href="/insights/" class="inline-flex items-center gap-2 font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors mb-10">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Insights
      </a>

      <header class="flex flex-col gap-6 mb-12">
        <div class="flex flex-wrap items-center gap-3">
          <span class="px-3 py-1 bg-primary/10 border border-primary/30 rounded text-primary font-label-sm text-label-sm">{post.data.tag}</span>
          {post.data.series && (
            <span class="font-label-sm text-label-sm text-on-surface-variant">{post.data.series}</span>
          )}
          <span class="font-label-sm text-label-sm text-on-surface-variant">{formattedDate}</span>
          <span class="font-label-sm text-label-sm text-on-surface-variant">· {post.data.readTime}</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface leading-tight">
          {post.data.title}
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">{post.data.description}</p>
        <div class="flex items-center gap-3 pt-2 border-t border-outline-variant/20">
          <div class="w-10 h-10 rounded-full bg-primary/20 border border-primary/40 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary text-base">person</span>
          </div>
          <div class="flex flex-col">
            <span class="font-label-md text-label-md text-on-surface">{post.data.author}</span>
            <span class="font-label-sm text-label-sm text-on-surface-variant">{formattedDate}</span>
          </div>
        </div>
      </header>

      <div class="blog-content">
        <Content />
      </div>

      <div class="mt-20 p-8 border border-outline-variant/30 rounded-2xl bg-surface-container-low text-center flex flex-col items-center gap-4">
        <h2 class="font-headline-md text-headline-md text-on-surface">Keep the engineering going.</h2>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
          Book a call with our engineering leads to pressure-test your own model-shipping workflow.
        </p>
        <a href="https://calendly.com/latentsig" target="_blank" rel="noopener" class="px-8 py-4 bg-primary text-on-primary font-label-md text-label-md font-bold rounded-lg hover:brightness-110 shadow-lg shadow-primary/20 transition-all">
          Book a consultation
        </a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .blog-content { color: var(--tw-color-on-surface); }
  .blog-content > * + * { margin-top: 1.25em; }
  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid rgba(70, 69, 84, 0.3);
    color: var(--tw-color-on-surface);
  }
  .blog-content h3 { font-size: 1.2rem; font-weight: 700; margin-top: 1.5em; color: var(--tw-color-on-surface); }
  .blog-content p { line-height: 1.75; color: var(--tw-color-on-surface-variant); }
  .blog-content p:has(> .katex:only-child) { text-align: center; margin: 1.5em 0; }
  .blog-content p:has(> .katex:only-child) > .katex { display: block; font-size: 1.05em; color: var(--tw-color-on-surface); }
  .blog-content strong { color: var(--tw-color-on-surface); }
  .blog-content em { color: var(--tw-color-on-surface-variant); }
  .blog-content a { color: var(--tw-color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .blog-content ul, .blog-content ol { padding-left: 1.5em; color: var(--tw-color-on-surface-variant); }
  .blog-content ul { list-style: disc; }
  .blog-content ol { list-style: decimal; }
  .blog-content li { margin: 0.4em 0; }
  .blog-content li > ul { margin-top: 0.4em; }
  .blog-content blockquote {
    border-left: 4px solid var(--tw-color-primary);
    padding-left: 1.25em;
    margin: 1.5em 0;
    color: var(--tw-color-on-surface-variant);
  }
  .blog-content blockquote strong { color: var(--tw-color-on-surface); }
  .blog-content img {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid rgba(70, 69, 84, 0.3);
    margin: 1.5em 0;
    display: block;
  }
  .blog-content code {
    background: var(--tw-color-surface-container);
    border: 1px solid rgba(70, 69, 84, 0.4);
    border-radius: 0.25rem;
    padding: 0.1em 0.35em;
    font-size: 0.875em;
    color: var(--tw-color-primary);
  }
  .blog-content pre {
    background: var(--tw-color-surface-container);
    border: 1px solid rgba(70, 69, 84, 0.3);
    border-radius: 0.5rem;
    padding: 1.25em;
    overflow-x: auto;
  }
  .blog-content pre code { background: transparent; border: none; padding: 0; color: var(--tw-color-on-surface); }
  .blog-content hr { border-color: rgba(70, 69, 84, 0.3); }
  .blog-content input[type='checkbox'] {
    accent-color: var(--tw-color-primary);
    margin-right: 0.5em;
    transform: translateY(1px);
  }
</style>
