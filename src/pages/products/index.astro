---
import Layout from '../../layouts/Layout.astro';
import AgenticWorkspace from '../../components/products/AgenticWorkspace.astro';
import AnnotationWorkspace from '../../components/products/AnnotationWorkspace.astro';

const products = [
  {
    kind: 'agentic' as const,
    name: 'Agentic AI Studio',
    headline: 'Keep AI workflows visible.',
    description: 'Build agentic workflows in an intuitive visual UI or with natural-language queries, inspect every run, and review outputs with supporting evidence.',
    href: '/products/agentic-ai-platform/',
    demo: '/demos/#agentic-ai-platform',
    id: 'agentic-ai-platform',
  },
  {
    kind: 'annotation' as const,
    name: 'LatentVerify',
    headline: 'Review the data behind the model.',
    description: 'Compare independent annotation passes, surface IoU disagreements, and export audit-ready ground truth.',
    href: '/products/annotation-verification/',
    demo: '/demos/#annotation-verification',
    id: 'annotation-verification',
  },
];
---

<Layout title="Products | Latentsig AI" description="Explore Agentic AI Studio and LatentVerify — production workspaces for observable multi-agent orchestration and verified training data.">
  <div class="products-page">
    <header class="products-intro"><span class="eyebrow">PRODUCTS  /  TWO WORKSPACES</span><h1>See the work, not just the promise.</h1><p>Explore Agentic AI Studio and LatentVerify through interactive production workspaces.</p></header>
    <div class="product-list">
      {products.map((product, index) => (
        <article class="product-row" data-catalog-product>
          <div class="product-copy"><span class="product-count">0{index + 1} / 02</span><h2>{product.name}</h2><h3>{product.headline}</h3><p>{product.description}</p><div class="product-actions"><a href={product.href}>Explore product <span aria-hidden="true">↗</span></a><a href={product.demo}>Launch demo <span aria-hidden="true">↗</span></a></div></div>
          <div class="product-visual"><button type="button" class="screen-launch" data-open-preview aria-label={`Open enlarged ${product.name} workspace`} aria-haspopup="dialog" aria-controls={`${product.id}-catalog-dialog`}><span>Open fullscreen workspace ↗</span></button>{product.kind === 'agentic' ? <AgenticWorkspace /> : <AnnotationWorkspace />}</div>
          <dialog id={`${product.id}-catalog-dialog`} class="catalog-dialog" data-preview-dialog aria-label={`${product.name} fullscreen workspace`}><div class="dialog-frame"><div class="dialog-head"><div><span class="eyebrow">INTERACTIVE WORKSPACE</span><h2>{product.name}</h2></div><button type="button" data-close-preview aria-label="Close fullscreen workspace">Close ×</button></div>{product.kind === 'agentic' ? <AgenticWorkspace /> : <AnnotationWorkspace />}</div></dialog>
        </article>
      ))}
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-catalog-product]').forEach((product) => {
    const open = product.querySelector<HTMLButtonElement>('[data-open-preview]');
    const close = product.querySelector<HTMLButtonElement>('[data-close-preview]');
    const dialog = product.querySelector<HTMLDialogElement>('[data-preview-dialog]');
    if (!open || !close || !dialog) return;
    open.addEventListener('click', () => { dialog.showModal(); close.focus(); });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => open.focus());
  });
</script>

<style>
  .products-page{min-height:100vh;background:#0b1326;color:#e9edff;font-family:Geist,system-ui,sans-serif}.products-intro,.product-list{width:min(1380px,100%);margin:auto;padding-left:clamp(20px,4.5vw,72px);padding-right:clamp(20px,4.5vw,72px)}.products-intro{padding-top:105px;padding-bottom:75px}.eyebrow{color:#afb3f2;font-size:11px;font-weight:700;letter-spacing:.13em}.products-intro h1{max-width:900px;margin:19px 0 16px;color:#edf0ff;font-family:'Hanken Grotesk',Geist,sans-serif;font-size:clamp(43px,6vw,78px);font-weight:600;line-height:1.05;letter-spacing:-.045em;text-wrap:balance}.products-intro p{max-width:600px;margin:0;color:#b7c2d9;font-size:clamp(16px,1.6vw,19px);line-height:1.6}.product-list{padding-bottom:110px}.product-row{display:grid;grid-template-columns:minmax(230px,.46fr) minmax(0,1.54fr);gap:clamp(22px,3.4vw,52px);align-items:center;padding:38px 0 58px;border-top:1px solid #38435e}.product-row:nth-child(2){border-bottom:1px solid #38435e}.product-copy{align-self:start;padding-top:15px}.product-count{color:#a9afe4;font-size:10px;font-weight:700;letter-spacing:.12em}.product-copy h2{margin:23px 0 10px;color:#f0f2ff;font-family:'Hanken Grotesk',Geist,sans-serif;font-size:clamp(29px,2.6vw,41px);font-weight:600;line-height:1.1;letter-spacing:-.035em}.product-copy h3{margin:0 0 13px;color:#c6c6ff;font-size:16px;font-weight:600}.product-copy p{max-width:350px;margin:0;color:#b1bdd5;font-size:13px;line-height:1.6}.product-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:25px}.product-actions a{display:inline-flex;align-items:center;gap:12px;min-height:43px;padding:8px 13px;border:1px solid #b9baff;border-radius:7px;background:#c0c1ff;color:#11163a;text-decoration:none;font-size:11px;font-weight:700;transition:transform .18s ease}.product-actions a:nth-child(2){background:#162039;color:#e9ebff;border-color:#5e698a}.product-actions a:hover{transform:translateY(-2px)}.product-visual{min-width:0}.screen-launch{display:block;margin:0 0 8px auto;padding:0;border:0;background:transparent;color:#c5c8fa;text-align:right;font-size:10px;font-weight:700;cursor:zoom-in}.product-visual>small{display:block;margin:8px 2px 0;color:#9aa5c1;font-size:10px}
  .catalog-dialog{width:min(1260px,calc(100vw - 32px));max-height:calc(100dvh - 32px);padding:0;border:1px solid #515b79;border-radius:18px;background:#0b1326;color:#edf0ff;overflow-y:auto;box-shadow:0 30px 100px rgba(0,0,0,.65)}.catalog-dialog::backdrop{background:rgba(4,8,20,.78);backdrop-filter:blur(5px)}.dialog-frame{padding:16px}.dialog-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.dialog-head h2{margin:5px 0 0;font-size:19px}.dialog-head button{min-height:40px;padding:8px 13px;border:1px solid #65708f;border-radius:7px;background:#202a43;color:#f2f2ff;font:600 12px Geist,sans-serif;cursor:pointer}
  :global(html.light-theme-preview) .catalog-dialog{filter:invert(1) hue-rotate(180deg)}
  :where(a,button):focus-visible{outline:3px solid #c4c5ff;outline-offset:4px}
  @media(max-width:1000px){.product-row{grid-template-columns:1fr;gap:28px}.product-copy{padding-top:0}.product-copy p{max-width:650px}}
  @media(max-width:600px){.products-intro{padding-top:58px;padding-bottom:54px}.product-row{padding:38px 0 55px}.product-actions a{flex:1;justify-content:center}.dialog-frame{padding:9px}.dialog-head{padding:6px}.dialog-head h2{font-size:15px}}
  @media(prefers-reduced-motion:reduce){.product-actions a,.screen-launch :global(.product-screen){transition:none}}
</style>
