---
import Layout from '../../layouts/Layout.astro';

const industries = {
  healthcare: { name:'Healthcare', index:'01', image:'/images/nav/solutions-healthcare.webp', headline:'Make clinical review easier to inspect.', summary:'A structured workflow for reviewing records, highlighting relevant passages, and routing decisions to clinical reviewers.', note:'Clinical review · human-in-the-loop verification', steps:['Clinical document','Highlight evidence','Human verification'], accent:'#91d5c3', visual:'medical' },
  industry: { name:'Industrial AI', index:'02', image:'/images/nav/solutions-industry.webp', headline:'Bring inspection evidence into view.', summary:'A structured inspection workflow connects visual observations and sensor checks to auditable quality decisions.', note:'Industrial AI · visual QA & operations review', steps:['Inspection image','Flag checklist item','Reviewer decision'], accent:'#e0bc83', visual:'factory' },
  retail: { name:'Retail', index:'03', image:'/images/nav/solutions-retail.webp', headline:'Turn product data into reviewed labels.', summary:'A catalog workflow tags product attributes from source specs and routes edge cases for rapid verification.', note:'Retail · catalog taxonomy & attribute QA', steps:['Catalog item','Attribute labels','Verified export'], accent:'#e4a78d', visual:'catalog' },
  education: { name:'Education', index:'04', image:'/images/nav/solutions-education.webp', headline:'Review learning content with context.', summary:'A curriculum workflow pairs each learning item with topic and difficulty labels for educator sign-off.', note:'Education · curriculum tagging & review', steps:['Learning item','Topic annotation','Educator review'], accent:'#a9b3e9', visual:'learning' },
} as const;
export function getStaticPaths() { return ['healthcare','industry','retail','education'].map((industry) => ({ params:{ industry }, props:{ industry } })); }
const { industry } = Astro.props;
const data = industries[industry as keyof typeof industries];
---

<Layout title={`${data.name} Solutions | Latentsig AI`} description={data.summary}>
  <main class={`industry-page ${data.visual}`} style={`--industry-accent:${data.accent}`}>
    <div class="industry-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/solutions/">Solutions</a><span aria-hidden="true">/</span><span>{data.name}</span></nav>
      <section class="industry-hero">
        <div class="industry-copy"><span class="eyebrow">{data.name.toUpperCase()} · {data.index}</span><h1>{data.headline}</h1><p>{data.summary}</p><span class="scenario-note">{data.note}</span><div class="industry-actions"><a href="/products/annotation-verification/">Explore LatentVerify <span>↗</span></a><a href="/contact/">Discuss your workflow <span>↗</span></a></div></div>
        <figure class="industry-visual"><img src={data.image} alt={`${data.name} workflow preview`} fetchpriority="high"/><span class="visual-wash"></span><span class="scan-line" aria-hidden="true"></span><span class="visual-target target-one" aria-hidden="true"></span><span class="visual-target target-two" aria-hidden="true"></span><figcaption><span>PRODUCTION WORKFLOW</span><span>{data.name.toUpperCase()} / VERIFIED REVIEW</span></figcaption></figure>
      </section>
      <section class="workflow" aria-label={`${data.name} workflow`}><header><span class="eyebrow">WORKFLOW ARCHITECTURE</span><h2>Source, annotation, review.</h2></header><ol>{data.steps.map((step,index)=><li><span>0{index+1}</span><b>{step}</b>{index < data.steps.length-1 && <i aria-hidden="true">→</i>}</li>)}</ol></section>
      <nav class="industry-switch" aria-label="Explore other industries">{Object.entries(industries).map(([key,item])=><a class:list={{'is-current':key===industry}} href={`/solutions/${key}/`}>{item.name}<span aria-hidden="true">↗</span></a>)}</nav>
    </div>
  </main>
</Layout>

<style>
  .industry-page{min-height:100vh;background:#0b1326;color:#edf0ff;font-family:Geist,system-ui,sans-serif}.industry-inner{width:min(1320px,calc(100% - 48px));margin:auto}.breadcrumbs{display:flex;gap:10px;padding-top:110px;color:#8d9bb8;font-size:11px}.breadcrumbs a{color:#c4c6ff;text-decoration:none}.industry-hero{display:grid;grid-template-columns:.84fr 1.16fr;align-items:center;gap:clamp(35px,6vw,90px);padding:45px 0 85px}.eyebrow{color:var(--industry-accent);font-size:10px;font-weight:750;letter-spacing:.14em}.industry-copy h1{max-width:590px;margin:18px 0;color:#f0f2ff;font:600 clamp(42px,5.2vw,70px)/1.04 'Hanken Grotesk',Geist,sans-serif;letter-spacing:-.05em;text-wrap:balance}.industry-copy>p{max-width:490px;color:#bac5d8;font-size:16px;line-height:1.65}.scenario-note{display:inline-flex;margin-top:8px;padding:8px 10px;border:1px solid rgba(255,255,255,.12);border-radius:5px;color:#9eacc3;font-size:9px;letter-spacing:.03em}.industry-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:27px}.industry-actions a{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:43px;padding:10px 13px;border:1px solid rgba(198,201,255,.4);border-radius:6px;color:#f0f0ff;text-decoration:none;font-size:10px;font-weight:650}.industry-actions a:first-child{background:#c1c1ff;color:#141831}.industry-actions a span{color:var(--industry-accent)}.industry-visual{position:relative;isolation:isolate;aspect-ratio:1.3;margin:0;overflow:hidden;border:1px solid rgba(200,210,235,.22);border-radius:14px;background:#151e2b;box-shadow:0 28px 80px rgba(0,0,0,.37)}.industry-visual img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.2,1)}.industry-visual:hover img{transform:scale(1.035)}.visual-wash{position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(5,10,17,.75)),linear-gradient(110deg,color-mix(in srgb,var(--industry-accent) 13%,transparent),transparent 62%)}.scan-line{position:absolute;left:0;right:0;top:22%;height:1px;background:var(--industry-accent);box-shadow:0 0 12px var(--industry-accent);opacity:.7;animation:scan 6s ease-in-out infinite alternate}@keyframes scan{to{top:76%}}.visual-target{position:absolute;width:28%;height:25%;left:22%;top:30%;border:1px solid var(--industry-accent);border-radius:6px;box-shadow:0 0 22px color-mix(in srgb,var(--industry-accent) 20%,transparent)}.target-two{left:auto;right:13%;top:42%;width:20%;height:18%;border-style:dashed;opacity:.75}.industry-visual figcaption{position:absolute;right:14px;bottom:13px;left:14px;display:flex;justify-content:space-between;gap:10px;color:#d5dbea;font-size:8px;font-weight:700;letter-spacing:.12em}.workflow{padding:33px 0 60px;border-top:1px solid rgba(190,200,227,.17)}.workflow header{display:flex;align-items:baseline;justify-content:space-between;gap:15px}.workflow h2{margin:9px 0 24px;font:550 clamp(23px,3vw,34px)/1.1 'Hanken Grotesk',Geist,sans-serif;letter-spacing:-.035em}.workflow ol{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:0;padding:0;list-style:none}.workflow li{position:relative;display:flex;align-items:center;gap:13px;min-height:76px;padding:15px;border:1px solid rgba(190,200,227,.18);border-radius:8px;background:linear-gradient(115deg,rgba(255,255,255,.045),transparent);}.workflow li>span{color:var(--industry-accent);font-size:10px;font-weight:700}.workflow li b{font-size:12px}.workflow li i{position:absolute;right:-15px;z-index:1;color:var(--industry-accent);font-size:17px;font-style:normal}.industry-switch{display:flex;flex-wrap:wrap;gap:8px;padding:0 0 90px}.industry-switch a{display:flex;justify-content:space-between;gap:20px;min-width:140px;padding:11px 13px;border:1px solid rgba(190,200,227,.18);border-radius:6px;color:#bcc6d8;text-decoration:none;font-size:10px}.industry-switch a.is-current{border-color:var(--industry-accent);color:#fff}.industry-switch a span{color:var(--industry-accent)}.industry-page :where(a):focus-visible{outline:3px solid var(--industry-accent);outline-offset:4px}
  @media(max-width:820px){.breadcrumbs{padding-top:83px}.industry-hero{grid-template-columns:1fr;gap:34px;padding-top:34px;padding-bottom:60px}.industry-copy h1{max-width:700px}.industry-visual{aspect-ratio:1.45}.workflow header{display:block}.workflow ol{grid-template-columns:1fr}.workflow li{min-height:60px}.workflow li i{display:none}}
  @media(max-width:500px){.industry-inner{width:calc(100% - 36px)}.industry-copy h1{font-size:43px}.industry-copy>p{font-size:14px}.industry-actions{display:grid}.industry-visual{aspect-ratio:1.12}.industry-visual figcaption{font-size:7px}.industry-switch a{flex:1 1 40%}}
  @media(prefers-reduced-motion:reduce){.scan-line{animation:none;top:50%}.industry-visual img{transition:none}}
</style>
