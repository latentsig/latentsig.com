{
  "name": "latentsig-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:hero": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM --types vite/client src/scripts/hero-bootstrap.ts src/scripts/hero-renderer.ts src/scripts/hero-mechanisms.ts",
    "test:hero": "node scripts/hero/verify.mjs",
    "test:a11y": "node scripts/hero/audit-accessibility.mjs && node scripts/hero/check-accessibility-behavior.mjs"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "katex": "^0.18.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "@types/three": "0.180.0",
    "autoprefixer": "10.5.5",
    "axe-core": "4.13.0",
    "postcss": "8.5.28",
    "puppeteer-core": "25.10.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  }
}
